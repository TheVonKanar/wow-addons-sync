["Type"] = "Link",
["label"] = "Texture Files",
["url"] = "https://github.com/Reloe/LuraMemoryFiles",
["tooltip"] = {
["title"] = "Texture Files",
["desc"] = "The Texture files are no longer required for most users. They are only required if you want to see these Icons in your Macros.",
},
["width"] = 150,
},
{
["Type"] = "Button",
["label"] = "Create Macros",
["tooltip"] = {
["title"] = "Create Macros",
["desc"] = "Will automatically create the correct macros for the memory game. You will only see the correct icons if you downloaded the texture files",
},
["func"] = "return function(NSI)\n                local iconIDs = {\"7242384\", \"134635\", \"340528\", \"351033\", \"236903\"}\n                local names = {\"T\", \"Circle\", \"Diamond\", \"Triangle\", \"Cross\"}\n                for i=1, 5 do\n                    local macroName = \"NSRT_LURA_RUNE_\"..i\n                    if not GetMacroInfo(macroName) then\n                        CreateMacro(macroName, iconIDs[i], \"/raid \"..names[i])\n                    else\n                        EditMacro(macroName, macroName, iconIDs[i], \"/raid \"..names[i])\n                    end\n                end\n            end",
["width"] = 150,
},
},
["Scale"] = 1,
["pinned"] = true,
["yOffset"] = -300,
["ShowSenderNames"] = false,
["Anchor"] = "TOPLEFT",
["timers"] = {
