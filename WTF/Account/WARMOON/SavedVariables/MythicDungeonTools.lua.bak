["d"] = {
"319.5",
"-333.1",
1,
true,
"Rogue Shroud skip here. It's helpful to Sap one of the final Kobolds as you squeeze past into the hallway. It may be possible to do this with Invisibility Potions, but we have yet to find a video clip with evidence of that being viable just yet.\n\nIf you cannot skip this pack, you can play it and skip some of the mobs towards the final boss to keep from going too far over count.",
},
["n"] = true,
},
{
["d"] = {
