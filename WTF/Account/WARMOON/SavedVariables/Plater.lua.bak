["Desc"] = "The default color of the cast bar border",
},
{
["Type"] = 1,
["Key"] = "onCooldownColor",
["Value"] = {
1,
0,
0,
1,
},
["Name"] = "On Cooldown Color",
["Icon"] = "Interface\\AddOns\\Plater\\images\\option_color",
["Desc"] = "The color of the cast bar border when your kick is on cooldown",
},
},
["LastHookEdited"] = "",
["Author"] = "Izimode-Azralon",
["OptionsValues"] = {
["defaultColor"] = {
0,
0,
0,
1,
},
["onCooldownColor"] = {
0,
0,
0,
1,
},
},
["Desc"] = "Adds a pixels perfect border around the cast bar.",
["Hooks"] = {
["Cast Update"] = "function (self, unitId, unitFrame, envTable, modTable)\n    envTable.UpdateBorder(unitFrame, modTable)\nend\n\n\n",
["Destructor"] = "function (self, unitId, unitFrame, envTable)\n    if (unitFrame.castBar.CastBarBorder) then\n        unitFrame.castBar.CastBarBorder:Hide()\n    end    \nend",
["Cast Start"] = "function (self, unitId, unitFrame, envTable, modTable)\n    envTable.UpdateBorder(unitFrame, modTable)\nend\n\n\n",
["Constructor"] = "function (self, unitId, unitFrame, envTable, modTable)\n    \n    --settings    \n    --hide the icon of the spell, may require /reload after changing\n    envTable.HideIcon = false\n    \n    --border settings\n    envTable.BorderThickness = 0.6\n    envTable.KickId = 57994\n    \n    --private\n    --create the border\n    if (not unitFrame.castBar.CastBarBorder) then\n        unitFrame.castBar.CastBarBorder = CreateFrame (\"frame\", nil, unitFrame.castBar, \"NamePlateFullBorderTemplate\")\n    end    \n    \n    --update the border\n    function envTable.UpdateBorder (unitFrame, modTable)\n        local castBar = unitFrame.castBar\n        \n        local kickCooldown = nil\n        if envTable.KickId ~= nil then\n            kickCooldown = C_Spell.GetSpellCooldown(envTable.KickId).duration\n        else\n            kickCooldown = 1\n        end\n        \n        local borderColor = modTable.config[\"defaultColor\"]\n        if kickCooldown > 0 then\n            borderColor = modTable.config[\"onCooldownColor\"]\n        end\n        \n        local r, g, b, a = DetailsFramework:ParseColors (borderColor)\n        castBar.CastBarBorder:SetVertexColor (r, g, b, a)\n        \n        local size = envTable.BorderThickness\n        castBar.CastBarBorder:SetBorderSizes (size, size, size, size)\n        castBar.CastBarBorder:UpdateSizes()        \n        \n        if (envTable.HideIcon) then\n            castBar.Icon:Hide()\n        end\n        \n        castBar.CastBarBorder:Show()\n    end\n    \nend\n\n\n\n\n",
},
