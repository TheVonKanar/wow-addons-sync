["Player Logon"] = "function()\n    \n    --Reload after importing or changing anything\n    --Choose the Arrow from the Target Tab\n    \n    Plater.TargetIndicators  [\"Chevron\"] = {\n        path = [[Interface\\Addons\\WindfuryUI\\Textures\\TargetArrow_Chevron.tga]],\n        coords = {\n            {0, 1, 0, 1}, --Left arrow - {0, 0, 0, 0} to hide. {0, 1, 0, 1} to show\n            {1, 0, 0, 1} --Right arrow - {0, 0, 0, 0} to hide. {1, 0, 0, 1} to show\n        },\n        desaturated = false,\n        width = 14, -- Change size\n        height = 14,\n        x = 14, -- Change position\n        y = 0,\n    }\n    \n    \n    Plater.TargetIndicators  [\"GoldenTriangle\"] = {\n        path = [[Interface\\Addons\\WindfuryUI\\Textures\\TargetArrow_GoldenTriangle.tga]],\n        coords = {\n            {0, 1, 0, 1}, --Left arrow - {0, 0, 0, 0} to hide. {0, 1, 0, 1} to show\n            {1, 0, 0, 1} --Right arrow - {0, 0, 0, 0} to hide. {1, 0, 0, 1} to show\n        },\n        desaturated = false,\n        width = 13, -- Change size\n        height = 13,\n        x = 12, -- Change position\n        y = 0,\n    }\n    \n    \n    Plater.TargetIndicators  [\"Triangle\"] = {\n        path = [[Interface\\Addons\\WindfuryUI\\Textures\\TargetArrow_Triangle.tga]],\n        coords = {\n            {0, 1, 0, 1}, --Left arrow - {0, 0, 0, 0} to hide. {0, 1, 0, 1} to show\n            {1, 0, 0, 1} --Right arrow - {0, 0, 0, 0} to hide. {1, 0, 0, 1} to show\n        },\n        desaturated = false,\n        width = 12, -- Change size\n        height = 12,\n        x = 14, -- Change position\n        y = 0,\n    }\n    \nend",
