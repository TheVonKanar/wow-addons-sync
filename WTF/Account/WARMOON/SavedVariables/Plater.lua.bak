["Author"] = "Terciob",
["Initialization"] = "		function (scriptTable)\n			--insert code here\n			\n		end\n	",
["Desc"] = "Modify a cast bar when the unit casts a spell with the same effect of the Warrior's Heroic Leap spell.",
["NpcNames"] = {
},
["Name"] = "Cast - Heroic Leap [P]",
["SpellIds"] = {
447141,
},
["PlaterCore"] = 1,
["version"] = -1,
["Options"] = {
{
["Type"] = 5,
["Name"] = "Option 1",
