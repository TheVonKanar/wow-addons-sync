["url"] = "",
["Icon"] = 135940,
["Enabled"] = true,
["Revision"] = 1307,
["semver"] = "",
["Author"] = "Elaiana-Proudmoore",
["Desc"] = "Adds absorbs to the health bar as full health value.",
["Prio"] = 99,
["Name"] = "Absorb Shields in Healthbar",
["PlaterCore"] = 1,
["Options"] = {
{
