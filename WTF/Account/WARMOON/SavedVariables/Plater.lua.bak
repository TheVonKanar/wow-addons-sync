["url"] = "",
["Icon"] = 237031,
["Enabled"] = true,
["Revision"] = 181,
["semver"] = "",
["Author"] = "Izimode-Azralon",
["Desc"] = "Removes parenthesis when show health amount and percent are both enabled.",
