["url"] = "",
["Icon"] = "236671",
["Enabled"] = true,
["Revision"] = 377,
["semver"] = "",
["Author"] = "Viashi-Antonidas",
["Desc"] = "Adds a text indicator for quest progress to show how many times the objective has to be completed.",
