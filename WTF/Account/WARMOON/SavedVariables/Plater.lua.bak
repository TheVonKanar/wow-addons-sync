["Key"] = "colour_names",
["Icon"] = "Interface\\AddOns\\Plater\\images\\option_bool",
["Desc"] = "Colours the Name by the assigned Raidmark. eg.: Triangle --> Green Name",
},
},
},
{
["LastHookEdited"] = "Initialization",
["Hooks"] = {
["Initialization"] = "function (modTable)\n    Plater.ForceInCombatUnits = {   \n        -- PVP\n        [5913] = true, -- Tremor Totem\n        [5925] = true, -- Grounding Totem\n        [53006] = true, -- Spirit Link Totem\n        [59764] = true, -- Healing Tide Totem\n        [61245] = true, -- Capacitor Totem\n        [101398] = true, -- Psyfiend\n        [105427] = true, -- Totem of Wrath\n        [106041] = true, -- Zombie\n        [114565] = true, -- Guardian of the Forgotten Queen\n        [119052] = true, -- War Banner\n        [135002] = true, -- Demonic Tyrant\n        [166523] = true, -- Vesper Totem\n        [179193] = true, -- Fel Obelisk\n        [179867] = true, -- Static Field Totem\n        [180113] = true, -- Rattling Mage\n        \n        -- Toys\n        [65310] = true, -- Turnip Punching Bag\n        [66374] = true, -- Anatomical Dummy\n        [118791] = true, -- Sturdy Love Fool\n        [143120] = true, -- Gnoll Targeting Barrel\n        [196394] = true, -- Tuskarr Training Dummy\n        [196406] = true, -- Rubbery Fish Head\n        [199057] = true, -- Black Dragon's Challenge Dummy\n        \n        -- The War Within\n        \n        -- Liberation of Undermine\n        [228514] = true, -- Pit Mechanic\n        [233623] = true, -- Pyrotechnics\n        \n        -- Black Rock Depths Anniversary Raid\n        [205218] = true, -- Spitfire Totem\n        \n        -- Nerub-ar Palace\n        [219746] = true, -- Silken Tomb\n        [220501] = true, -- Royal Shackles\n        [221344] = true, -- Gloom Hatchling\n        [222275] = true, -- Training Dummy\n        [223876] = true, -- Impaling Spike\n        [226103] = true, -- Webbed Victim\n        \n        ---- Affix\n        [229296] = true, -- Orb of Ascendance\n        \n        ---- Darkflame Cleft\n        [213751] = true, -- Dynamite Mine Cart\n        \n        ---- The Stonevault\n        [214443] = true, -- Crystal Shard, Skarmorak totem\n        \n        ---- Skittering Breach\n        [227532] = true, -- Faceless Devotee\n        [219996] = true, -- Faceless Devotee\n        \n        ---- Awakening the Machine\n        [229739] = true, -- Malfunctioning Pylon\n        [229769] = true, -- Medbot\n        \n        ---- Training Dummies\n        [225979] = true, -- Training Dummy <Healing>\n        [225980] = true, -- Training Dummy <Healing>\n        [225985] = true, -- Kelpfist <Raider's Training Dummy>\n        [225983] = true, -- Dungeoneer's Training Dummy <Damage>\n        [225977] = true, -- Dungeoneer's Training Dummy <Tanking>\n        [225978] = true, -- Crystalmaw <Raider's Tanking Dummy>\n        [225984] = true, -- Training Dummy <Damage>\n        [219251] = true, -- PvP Training Dummy <Healing>\n        [225976] = true, -- Normal Tank Dummy <Tanking>\n        [225982] = true, -- Cleave Training Dummy <Damage>\n        [219250] = true, -- PvP Training Dummy <Damage>\n        \n        -- Dragonflight\n        \n        ---- The Azure Vault\n        [195138] = true, -- Detonating Crystal\n        [199368] = true, -- Hardened Crystal\n        \n        ---- Ruby Life Pools\n        [199790] = true, -- Kyrakka\n        \n        ---- Training Dummies\n        [188352] = true, -- Tuskarr Training Dummy\n        [189617] = true, -- Boulderfist <Raider's Tanking Dummy>\n        [189632] = true, -- Animated Duelist <Raider's Training Dummy>\n        [190621] = true, -- Tuskarr Training Dummy\n        [190623] = true, -- Tuskarr Training Dummy\n        [190624] = true, -- Tuskarr Training Dummy\n        [193563] = true, -- Training Dummy\n        [194643] = true, -- Dungeoneer's Training Dummy <Damage>\n        [194644] = true, -- Dungeoneer's Training Dummy <Tanking>\n        [194645] = true, -- Training Dummy <Healing>\n        [194646] = true, -- Training Dummy <Healing>\n        [194648] = true, -- Training Dummy <Damage>\n        [194649] = true, -- Normal Tank Dummy\n        [196394] = true, -- Tuskarr Training Dummy\n      