["custom"] = "",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.loaded = C_AddOns.IsAddOnLoaded(\"CauseseDB\")\nif aura_env.loaded then\n    --categoryNumber can be used to differentiate between casts in the conditions for coloring etc\n    \n    --[spellID] = {\"custom name\",category,\"show (true/false)\",\"soundFile\"},\n    aura_env.spellIDs = {\n        --spellIDs moved to CauseseDB\n        \n        --[432229] = {\"Knock\", 4, true, \"Knock.ogg\"}, --Example\n        \n    }\n    \n    -- this is only for spells where the mobs cast it for roleplay purposes and they should only show if target is in party\n    aura_env.rpspellIDs = {\n        [431637] = true, --Umbral Rush\n    }\n    \n    --[[\ndefault logic:\n- category 0 Tankbusters\n- category 1 Frontals\n- category 2 Pools\n- category 3 Special stuff\n- important Tankbusters\n]]\nend",
["do_custom"] = true,
},
},
["semver"] = "1.0.132",
["sparkHidden"] = "NEVER",
["id"] = "Tank Casts TSU (custom options)",
["width"] = 135,
["frameStrata"] = 5,
["anchorFrameType"] = "SCREEN",
["config"] = {
["display"] = 2,
["disableSounds"] = false,
["singleSound"] = true,
["channel"] = true,
},
["backgroundColor"] = {
0,
0,
0,
0.67187589406967,
},
["inverse"] = true,
["customText"] = "function()\n    --this is for the preview, applied via conditions\n    if WeakAuras.IsOptionsOpen() then \n        local display = aura_env.config.display \n        if display == 1 then\n            return \"Buster\"\n        elseif display == 2 then\n            return \"Tenderize\"\n        end\n        \n    elseif aura_env.state then\n        local display = aura_env.config.display \n        if display == 1 and aura_env.state.spell then\n            return string.format(\"%s\", aura_env.state.spell)\n        elseif display == 2 and aura_env.state.spellName then\n            return string.format(\"%s\", aura_env.state.spellName)\n        end\n    end\nend",
["orientation"] = "HORIZONTAL",
