},
["use_npcId"] = false,
["use_castType"] = false,
["custom"] = "function(allstates, event, ...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID = ...\n        if subEvent == \"SPELL_AURA_APPLIED\"\n        and destGUID == WeakAuras.myGUID\n        and (spellID == 1217357 or spellID == 1217358) then\n            if aura_env.previousSpellID and aura_env.previousSpellID ~= spellID then\n                allstates[destGUID] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"timed\",\n                    duration = 3,\n                    expirationTime = 3 + GetTime(),\n                    autoHide = true,\n                }\n            end\n            aura_env.previousSpellID = spellID\n            return true\n        end\n    elseif event == \"ENCOUNTER_START\" then\n        aura_env.previousSpellID = nil\n    end\nend",
