["sparkHidden"] = "NEVER",
["config"] = {
},
["frameStrata"] = 1,
["anchorFrameType"] = "SCREEN",
["width"] = 215.99990844727,
["id"] = "[Gambit-BOSS02] Cannon Barrage Active",
["inverse"] = false,
["icon"] = false,
["orientation"] = "HORIZONTAL",
["conditions"] = {
