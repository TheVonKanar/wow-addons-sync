["subeventSuffix"] = "_CAST_START",
["custom_type"] = "stateupdate",
["match_countOperator"] = ">=",
["custom"] = "function(s, e, ...)\n    local u, cast, spellID = ... -- Unit event\n    if e == \"UNIT_SPELLCAST_START\" and spellID == 466958 then\n        if UnitThreatSituation(\"player\", u) and UnitThreatSituation(\"player\", u) >= 2 then\n            local expires = select(5, UnitCastingInfo(u))\n            s[UnitGUID(u)] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                icon = C_Spell.GetSpellInfo(spellID).iconID,\n                duration = (expires/1000)-GetTime(),\n                expirationTime = expires/1000,\n                autoHide = true,\n            }\n            return true         \n        end\n    end\n    if e == \"UNIT_SPELLCAST_STOP\" then\n        local u, cast, spellID = ... -- Unit event\n        local G = UnitGUID(u)\n        if s[G] then\n            s[G].show = false\n            s[G].changed = true\n            return true\n        end\n    end\nend    \n\n\n\n\n\n",
