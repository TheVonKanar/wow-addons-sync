["sparkHeight"] = 28,
["preferToUpdate"] = true,
["uid"] = "0lOYdktWs3P",
["actions"] = {
["start"] = {
["sound"] = " custom",
["do_custom"] = false,
["do_sound"] = false,
},
["finish"] = {
["custom"] = "",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.loaded = C_AddOns.IsAddOnLoaded(\"CauseseDB\")\nif aura_env.loaded then\n    --categoryNumber can be used to differentiate between casts in the conditions for coloring etc\n    --role can be (ALL/DAMAGER/HEALER/TANK/MELEE/RANGE) and only shows the bar to that role\n    \n    --[spellID] = {\"name\",category,\"soundFile\",\"role\", \"show target\" (true/false), \"important\" (true/false)},\n    aura_env.spellIDs = {\n        --spellIDs moved to CauseseDB\n        \n        --[257063] = {\"BOLT\",2,\"\",\"ALL\",true,false}, --Example Spell\n        \n        \n        \n    }\n    \n    -- this is only for spells where the mobs cast it for roleplay purposes and they should only show if target is in party\n    aura_env.rpspellIDs = {\n    }\n    \n    --[[\ndefault logic:\n- category 0 is for important interruptible casts\n- category 1 is for interruptible casts\n- category 2 is for ccable and not interruptible casts\n]]\nend",
["do_custom"] = true,
},
},
["semver"] = "1.0.132",
["sparkHidden"] = "NEVER",
["id"] = "Trash Cast TSU (custom options)",
["width"] = 170,
["frameStrata"] = 6,
["anchorFrameType"] = "SCREEN",
["config"] = {
["singleSound"] = true,
["showImportant"] = true,
["display"] = 2,
["enableSounds"] = true,
["delay"] = 0.15,
["channel"] = true,
},
["backgroundColor"] = {
0,
0,
0,
0.67187589406967,
},
["inverse"] = true,
["customText"] = "function()\n    --this is for the preview, applied via conditions\n    if WeakAuras.IsOptionsOpen() then \n        local display = aura_env.config.display \n        if display == 1 then\n            return string.format(\"%s%s%s\", \"\", \"BOLT\", \" - \" .. WA_ClassColorName(\"player\")), ICON_LIST[math.random(1,8)]..\"16|t\"\n        elseif display == 2 then\n            return \"Web Bolt\", ICON_LIST[math.random(1,8)]..\"16|t\"\n        elseif display == 3 then\n            return string.format(\"%s%s%s\", \"\", \"Web Bolt\", \" - \" .. WA_ClassColorName(\"player\")), ICON_LIST[math.random(1,8)]..\"16|t\"\n        end\n        \n    elseif aura_env.state then\n        local display = aura_env.config.display \n        if (display == 1 or display == 3) then\n            if aura_env.state.targetName then --targets a player\n                return string.format(\"%s%s\", display == 1 and aura_env.state.spell or aura_env.state.spellName, \" - \"..aura_env.state.targetName)\n            else\n                return string.format(\"%s\", display == 1 and aura_env.state.spell or aura_env.state.spellName)\n            end\n        elseif display == 2 then\n            return string.format(\"%s\", aura_env.state.spellName)\n        end\n    end\nend",
["orientation"] = "HORIZONTAL",
