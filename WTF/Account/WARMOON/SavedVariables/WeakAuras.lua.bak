["custom"] = "--────────────────────────────────────────────────────────────\n-- WeakAura ▸ On-Init  – Awakening-Storm tier-set counter\n--────────────────────────────────────────────────────────────\naura_env.saved       = aura_env.saved       or {}\naura_env.saved.AwakenCount = aura_env.saved.AwakenCount or 0\n\n-- user option\nif aura_env.config.enable_debug == nil then aura_env.config.enable_debug = false end\n\n-- runtime helpers\naura_env.baselineSet       = false\naura_env.prevStackCount    = 0\naura_env.prevAscPresent    = false\naura_env.prevAscExpire     = 0\naura_env.inCombat          = UnitAffectingCombat(\"player\")\n\n-- timing knobs\naura_env.tierWindow        = 0.15        -- Asc must appear ≤150 ms after vanish\naura_env.lastVanishTime    = 0\naura_env.expectTierNextAsc = false\n\n-- debug flag\naura_env.debug = aura_env.config.enable_debug\n\n",
},
["finish"] = {
},
},
