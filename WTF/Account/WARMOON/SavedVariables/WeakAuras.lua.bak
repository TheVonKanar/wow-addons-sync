["custom"] = "function(allstates, event, unit, _, spellID)    \n    if event == \"UNIT_SPELLCAST_CHANNEL_STOP\" and spellID == 1227117 then\n        aura_env.counter = aura_env.counter + 1\n        if aura_env.counter == 3 then\n            allstates:Update(guid, {\n                    progressType = \"timed\", \n                    duration = 6.6,\n                    expirationTime = 6.6 + GetTime(),\n                    autoHide = true,\n            })\n        end\n    elseif event == \"ENCOUNTER_START\" then\n        aura_env.counter = 0\n    end\nend",
