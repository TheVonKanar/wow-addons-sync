["unit"] = "player",
["custom"] = "function()\n    local loaded = C_AddOns.IsAddOnLoaded(\"CauseseDB\")\n    if not loaded and not aura_env.fired then\n        StaticPopupDialogs[\"CAUSESEDB_CHECK\"] = {\n            text = \"\\124cFFFF0000CauseseDB AddOn missing|r|n|nLink:\",\n            button1 = \"ok\",\n            showAlert = true,\n            hasEditBox = true,\n            editBoxWidth = 250,\n            \n            OnShow = function (self, data)\n                local url = \"https://www.curseforge.com/wow/addons/causesedb\"\n                self.editBox:SetText(url)\n                self.editBox:HighlightText()\n                self.editBox:SetScript(\"OnTextChanged\", function(editBox)\n                        editBox:SetText(url)\n                        editBox:HighlightText()\n                end)\n            end,\n            OnHide = function(self, data)\n                self.editBox:SetScript(\"OnTextChanged\", nil)\n            end,\n            whileDead = true,\n            hideOnEscape = false,\n            preferredIndex = 3,\n        }\n        StaticPopup_Show(\"CAUSESEDB_CHECK\")\n        aura_env.fired = true\n    end\nend",
