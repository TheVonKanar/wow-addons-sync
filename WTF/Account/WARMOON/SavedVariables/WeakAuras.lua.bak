["parent"] = "Trash",
["width"] = 46,
["frameStrata"] = 3,
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.slot = 0\n\naura_env.recent_totems = {}\n\naura_env.valid_totems = {\n    [192058] = true,  -- Capacitor Totem\n    [204331] = true,  -- Counterstrike Totem\n    [157153] = true,  -- Cloudburst Totem\n    [2484] = true,  -- Earthbind Totem\n    [198838] = true,  -- Earthen Wall Totem\n    [51485] = true,  -- Earthgrab Totem\n    [204336] = true,  -- Grounding Totem\n    [5394] = true,  -- Healing Stream Totem\n    [192222] = true,  -- Liquid Magma Totem\n    [383013] = true,  -- Poison Cleansing Totem\n    [355580] = true, -- Static Field Totem\n    [444995] = true,  -- Surging Totem\n    [8143] = true,  -- Tremor Totem\n    [192077] = true,  -- Wind Rush Totem\n}\n\nfunction aura_env.HasCreationCore()\n    \n    local config_id = C_ClassTalents.GetActiveConfigID()\n    local node_info = C_Traits.GetNodeInfo(config_id, 81090)\n    \n    return (node_info.ranksPurchased > 0)\nend\n\naura_env.has_creation_core = aura_env.HasCreationCore()",
["do_custom"] = true,
},
["finish"] = {
