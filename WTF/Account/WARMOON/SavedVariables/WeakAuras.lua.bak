["customText"] = "\n\n",
["shadowYOffset"] = -1,
["displayText_format_total_time_dynamic_threshold"] = 60,
["automaticWidth"] = "Auto",
["cooldownSwipe"] = true,
["anchorFrameType"] = "SELECTFRAME",
