["type"] = "custom",
["custom_type"] = "stateupdate",
["event"] = "Health",
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["events"] = "CLEU:SPELL_CAST_START",
["custom"] = "function(allstates, event, ...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID = ...\n        if subEvent == \"SPELL_CAST_START\"\n        and (spellID == 1216674 or spellID == 1216414) and not WeakAuras.GetActiveTriggers(aura_env.id)[1] then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = (spellID == 1216674 and 3) or 1.5,\n                expirationTime = (spellID == 1216674 and 3 or 1.5) + GetTime(),\n                autoHide = true,\n            }\n            return true\n        end\n    end\nend",
["check"] = "event",
["spellIds"] = {
},
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
