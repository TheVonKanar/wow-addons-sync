},
},
["desc"] = "Based on Nikyou's counter (https://wago.io/oK2AIZATK), thanks to him!\nDisplays a bar that progress depending on your Awakening Storms procs up to 7. There's a tick and recolor when at 3 Stacks (next one will trigger a Tempest) and at 7 stacks (bar full, next one will trigger Ascendance and reset the counter).",
["config"] = {
["enable_debug"] = false,
["countdown_from_8"] = false,
