["custom"] = "function(allstates, event, unit, _, spellID)\n    if event == \"UNIT_SPELLCAST_START\"\n    and spellID == 1232399\n    and WeakAuras.CheckRange(unit, 40, \"<=\") then\n        local _, _, _, startC, endC  = UnitCastingInfo(unit)\n        local duration = (endC - startC) / 1000\n        local expirationTime = endC / 1000\n        allstates:Update(UnitGUID(unit), {\n                castType = \"cast\",\n                progressType = \"timed\",\n                duration = duration,\n                expirationTime = expirationTime,\n                autoHide = true,\n        })\n    elseif \"UNIT_SPELLCAST_STOP\"\n    and spellID == 1232399 then\n        allstates:Remove(UnitGUID(unit))\n    end\nend",
