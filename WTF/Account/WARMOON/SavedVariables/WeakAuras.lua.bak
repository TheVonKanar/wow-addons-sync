["sparkDesaturate"] = false,
["texture"] = "Clean",
["sparkTexture"] = "Interface\\CastingBar\\UI-CastingBar-Spark",
["spark"] = false,
["tocversion"] = 110200,
["alpha"] = 1,
["sparkColor"] = {
0,
