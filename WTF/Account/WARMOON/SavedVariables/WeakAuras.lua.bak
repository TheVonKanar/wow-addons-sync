["custom"] = "function(allstates, event, ...)\n    local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID  = ...\n    if aura_env.spellIDs[spellID]\n    and not WeakAuras.GetActiveTriggers(aura_env.id)[1] then\n        allstates:Update(\"\", {\n                progressType = \"timed\",\n                duration = 101,\n                expirationTime = 101 + GetTime(),\n                autoHide = true,\n                \n        })\n    end\nend",
