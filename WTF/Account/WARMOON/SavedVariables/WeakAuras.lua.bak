},
["custom"] = "function(allstates, event, unit, _, spellID)    \n    if event == \"UNIT_TARGET\" then\n        local _,_,_,_,expirationTime,_,_,_,spellId = UnitCastingInfo(unit)\n        local guid = UnitGUID(unit)\n        if spellId\n        and spellId == 259940\n        and guid\n        and not allstates[guid] then\n            allstates[guid] = {\n                show = true,\n                changed =  true,\n                progressType = \"timed\", \n                duration = expirationTime / 1000 - GetTime(),\n                expirationTime = expirationTime / 1000,\n                destUnit = unit..\"target\",\n                unitIsMe = UnitGUID(unit..\"target\") == WeakAuras.myGUID,\n                autoHide = true,\n            }\n            return true\n        end\n    end\n    if event == \"UNIT_SPELLCAST_STOP\"\n    and spellID == 259940 then\n        local guid = UnitGUID(unit)\n        if guid then\n            local state = allstates[guid]\n            if state then\n                state.show = false\n                state.changed = true\n                return true\n            end\n        end\n    end\nend",
