["auraspellids"] = {
},
["realSpellName"] = 0,
["use_spellName"] = true,
["custom"] = "function(allstates, event, unit, _, spellID)    \n    if event == \"UNIT_TARGET\"\n    then\n        local _,_,_,_,expirationTime,_,_,_,spellId = UnitCastingInfo(unit)\n        local guid = UnitGUID(unit)\n        if spellId\n        and guid\n        and not UnitIsUnit(unit..\"target\", \"player\")\n        and not allstates[guid]\n        and spellId == 467606\n        then\n            allstates[guid] = {\n                show = true,\n                changed =  true,\n                progressType = \"timed\", \n                duration = expirationTime / 1000 - GetTime(),\n                expirationTime = expirationTime / 1000,\n                unit = unit..\"target\",\n                autoHide = true,\n            }\n            return true\n        end\n    elseif event == \"UNIT_SPELLCAST_STOP\" and spellID == 467606 then\n        local state = allstates[UnitGUID(unit)]\n        if state then\n            state.show = false\n            state.changed = true\n            return true\n        end\n    end\nend",
["useName"] = false,
["check"] = "event",
["use_genericShowOn"] = true,
["use_track"] = true,
["customVariables"] = "{unitIsMe = \"bool\", expirationTime = true}",
