["custom"] = "if aura_env.config.TTS then\n    local voiceID\n    for _, voice in pairs(C_VoiceChat.GetTtsVoices()) do\n        if string.match(voice.name, \"Zira\") then\n            voiceID = voice.voiceID\n            break\n        end\n    end\n    if voiceID then\n        C_VoiceChat.SpeakText(voiceID, \"Red Gate\", 1, 0.5, GetCVar(\"Sound_MasterVolume\")*100)\n    end\nend",
