["custom"] = "aura_env.lastCast = 0\naura_env.tempestOneBuffRemoved = 0\naura_env.arcBugTime = 0\naura_env.nextTempestTime = 0\naura_env.maxStacks = 40\n\naura_env.listOfSpenders ={\n    [8004] = true, -- Healing Surge\n    [1064] = true, -- Chain Heal\n    [51505] = true, -- Lava Burst\n    [188443] = true, -- Chain Lightning\n    [117014] = true, -- Elemental Blast\n    [188196] = true, -- Lightning Bolt\n    [452201] = true, -- Tempest\n    [1218090] = true, -- Primordial Storm\n    \n    [320674] = true -- Chain Harvest\n}\n\nif not aura_env.saved then\n    aura_env.saved = {}\nend\n\n\n",
