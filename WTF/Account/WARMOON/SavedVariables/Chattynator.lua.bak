["b"] = 0.250980406999588,
},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Dordok-Ysondre:542:GUILD:|h[|cffaad372Dordok|r]|h: qui est chaud pour fleche coursevent ? on est 2 dps",
["timestamp"] = 1772214303,
["id"] = "s0_2869",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
