["r"] = 1,
},
["text"] = "Salandria says: We might even let you live!",
["id"] = "s1_4999",
["timestamp"] = 1772570114,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Taelia Fordragon",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Taelia Fordragon says: At the very least, you'll regret not telling us.",
["id"] = "s1_5000",
["timestamp"] = 1772570117,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Salandria",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Salandria says: Give it to them, Kvotheen.",
["id"] = "s2_2502",
["timestamp"] = 1772570121,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Taelia Fordragon",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Taelia Fordragon says: Not... permanently. We need to know where the paladins are.",
["id"] = "s2_2503",
["timestamp"] = 1772570124,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Captured Shadecaster",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Captured Shadecaster says: Enough! Enough, I'll tell you! They're in the Ruins of Deatholme!",
