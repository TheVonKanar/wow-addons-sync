["g"] = 1,
["r"] = 1,
},
["text"] = "You loot 4 Gold, 76 Silver, 99 Copper (+9 Silver, 53 Copper)",
["id"] = "s21_3098",
["timestamp"] = 1787726400,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jarra",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jarra says: We've awakened de spirits!",
["id"] = "s21_3099",
["timestamp"] = 1787726403,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Orweyna",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Orweyna says: There is a dark presence. One I know well. Nek'zali--the one who raised Ula'tek--is here!",
["id"] = "s21_3100",
["timestamp"] = 1787726406,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Nek'zali the Soulcoiler",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Nek'zali the Soulcoiler yells: Heh heh. So... you have come again?",
["id"] = "s21_3101",
["timestamp"] = 1787726423,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Nek'zali the Soulcoiler",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Nek'zali the Soulcoiler yells: Flesh, breath, and bone. You think yourselves masters of what sleeps below.",
["id"] = "s21_3102",
["timestamp"] = 1787726428,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Nek'zali the Soulcoiler",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Nek'zali the Soulcoiler yells: Dey thought their bones could hold me. But bones... crumble. Coils... only loosen with time.",
["id"] = "s21_3103",
["timestamp"] = 1787726438,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["event"] = "CHAT_MSG_MONEY",
["type"] = "MONEY",
},
["color"] = {
["b"] = 0,
["g"] = 1,
["r"] = 1,
},
["text"] = "You loot 25 Gold, 83 Copper (+50 Silver, 1 Copper)",
["id"] = "s21_3104",
["timestamp"] = 1787726441,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Nek'zali the Soulcoiler",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Nek'zali the Soulcoiler yells: Mmm... de coils still hum with power. Even stone got a memory.",
["id"] = "s21_3105",
["timestamp"] = 1787726449,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Nek'zali the Soulcoiler",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Nek'zali the Soulcoiler yells: Dey buried me with de loa I gave them...",
["id"] = "s21_3106",
["timestamp"] = 1787726456,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
