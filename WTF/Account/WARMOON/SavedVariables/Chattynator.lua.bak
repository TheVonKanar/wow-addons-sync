o\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"BloodElf\",\"name\":\"Orlandomagic-Drak'thul\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Orlandomagic-Drak'thul|h[|cffffffffOrlandomagic-Drak'thul|r]|h has earned the achievement |cffffff00|Hachievement:61939:Player-1092-0B4F1AE2:1:4:1:26:4294967295:4294967295:4294967295:4294967295|h[Abundance: Artisan of Floaret]|h|r!\",\"timestamp\":1775057509,\"id\":\"s12_3738\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:256974::::::::90:263::29:3:12777:6652:13577:1:28:3321:::::|h[Rootspeaker's Footwraps]|h|r\",\"timestamp\":1775057509,\"id\":\"s12_3739\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Fungarian tenacity meets rutaani thorns, and all of Harandar bleeds. We haranir step in, not to win a war, but to prune it before the rot consumes all.\",\"id\":\"s12_3740\",\"timestamp\":1775060913},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Rutaani Skirmisher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Rutaani Skirmisher says: We will grow back!\",\"id\":\"s12_3741\",\"timestamp\":1775060944},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Fungarian Brawler\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Fungarian Brawler says: My cap broken... Russula will avenge...\",\"id\":\"s12_3742\",\"timestamp\":1775060944},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Fungarian Brawler\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Fungarian Brawler says: Russula will snap you twigs!\",\"id\":\"s12_3743\",\"timestamp\":1775060946},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 2 Gold, 19 Silver, 40 Copper (+4 Silver, 38 Copper)\",\"id\":\"s12_3744\",\"timestamp\":1775060947},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 27 Silver (+54 Copper)\",\"id\":\"s12_3745\",\"timestamp\":1775060963},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: The first skirmish is halted, yet anger still simmers. The leaders of both sides refuse to reason except for one.\",\"id\":\"s12_3746\",\"timestamp\":1775060969},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Rutaani Skirmisher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Rutaani Skirmisher says: Fungal rot... must be cleansed...\",\"id\":\"s12_3747\",\"timestamp\":1775060969},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 79 Silver, 79 Copper (+1 Silver, 59 Copper)\",\"id\":\"s12_3748\",\"timestamp\":1775060971},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Pustulehelm\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Pustulehelm says: Boring! No deal! They snap stalks, we snap back harder! Tell rutaani no cry when spores fly next!\",\"id\":\"s12_3749\",\"timestamp\":1775060983},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Roonek\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Roonek says: This one hears... but the petals have fallen. Only thorns remain.\",\"id\":\"s12_3750\",\"timestamp\":1775061004},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Russula\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Russula yells: You! Fighter with brain! Come quick, want peace words!\",\"id\":\"s12_3751\",\"timestamp\":1775061005},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Sânghr-Hyjal:16:GUILD:|h[|cff00ff98Sânghr|r]|h: qui pour des marcheurs du temps ally ? \",\"id\":\"s12_3752\",\"timestamp\":1775061006},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Behold Russula, an advocate for mercy whose plea was drowned by the drums of war. But Russula knew how to make their voice heard over the din.\",\"id\":\"s12_3753\",\"timestamp\":1775061022},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Grown to a size that none could ignore, the fungarian used their might to put an end to the battle. Their actions were to separate the combatants, not break them.\",\"id\":\"s12_3754\",\"timestamp\":1775061072},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Fungarian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Warbound Fungarian says: I not lose, just... resting.\",\"id\":\"s12_3755\",\"timestamp\":1775061079},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Rutaani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Warbound Rutaani says: Peace not wanted... but perhaps needed.\",\"id\":\"s12_3756\",\"timestamp\":1775061080},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Fungarian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Warbound Fungarian says: Okay, Russula not boring peace shroom. Peace shroom with fist!\",\"id\":\"s12_3757\",\"timestamp\":1775061087},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Rutaani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Warbound Rutaani says: Peace not wanted... but perhaps needed.\",\"id\":\"s12_3758\",\"timestamp\":1775061090},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Fungarian\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Warbound Fungarian says: Okay, Russula not boring peace shroom. Peace shroom with fist!\",\"id\":\"s12_3759\",\"timestamp\":1775061092},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Warbound Rutaani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"M