["b"] = 0,
},
["text"] = "You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx400",
["timestamp"] = 1787210865,
["id"] = "s19_4999",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Grand Magister Rommath",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Grand Magister Rommath says: Relying on mirror images to unlock multiple wards? Clever. Even in death, he is still teaching me...",
["timestamp"] = 1787210941,
["id"] = "s19_5000",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Grand Magister Rommath",
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["r"] = 1,
["g"] = 0.501960813999176,
["b"] = 0.250980406999588,
},
["text"] = "Grand Magister Rommath conjures several mirror images before teleporting upstairs.",
["timestamp"] = 1787210948,
["id"] = "s20_2502",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["event"] = "CHAT_MSG_CURRENCY",
["type"] = "CURRENCY",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx150",
["timestamp"] = 1787211102,
["id"] = "s20_2503",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Grand Magister Rommath",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Grand Magister Rommath says: I've managed to unravel most of his wards, but Belo'vir was always... extravagant with his safeguards. I will need your help for this last one.",
["timestamp"] = 1787211111,
["id"] = "s20_2504",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Mirror Image of Belo'vir Salonar",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Mirror Image of Belo'vir Salonar says: One final challenge yet remains, my apprentice.",
["timestamp"] = 1787211120,
["id"] = "s20_2505",
},
