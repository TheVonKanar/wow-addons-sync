},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Amani Feller says: We cannot... falter...",
["timestamp"] = 1772226091,
["id"] = "s0_3323",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
