5294342041016},\"text\":\"Orweyna says: I will block the Rootways. He will not escape again.\",\"timestamp\":1774740761,\"id\":\"s11_3624\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lightwarden Ruia\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Lightwarden Ruia yells: It was... for Harandar...\",\"timestamp\":1774740881,\"id\":\"s11_3625\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 11 Gold, 63 Silver, 76 Copper (+23 Silver, 27 Copper)\",\"timestamp\":1774740882,\"id\":\"s11_3626\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: His faith in the goddess has become hatred. Is this what Lightbloom does?\",\"timestamp\":1774740886,\"id\":\"s11_3627\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: Follow me!\",\"timestamp\":1774740897,\"id\":\"s11_3628\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"[DNT] Visual Stalker\"},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"Power surges from the Lightbloom's epicenter!\",\"timestamp\":1774740904,\"id\":\"s11_3629\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: A precision attack? I should have called for everyone.\",\"timestamp\":1774740907,\"id\":\"s11_363