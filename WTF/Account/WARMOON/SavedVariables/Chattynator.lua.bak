{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: Ladies and gentlemons, it is time once again to bear witness to the game of kings and the king of games: headball!",
["timestamp"] = 1787504434,
["id"] = "s20_4715",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Valeera Sanguinar",
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["r"] = 1,
["g"] = 0.501960813999176,
["b"] = 0.250980406999588,
},
["text"] = "Valeera Sanguinar begins making a campfire.",
["timestamp"] = 1787504435,
["id"] = "s20_4716",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Valeera Sanguinar",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Valeera Sanguinar says: My blades are ready.",
["timestamp"] = 1787504435,
["id"] = "s20_4717",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: Many teams enter, only one team leaves. With their heads, anyway!",
["timestamp"] = 1787504443,
["id"] = "s20_4718",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: Now get out there and play your heads off!",
["timestamp"] = 1787504449,
["id"] = "s20_4719",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
