},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Grand Magister Rommath says: Meet me in Orgrimmar so we may root out this evil. We cannot suffer a single cultist within our walls.",
