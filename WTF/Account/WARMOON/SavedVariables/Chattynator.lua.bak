["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive item: |cnIQ2:|Hitem:260922::::::::90:263::60::1:28:373:::::|h[Fidoficus]|h|r",
["timestamp"] = 1772652556,
["id"] = "s2_4468",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ravenia",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ravenia says: Whether or not this nurturing approach is effective, it is clearly not for me.",
["timestamp"] = 1772652556,
["id"] = "s2_4469",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ravenia",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ravenia says: My beasts will continue to thrive under the threat of violence. It is the domanaar way.",
