},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Arator yells: Two halves of a whole--Vereesa, follow the Light phoenix. I'll take the other side.",
["id"] = "s17_2885",
["timestamp"] = 1777320459,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
