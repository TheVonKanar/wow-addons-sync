ti\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Warleader Abdumati yells: Someting big's coming. Gather your comrades and face it!\",\"timestamp\":1787052312,\"id\":\"s18_4905\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Human\",\"name\":\"Delondra-Elune\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Delondra-Elune|h[|cffc69b6dDelondra-Elune|r]|h a accompli le haut fait |cffffff00|Hachievement:41287:Player-1315-0D78236C:1:8:18:26:4294967295:4294967295:4294967295:4294967295|h[Windrunner Spire]|h|r !\",\"timestamp\":1787052377,\"id\":\"s18_4906\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Major Event 02 Controller Bunny\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"The third barricade has fallen. Ensure the supply wagon reaches its destination.\",\"id\":\"s18_4907\",\"timestamp\":1787069733},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"ROGUE\",\"name\":\"Pewpwe-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Pewpwe-Dalaran:5:GUILD:|h[|cfffff468Pewpwe|r]|h: io\",\"id\":\"s18_4908\",\"timestamp\":1787069864},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: Get ready. We have to stop Zul'jan.\",\"id\":\"s18_4909\",\"timestamp\":1787069881},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Zul'jan is already empowering the Fang of Ula'tek.\",\"id\":\"s18_4910\",\"timestamp\":1787069882},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meredy Huntswell says: Everyone get your buffs on.\",\"id\":\"s18_4911\",\"timestamp\":1787069884},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meredy Huntswell says: Anyone peckish? Mage table ready.\",\"id\":\"s18_4912\",\"timestamp\":1787069888},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meredy Huntswell says: Check your adventure guide if you need more information about what we'll find here.\",\"id\":\"s18_4913\",\"timestamp\":1787069888},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: He's put up barriers to avoid any interruptions.\",\"id\":\"s18_4914\",\"timestamp\":1787069890},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Captain Garrick says: Let's use this.\",\"id\":\"s18_4915\",\"timestamp\":1787069893},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"[Tank] |