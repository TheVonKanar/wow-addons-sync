["name"] = "Ney'tar",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ney'tar says: You only need four buds. One per hydra. Or twelve. Depends on how you approach the head count.",
["timestamp"] = 1772657348,
["id"] = "s2_4973",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ketan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ketan says: Come meet Elder Akazi and I when you are ready.",
["timestamp"] = 1772657371,
["id"] = "s2_4974",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Motta",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Motta says: Are know about Grudge Pit? Is exciting place!",
["timestamp"] = 1772657375,
["id"] = "s2_4975",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Motta",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Motta says: Good to meet Kvotheen. Will go to Grudge Pit to see you fight.",
["timestamp"] = 1772657381,
["id"] = "s2_4976",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Motta",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Motta says: You probably die. But Motta will cheer for you. Maybe not die!",
["timestamp"] = 1772657387,
["id"] = "s2_4977",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zur'ashar Shay'neia",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Zur'ashar Shay'neia says: You'll likely find Orn'shan down by the Amirdrassil Roots, sitting with his mistakes.",
["timestamp"] = 1772657397,
["id"] = "s2_4978",
},
{
