Shadow]|h|r!\",\"id\":\"s13_4263\",\"timestamp\":1775634366},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"WARRIOR\",\"name\":\"Larmiell-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Larmiell-Hyjal|h[|cffc69b6dLarmiell|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-0CD1A920:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4264\",\"timestamp\":1775634371},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"WARRIOR\",\"name\":\"Guaroc-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Guaroc-Ysondre|h[|cffc69b6dGuaroc-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1335-0A6ABA39:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4265\",\"timestamp\":1775634376},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Goblin\",\"class\":\"DEATHKNIGHT\",\"name\":\"Énozzy-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Énozzy-Hyjal|h[|cffc41e3aÉnozzy|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-0CAC8486:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4266\",\"timestamp\":1775634382},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"MAGE\",\"name\":\"Valençay-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Valençay-Hyjal|h[|cff3fc7ebValençay|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-0D607948:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4267\",\"timestamp\":1775634382},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"MAGE\",\"name\":\"Valençay-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Valençay-Hyjal|h[|cff3fc7ebValençay|r]|h has earned the achievement |cffffff00|Hachievement:62262:Player-1390-0D607948:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[Silvermoon Court Champion]|h|r!\",\"id\":\"s13_4268\",\"timestamp\":1775634382},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Liadrin. With all that's happened, we haven't had much time to talk.\",\"id\":\"s13_4269\",\"timestamp\":1775634383},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"SHAMAN\",\"name\":\"Zwany-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Zwany-Ysondre|h[|cff0070ddZwany-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1335-0A8E2A39:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4270\",\"timestamp\":1775634388},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"SHAMAN\",\"name\":\"Zwany-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Zwany-Ysondre|h[|cff0070ddZwany-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:62262:Player-1335-0A8E2A39:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[Silvermoon Court Champion]|h|r!\",\"id\":\"s13_4271\",\"timestamp\":1775634388},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: What's on your mind?\",\"id\":\"s13_4272\",\"timestamp\":1775634388},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: When the attacks first started, you went to the Sunwell and prayed for a miracle. Heroes from all over the world appeared in a flash of light--just in time to save the city.\",\"id\":\"s13_4273\",\"timestamp\":1775634390},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: I don't understand how it happened.\",\"id\":\"s13_4274\",\"timestamp\":1775634402},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: I've never experienced anything like it before. In my desperation, I swear I could hear a gentle voice... \\\"Don't be afraid,\\\" it said. \\\"I am with you.\\\"\",\"id\":\"s13_4275\",\"timestamp\":1775634404},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"WARRIOR\",\"name\":\"Kamyh-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kamyh-Illidan|h[|cffc69b6dKamyh-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1624-08D3B4BA:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4276\",\"timestamp\":1775634410},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"WARRIOR\",\"name\":\"Kamyh-Illidan\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kamyh-Illidan|h[|cffc69b6dKamyh-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:62262:Player-1624-08D3B4BA:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[Silvermoon Court Champion]|h|r!\",\"id\":\"s13_4277\",\"timestamp\":1775634410},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"SHAMAN\",\"name\":\"Ysunï-Illidan\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Ysunï-Illidan|h[|cff0070ddYsunï-Illidan|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1624-0805E971:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4278\",\"timestamp\":1775634414},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Arcavoid-MarécagedeZangar\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Arcavoid-MarécagedeZangar|h[|cffa330c9Arcavoid-MarécagedeZangar|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1621-0BA62A1C:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4279\",\"timestamp\":1775634415},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: And there was... music. Like a song ringing in my heart.\",\"id\":\"s13_4280\",\"timestamp\":1775634417},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Like the Radiant Song?\",\"id\":\"s13_4281\",\"timestamp\":1775634423},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: Could the voice you heard have been the Worldsoul we've heard about? Could it have reached out through the Light?\",\"id\":\"s13_4282\",\"timestamp\":1775634425},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MAGE\",\"name\":\"Lorei-Dalaran\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Lorei-Dalaran|h[|cff3fc7ebLorei-Dalaran|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1621-0B906F8F:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4283\",\"timestamp\":1775634427},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"HUNTER\",\"name\":\"Reanoria-Dalaran\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Reanoria-Dalaran|h[|cffaad372Reanoria-Dalaran|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1621-0B6ADB66:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4284\",\"timestamp\":1775634431},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: I truly do not know. Whatever it was, it saved us. I believe we will hear it again when we need it most.\",\"id\":\"s13_4285\",\"timestamp\":1775634432},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Killcow-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Killcow-Hyjal|h[|cffa330c9Killcow|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-0D6616D2:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4286\",\"timestamp\":1775634436},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:257143::::::::90:263::11::1:28:872:::::|h[Peridot Dragonhawk]|h|r\",\"id\":\"s13_4287\",\"timestamp\":1775634445},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:265106::::::::90:263::11::1:28:3313:::::|h[Farstriders' Pride Statue]|h|r\",\"id\":\"s13_4288\",\"timestamp\":1775634445},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"DRUID\",\"name\":\"Darkferal-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Darkferal-Ysondre|h[|cffff7c0aDarkferal-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1335-0A8B4609:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4289\",\"timestamp\":1775634445},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:265631::::::::90:263::11::1:28:3313:::::|h[Farstriders' Glory Statue]|h|r\",\"id\":\"s13_4290\",\"timestamp\":1775634445},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-09230B89:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4291\",\"timestamp\":1775634445},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-09230B89:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4292\",\"timestamp\":1775634445},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Though today we celebrate, there remains much to which we must attend. Still, thank you for all you have done.\",\"id\":\"s13_4293\",\"timestamp\":1775634445},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx10\",\"id\":\"s13_4294\",\"timestamp\":1775634446},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"DEATHKNIGHT\",\"name\":\"Rakza-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Rakza-Hyjal|h[|cffc41e3aRakza|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-0BAC9C52:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4295\",\"timestamp\":1775634452},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: This new Dawnwell is a fitting tribute to our unity. Though, learning to live without the Sunwell's power may take some getting used to.\",\"id\":\"s13_4296\",\"timestamp\":1775634487},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: Perhaps. Far more concerning to me is the Darkwell...\",\"id\":\"s13_4297\",\"timestamp\":1775634497},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: It's no longer a threat to any--\",\"id\":\"s13_4298\",\"timestamp\":1775634504},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: They were moving down through it, Rommath. You saw. Thousands upon thousands of void monstrosities... all headed deep underground.\",\"id\":\"s13_4299\",\"timestamp\":1775634507},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: I... saw. What could Xal'atath be seeking at the heart of the world?\",\"id\":\"s13_4300\",\"timestamp\":1775634519},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"SHAMAN\",\"name\":\"Tife-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Tife-Hyjal|h[|cff0070ddTife|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-0C49F22E:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4301\",\"timestamp\":1775634526},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: Whatever it is, she used us to get to it.\",\"id\":\"s13_4302\",\"timestamp\":1775634526},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"WARLOCK\",\"name\":\"Samarãh-Archimonde\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Samarãh-Archimonde|h[|cff8788eeSamarãh-Archimonde|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1302-084B5F8B:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4303\",\"timestamp\":1775634526},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"SHAMAN\",\"name\":\"Tife-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Tife-Hyjal|h[|cff0070ddTife|r]|h has earned the achievement |cffffff00|Hachievement:62262:Player-1390-0C49F22E:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[Silvermoon Court Champion]|h|r!\",\"id\":\"s13_4304\",\"timestamp\":1775634526},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: I fear her true invasion... is only just beginning.\",\"id\":\"s13_4305\",\"timestamp\":1775634532},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Faerin Lothar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Faerin Lothar says: So, Anduin, why do you keep stealing glances at the esteemed Prophet Velen?\",\"id\":\"s13_4306\",\"timestamp\":1775634543},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: He... was my mentor. He taught me so much about the Light.\",\"id\":\"s13_4307\",\"timestamp\":1775634549},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Faerin Lothar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Faerin Lothar says: Oh, excellent! Then you can introduce us.\",\"id\":\"s13_4308\",\"timestamp\":1775634555},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: Wait--! Velen. This is Faerin Lothar of the Hallowfall Arathi. I'm sure she's... overflowing with questions.\",\"id\":\"s13_4309\",\"timestamp\":1775634559},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Prophet Velen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prophet Velen says: It is an honor, young Lothar. I, too, have questions. I hear tales of a large crystal of Light and Shadow?\",\"id\":\"s13_4310\",\"timestamp\":1775634570},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Prophet Velen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prophet Velen says: We shall find time to speak at length. But first, Anduin. How does the Light feel to you now?\",\"id\":\"s13_4311\",\"timestamp\":1775634580},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: Earlier, near the Sunwell, it was... overwhelming. I couldn't hear myself think. I understand how so many lost themselves in it.\",\"id\":\"s13_4312\",\"timestamp\":1775634589},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: But now... it's gentle. The pleasant hum in the back of my mind I remember from my youth.\",\"id\":\"s13_4313\",\"timestamp\":1775634600},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Faerin Lothar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Faerin Lothar says: It is wonderful you feel the Light so near once more, Anduin.\",\"id\":\"s13_4314\",\"timestamp\":1775634607},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Prophet Velen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prophet Velen says: Indeed. So then, my dear pupil, why have you been avoiding me?\",\"id\":\"s13_4315\",\"timestamp\":1775634612},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: This... I'm sorry, Velen. This is not the future you saw for me.\",\"id\":\"s13_4316\",\"timestamp\":1775634619},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: I was broken. I'm putting the pieces back together, but they fit differently now. Some parts are just... gone.\",\"id\":\"s13_4317\",\"timestamp\":1775634626},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Anduin Wrynn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Anduin Wrynn says: The Light called upon me, yes, but I'm still no great king. No true hero. I still can't even bring myself to abdicate the throne I don't deserve.\",\"id\":\"s13_4318\",\"timestamp\":1775634636},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Prophet Velen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prophet Velen says: Ah, Anduin. You are young. There are many futures yet ahead of you.\",\"id\":\"s13_4319\",\"timestamp\":1775634645},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Prophet Velen\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Prophet Velen says: But I will tell you this: in none of my visions did you remain idle for long.\",\"id\":\"s13_4320\",\"timestamp\":1775634654},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260661::::::::90:263:::::::::|h[Glowing Shrub]|h|r\",\"timestamp\":1775656844,\"id\":\"s13_4321\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3392:0|h[Remnant of Anguish]|h|rx6\",\"timestamp\":1775656845,\"id\":\"s13_4322\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:236761::::::::90:263::::1:38:13:::::|h[Tranquility Bloom |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx3\",\"timestamp\":1775656884,\"id\":\"s13_4323\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260309::::::::90:263:::::::::|h[Thrumming Plant Matter]|h|r\",\"timestamp\":1775656884,\"id\":\"s13_4324\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Kill for me. Now!\",\"timestamp\":1775656895,\"id\":\"s13_4325\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Astalor Bloodsworn says: Mmm hahaha...\",\"timestamp\":1775656930,\"id\":\"s13_4326\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260661::::::::90:263:::::::::|h[Glowing Shrub]|h|r\",\"id\":\"s13_4327\",\"timestamp\":1775664707},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242640::::::::90:263:::::::::|h[Plant Protein]|h|r\",\"id\":\"s13_4328\",\"timestamp\":1775664713},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260309::::::::90:263:::::::::|h[Thrumming Plant Matter]|h|r\",\"id\":\"s13_4329\",\"timestamp\":1775664713},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"Ambushed!\",\"id\":\"s13_4330\",\"timestamp\":1775664723},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zadu, Fist of Nalor