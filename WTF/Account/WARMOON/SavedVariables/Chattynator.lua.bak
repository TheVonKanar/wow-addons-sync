},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Amani Feller says: Keep back!",
["timestamp"] = 1772226084,
["id"] = "s0_3322",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
