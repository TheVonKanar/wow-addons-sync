},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Ja'bonu says: There is not much time left for me, Kvotheen. Hurry.",
["id"] = "s21_3992",
["timestamp"] = 1788040106,
},
