peInfo\":{\"player\":{\"name\":\"Vilebranch Hexwarder\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vilebranch Hexwarder says: You're weak just like dem Witherbark!\",\"id\":\"s18_4149\",\"timestamp\":1786973506},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vilebranch Hexwarder\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vilebranch Hexwarder says: Numazon is ours!\",\"id\":\"s18_4150\",\"timestamp\":1786973506},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vilebranch Siphoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vilebranch Siphoner says: Are ya ready to be my next sacrifice?\",\"id\":\"s18_4151\",\"timestamp\":1786973507},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vilebranch Siphoner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vilebranch Siphoner says: No! De ritual isn't ready yet!\",\"id\":\"s18_4152\",\"timestamp\":1786973512},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::90:263:::::::::|h[Lustrous Wildlife Pelt]|h|r\",\"id\":\"s18_4153\",\"timestamp\":1786973513},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260660::::::::90:263:::::::::|h[Putrid Mushroom Spores]|h|rx3\",\"id\":\"s18_4154\",\"timestamp\":1786973513},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|rx5\",\"id\":\"s18_4155\",\"timestamp\":1786973513},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vilebranch Hexwarder\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vilebranch Hexwarder says: A hex on ya!\",\"id\":\"s18_4156\",\"timestamp\":1786973519},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:258917::::::::90:263::134:3:13901:6652:13663:2:9:90:28:3321:::::|h[Tarnished Dawnlit Spellbinder's Pads]|h|r\",\"id\":\"s18_4157\",\"timestamp\":1786973526},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::90:263:::::::::|h[Lustrous Wildlife Pelt]|h|rx2\",\"id\":\"s18_4158\",\"timestamp\":1786973526},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260687::::::::90:263:::::::::|h[Decaying Leather]|h|r\",\"id\":\"s18_4159\",\"timestamp\":1786973526},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262654::::::::90:263:::::::::|h[Amani Tablet Rubbing]|h|r\",\"id\":\"s18_4160\",\"timestamp\":1786973528},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vilebranch Hexwarder\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vilebranch Hexwarder says: Numazon is ours!\",\"id\":\"s18_4161\",\"timestamp\":1786973540},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s18_4162\",\"timestamp\":1786973544},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Dis tablet here says de first shrine built in Atal'Aman was dedicated to de serpent's victory.\",\"id\":\"s18_4163\",\"timestamp\":1786973560},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Are dey talking about Ula'tek?\",\"id\":\"s18_4164\",\"timestamp\":1786973569},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Befuddled Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Befuddled Amani Mask says: De path to Ula'tek lies in de Maisara Deeps. With Hex Lord Malacrass.\",\"id\":\"s18_4165\",\"timestamp\":1786973609},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Malacrass! This is madness! He betrayed and enslaved our loa!\",\"id\":\"s18_4166\",\"timestamp\":1786973618},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Vilebranch? Malacrass? We must tell Zul'jarra.\",\"id\":\"s18_4167\",\"timestamp\":1786973635},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: She will try to stop me from finding Ula'tek, just like with de lightwood. But we needed de lightwood, and we will need Ula'tek.\",\"id\":\"s18_4168\",\"timestamp\":1786973640},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: If de ancient Amani sealed Ula'tek away, it may be too dangerous to unleash.\",\"id\":\"s18_4169\",\"timestamp\":1786973651},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Or it may be de weapon we need. For when de elves make war on us. For when de loa abandon us.\",\"id\":\"s18_4170\",\"timestamp\":1786973656},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: De loa will not abandon us!\",\"id\":\"s18_4171\",\"timestamp\":1786973666},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: How can you be sure? They have done it before, ah? Why not put some of that faith in me, Uncle?\",\"id\":\"s18_4172\",\"timestamp\":1786973668},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Dis is a fool's errand. Malacrass is dead!\",\"id\":\"s18_4173\",\"timestamp\":1786973752},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Enchanted Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Enchanted Amani Mask says: Even so, it is his knowledge that we seek.\",\"id\":\"s18_4174\",\"timestamp\":1786973757},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Jan-boy, no good can come from dat villain's writings.\",\"id\":\"s18_4175\",\"timestamp\":1786973799},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Knowledge is not good or bad, Uncle. It's what you do with it that matters.\",\"id\":\"s18_4176\",\"timestamp\":1786973803},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Uy'okan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Uy'okan says: Little Zul'jan, come to do his sister's bidding!\",\"id\":\"s18_4177\",\"timestamp\":1786973805},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Uy'okan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Uy'okan says: You will always be... in your sister's shadow...\",\"id\":\"s18_4178\",\"timestamp\":1786973815},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260687::::::::90:263:::::::::|h[Decaying Leather]|h|r\",\"id\":\"s18_4179\",\"timestamp\":1786973823},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|rx2\",\"id\":\"s18_4180\",\"timestamp\":1786973823},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|r\",\"id\":\"s18_4181\",\"timestamp\":1786973823},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 6 Gold, 22 Silver, 30 Copper (+12 Silver, 44 Copper)\",\"id\":\"s18_4182\",\"timestamp\":1786973824},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Uy'okan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Uy'okan says: Malacrass always said dat binding de loa was just de first step. He had bigger plans than dat.\",\"id\":\"s18_4183\",\"timestamp\":1786973834},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Jintagga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Jintagga says: Malacrass was de greatest of de Vilebranch!\",\"id\":\"s18_4184\",\"timestamp\":1786973865},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Jintagga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Jintagga says: Hex Lord... return to us...\",\"id\":\"s18_4185\",\"timestamp\":1786973891},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s18_4186\",\"timestamp\":1786973892},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 7 Gold, 27 Silver, 47 Copper (+14 Silver, 54 Copper)\",\"id\":\"s18_4187\",\"timestamp\":1786973893},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 11 Gold, 9 Silver, 26 Copper (+22 Silver, 18 Copper)\",\"id\":\"s18_4188\",\"timestamp\":1786973916},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:259189::::::::90:263::::1:28:3321:::::|h[Aged Cruor]|h|r\",\"id\":\"s18_4189\",\"timestamp\":1786973920},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:258138::::::::90:263:::::::::|h[Potent Healing Potion]|h|rx2\",\"id\":\"s18_4190\",\"timestamp\":1786973920},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx9\",\"id\":\"s18_4191\",\"timestamp\":1786973921},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Soye'mal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Soye'mal says: De loa have failed us for generations!\",\"id\":\"s18_4192\",\"timestamp\":1786973949},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Soye'mal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Soye'mal says: We will never... serve de loa...\",\"id\":\"s18_4193\",\"timestamp\":1786973958},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 10 Gold, 79 Silver, 37 Copper (+21 Silver, 58 Copper)\",\"id\":\"s18_4194\",\"timestamp\":1786973961},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Soye'mal\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Soye'mal says: Ula'tek was Malacrass's obsession. A way to return to de Amani empire!\",\"id\":\"s18_4195\",\"timestamp\":1786973966},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Riøsky\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Riøsky-Hyjal:114:GUILD:|h[|cffff7c0aRiøsky|r]|h: re \",\"id\":\"s18_4196\",\"timestamp\":1786973976},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::90:263:::::::::|h[Lustrous Wildlife Pelt]|h|r\",\"id\":\"s18_4197\",\"timestamp\":1786973984},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|r\",\"id\":\"s18_4198\",\"timestamp\":1786973984},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Jintagga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Jintagga says: Malacrass was de greatest of de Vilebranch!\",\"id\":\"s18_4199\",\"timestamp\":1786973992},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Jintagga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Jintagga says: Hex Lord... return to us...\",\"id\":\"s18_4200\",\"timestamp\":1786974002},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 3 Gold, 85 Silver, 70 Copper (+7 Silver, 71 Copper)\",\"id\":\"s18_4201\",\"timestamp\":1786974004},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"SHAMAN\",\"name\":\"Heliotrope-Archimonde\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Heliotrope-Archimonde:120:GUILD:|h[|cff0070ddHeliotrope|r]|h: coucou \",\"id\":\"s18_4202\",\"timestamp\":1786974008},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hex Master Jintagga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hex Master Jintagga says: Vordaza was de Hex Lord's favored apprentice. If any have Malacrass's scrolls, it is her.\",\"id\":\"s18_4203\",\"timestamp\":1786974012},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|r\",\"id\":\"s18_4204\",\"timestamp\":1786974054},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::90:263:::::::::|h[Lustrous Wildlife Pelt]|h|r\",\"id\":\"s18_4205\",\"timestamp\":1786974054},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 11 Gold, 31 Silver, 18 Copper (+22 Silver, 62 Copper)\",\"id\":\"s18_4206\",\"timestamp\":1786974055},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4207\",\"timestamp\":1786974055},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Enchanted Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Enchanted Amani Mask says: You do not share your uncle's faith in de loa?\",\"id\":\"s18_4208\",\"timestamp\":1786974056},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4209\",\"timestamp\":1786974061},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: I have lived my entire life without dem. Why should I?\",\"id\":\"s18_4210\",\"timestamp\":1786974063},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Enchanted Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Enchanted Amani Mask says: True. Dey were here for generations, yet our empire has crumbled.\",\"id\":\"s18_4211\",\"timestamp\":1786974069},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::90:263:::::::::|h[Lustrous Wildlife Pelt]|h|r\",\"id\":\"s18_4212\",\"timestamp\":1786974089},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|rx2\",\"id\":\"s18_4213\",\"timestamp\":1786974089},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 10 Gold, 40 Silver, 11 Copper (+20 Silver, 80 Copper)\",\"id\":\"s18_4214\",\"timestamp\":1786974090},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4215\",\"timestamp\":1786974092},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4216\",\"timestamp\":1786974118},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: What did Malacrass do to de loa?\",\"id\":\"s18_4217\",\"timestamp\":1786974118},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Enchanted Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Enchanted Amani Mask says: Your grandfather asked de loa to help fight de elves and other gokinye. Dey refused.\",\"id\":\"s18_4218\",\"timestamp\":1786974122},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s18_4219\",\"timestamp\":1786974131},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|r\",\"id\":\"s18_4220\",\"timestamp\":1786974131},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Enchanted Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Enchanted Amani Mask says: So Zul'jin and Malacrass decided to take de power dey needed, instead of begging for it.\",\"id\":\"s18_4221\",\"timestamp\":1786974132},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s18_4222\",\"timestamp\":1786974143},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|r\",\"id\":\"s18_4223\",\"timestamp\":1786974143},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4224\",\"timestamp\":1786974145},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s18_4225\",\"timestamp\":1786974187},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s18_4226\",\"timestamp\":1786974187},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|r\",\"id\":\"s18_4227\",\"timestamp\":1786974187},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 5 Gold, 35 Silver, 81 Copper (+10 Silver, 71 Copper)\",\"id\":\"s18_4228\",\"timestamp\":1786974188},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4229\",\"timestamp\":1786974189},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s18_4230\",\"timestamp\":1786974246},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260687::::::::90:263:::::::::|h[Decaying Leather]|h|r\",\"id\":\"s18_4231\",\"timestamp\":1786974246},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|rx3\",\"id\":\"s18_4232\",\"timestamp\":1786974246},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 3 Gold, 73 Silver, 89 Copper (+7 Silver, 47 Copper)\",\"id\":\"s18_4233\",\"timestamp\":1786974247},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4234\",\"timestamp\":1786974251},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Enchanted Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Enchanted Amani Mask says: Malacrass infused avatars with de loa's power--avatars like your grandfather.\",\"id\":\"s18_4235\",\"timestamp\":1786974252},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: So he researched Ula'tek. If Grandfather could wield de power of our greatest weapon, then...\",\"id\":\"s18_4236\",\"timestamp\":1786974261},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Enchanted Amani Mask\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Enchanted Amani Mask says: He could reclaim stolen lands. Rebuild de empire. Realize his dream.\",\"id\":\"s18_4237\",\"timestamp\":1786974270},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::90:263:::::::::|h[Lustrous Wildlife Pelt]|h|r\",\"id\":\"s18_4238\",\"timestamp\":1786974367},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::90:263:::::::::|h[Unrecognizable Organ]|h|rx2\",\"id\":\"s18_4239\",\"timestamp\":1786974367},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:264593::::::::90:263::135:4:12817:6652:13663:11311:1:28:4281:::::|h[Warcloak of the Butcher]|h|r\",\"id\":\"s18_4240\",\"timestamp\":1786974367},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:259361::::::::90:263:::::::::|h[Vile Essence]|h|rx4\",\"id\":\"s18_4241\",\"timestamp\":1786974367},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx50\",\"id\":\"s18_4242\",\"timestamp\":1786974367},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:262752::::::::90:263:::::::::|h[Vilebranch Scroll]|h|r\",\"id\":\"s18_4243\",\"timestamp\":1786974371},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Uncle! The scrolls are with Vordaza in de Maisara Caverns.\",\"id\":\"s18_4244\",\"timestamp\":1786974385},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Our best lead to Ula'tek are those notes in Vordaza's possession. Don't get blood on dem.\",\"id\":\"s18_4245\",\"timestamp\":1786974431},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Jan-boy, dis has gone far enough. We must stop following Malacrass's footsteps! Lest we anger de loa.\",\"id\":\"s18_4246\",\"timestamp\":1786974442},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: De loa? If we can harness Ula'tek's power, we will not need de loa.\",\"id\":\"s18_4247\",\"timestamp\":1786974450},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"SHAMAN\",\"name\":\"Øskycham-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Øskycham-Archimonde|h[|cff0070ddØskycham-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:63390:Player-1302-0A0D3087:1:8:17:26:4294967295:4294967295:4294967295:4294967295|h[Turn the Surge]|h|r !\",\"id\":\"s18_4248\",\"timestamp\":1786974451},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: How can you say dat? De loa made your sister hash'ey! Dey helped us defeat de Twilight's Blade!\",\"id\":\"s18_4249\",\"timestamp\":1786974456},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: What about when de elves invaded our lands? When de Trollbanes hunted our people? When my grandfather was tortured?\",\"id\":\"s18_4250\",\"timestamp\":1786974464},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: And still, we had to beg them to aid us against the Twilight's Blade.\",\"id\":\"s18_4251\",\"timestamp\":1786974474},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: No, Uncle. We must take the power we need to protect the Amani, like my grandfather did.\",\"id\":\"s18_4252\",\"timestamp\":1786974481},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Your grandfather led de Amani to catastrophe, Zul'jan!\",\"id\":\"s18_4253\",\"timestamp\":1786974492},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: My grandfather did what was needed. The Amani stand alone. And the Amani never die.\",\"id\":\"s18_4254\",\"timestamp\":1786974496},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"SHAMAN\",\"name\":\"Øskycham-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Øskycham-Archimonde:182:GUILD:|h[|cff0070ddØskycham|r]|h: |cffffff00|Hworldmap:2512:7144:5720|h[|A:Waypoint-MapPin-ChatIcon:13:13:0:0|a Emplacement marqué sur la carte]|h|r\",\"id\":\"s18_4255\",\"timestamp\":1786974640},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:262791::::::::90:263:::::::::|h[Malacrass's Notes]|h|r\",\"id\":\"s18_4256\",\"timestamp\":1786974878},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: We haven't had any luck here. Did you succeed in getting Malacrass's notes?\",\"id\":\"s18_4257\",\"timestamp\":1786974879},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: De key to Ula'tek is hidden in de serpent shrine of Atal'Aman! Let's go!\",\"id\":\"s18_4258\",\"timestamp\":1786974915},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Zul'jan, wait! We need to tell Zul'jarra!\",\"id\":\"s18_4259\",\"timestamp\":1786974925},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Zul'jan! Stop!\",\"id\":\"s18_4260\",\"timestamp\":1786974931},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Unknown says: If de key is within, we will have to smash de shrine open.\",\"id\":\"s18_4261\",\"timestamp\":1786974957},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Let me know when you're ready.\",\"id\":\"s18_4262\",\"timestamp\":1786974987},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Zul'jan, something's happening!\",\"id\":\"s18_4263\",\"timestamp\":1786974993},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Strongblood Jak'mo\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Strongblood Jak'mo yells: Death to all who seek de serpent's power!\",\"id\":\"s18_4264\",\"timestamp\":1786974999},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Stop! We don't need to do this!\",\"id\":\"s18_4265\",\"timestamp\":1786975011},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Yes we do, uncle! De Amani must stand strong! We carve our own path!\",\"id\":\"s18_4266\",\"timestamp\":1786975015},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Do not be tempted by power like your grandfather! He brought ruin to us all!\",\"id\":\"s18_4267\",\"timestamp\":1786975022},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: He tried to unite de tribes! To take back de land dat was stolen from us!\",\"id\":\"s18_4268\",\"timestamp\":1786975029},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: You do not need Ula'tek's power, Jan-boy! We have Zul'jarra, de hash'ey, to protect us!\",\"id\":\"s18_4269\",\"timestamp\":1786975034},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: And when de loa abandon us again? We cannot rely on dem!\",\"id\":\"s18_4270\",\"timestamp\":1786975041},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Strongblood Jak'mo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Strongblood Jak'mo says: I promised de Amani... Never again...\",\"id\":\"s18_4271\",\"timestamp\":1786975049},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Our ancestors are warning us! Kvotheen, help me stop this!\",\"id\":\"s18_4272\",\"timestamp\":1786975054},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: You're awake! You were out for quite a while.\",\"id\":\"s18_4273\",\"timestamp\":1786975188},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: Zul'jarra is at the loa shrine attending to Kinduru. Come.\",\"id\":\"s18_4274\",\"timestamp\":1786975220},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: What will we do without you, Uncle?\",\"id\":\"s18_4275\",\"timestamp\":1786975226},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: I see. Kvotheen, would you honor us by helping with de death rites? De herbs are on de cart.\",\"id\":\"s18_4276\",\"timestamp\":1786975230},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: As for Zul'jan, he has always obsessed over our ancestors' legacy. And our grandfather's glory.\",\"id\":\"s18_4277\",\"timestamp\":1786975238},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: But to join forces with Malacrass? Dat fool! I warned him about dat villain. He manipulated Grandfather, and now...\",\"id\":\"s18_4278\",\"timestamp\":1786975248},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Malacrass did this. He killed my uncle. I know it in my bones. And now he has my brother in his clutches.\",\"id\":\"s18_4279\",\"timestamp\":1786975258},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: We have to find dem. I have to save him. Zul'jan is a dolt but he is my brother... and de only family I have left.\",\"id\":\"s18_4280\",\"timestamp\":1786975268},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:268557::::::::90:263::11::1:28:373:::::|h[Akiki]|h|r\",\"id\":\"s18_4281\",\"timestamp\":1786975287},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Zul'jarra! The Witherbark are under attack! Their village is overrun!\",\"id\":\"s18_4282\",\"timestamp\":1786975287},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Uncle, I'm sorry I wasn't there to protect you. I should not have made Zul'jan your responsibility.\",\"id\":\"s18_4283\",\"timestamp\":1786975304},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: He's always trouble. Remember our trip to de coast? Little Zul'jan tried to swim across de strait! You were so mad!\",\"id\":\"s18_4284\",\"timestamp\":1786975311},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: When our father died, you helped our mother raise us. Told us stories of de loa, taught us what it means to be Amani.\",\"id\":\"s18_4285\",\"timestamp\":1786975322},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Then when de Twilight's Blade nearly beat us, you were de one to put me on de path of de hash'ey.\",\"id\":\"s18_4286\",\"timestamp\":1786975332},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3150:0|h[Midnight Alchemy Knowledge]|h|rx1\",\"id\":\"s18_4287\",\"timestamp\":1786975335},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3256:0|h[Artisan Alchemist's Moxie]|h|rx5\",\"id\":\"s18_4288\",\"timestamp\":1786975335},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: You are de reason why de loa came back to us. You never lost faith in dem. And you never lost faith in me.\",\"id\":\"s18_4289\",\"timestamp\":1786975338},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: You were a second father to me, Uncle Kinduru. I will miss you. And I hope dat I have made you proud.\",\"id\":\"s18_4290\",\"timestamp\":1786975347},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Dis could be de Vilebranch taking revenge... but I have a feeling it's something else. Let's go!\",\"id\":\"s18_4291\",\"timestamp\":1786975383},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx2000\",\"id\":\"s18_4292\",\"timestamp\":1786975424},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:257219::::::::90:263::14::1:28:872:::::|h[Amani Blessed Bear]|h|r\",\"id\":\"s18_4293\",\"timestamp\":1786975444},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Torundo The Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Torundo The Grizzled says: Our beasts favor bloodthirsty insects from de Leech Bog. Help gather some more for de hunt.\",\"id\":\"s18_4294\",\"timestamp\":1786975482},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:238465::::::::90:263:::::::::|h[Thalassian Phoenix Plume]|h|r\",\"id\":\"s18_4295\",\"timestamp\":1786975508},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:236780::::::::90:263:::::::::|h[Nocturnal Lotus]|h|r\",\"id\":\"s18_4296\",\"timestamp\":1786975508},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:236761::::::::90:263::::1:38:13:::::|h[Tranquility Bloom |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx9\",\"id\":\"s18_4297\",\"timestamp\":1786975508},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260664::::::::90:263:::::::::|h[Biolum