},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lysikas says: Trust me, I wish I were wrong, but I doubt we're that lucky. Lead on.",
["timestamp"] = 1772580040,
["id"] = "s2_3483",
},
