["g"] = 0.6666666865348816,
["r"] = 0,
},
["text"] = "You receive loot: |cnIQ0:|Hitem:258851::::::::90:263::4:1:13611:2:9:90:28:3322:::::|h[Stained Hauberk]|h|r",
