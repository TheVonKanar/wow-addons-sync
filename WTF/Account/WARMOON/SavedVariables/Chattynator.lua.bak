},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Orn'shan says: Trust is hard for me... but you've shown real gentleness.",
["timestamp"] = 1772658276,
["id"] = "s3_2616",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
