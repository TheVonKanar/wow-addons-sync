["g"] = 1,
["r"] = 1,
},
["text"] = "Monte Gazlowe says: Go get Orweyna! I'll be fine for now. Nice critter here. Nice, quill-covered, bear-like... critter.",
["id"] = "s2_4159",
["timestamp"] = 1772648193,
},
{
