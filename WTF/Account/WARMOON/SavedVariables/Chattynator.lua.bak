},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Vereesa Windrunner yells: Heroes, now! We must bring them down together!",
["id"] = "s17_4822",
["timestamp"] = 1777927356,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
