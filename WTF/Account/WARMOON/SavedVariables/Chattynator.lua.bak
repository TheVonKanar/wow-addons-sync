["b"] = 0,
},
["text"] = "You receive loot: |cnIQ2:|Hitem:236778::::::::90:263:::::::::|h[Mana Lily |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r",
["timestamp"] = 1772820026,
["id"] = "s3_4627",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ2:|Hitem:236778::::::::90:263:::::::::|h[Mana Lily |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r",
["timestamp"] = 1772820039,
["id"] = "s3_4628",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Sentient Voidwalker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Sentient Voidwalker says: With your strength, the visions become clearer...",
["timestamp"] = 1772820043,
["id"] = "s3_4629",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Faindel",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Faindel says: Our group was routed by a beast of the Voidstorm. It's closing in on us. Hurry!",
["timestamp"] = 1772820047,
["id"] = "s3_4630",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Sentient Voidwalker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Sentient Voidwalker says: Another. Come.",
["timestamp"] = 1772820053,
["id"] = "s3_4631",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Sentient Voidwalker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Sentient Voidwalker says: The power... flows through me!",
["timestamp"] = 1772820064,
["id"] = "s3_4632",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Faindel",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Faindel says: It's coming. By the Void, it's coming! Is there anyone out there?",
["timestamp"] = 1772820068,
["id"] = "s3_4633",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: I can hardly stand upright, but we still don't know WHERE Faindel is...",
["timestamp"] = 1772820074,
["id"] = "s3_4634",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ1:|Hitem:236761::::::::90:263::::1:38:13:::::|h[Tranquility Bloom |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx4",
["timestamp"] = 1772820082,
["id"] = "s3_4635",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Faindel",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Faindel says: We're on the plateau just southeast of Locus Point. Trust the voidwalker!",
["timestamp"] = 1772820090,
["id"] = "s3_4636",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Sentient Voidwalker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Sentient Voidwalker says: Yes. Trust in me. We will meet on the plateau.",
["timestamp"] = 1772820096,
["id"] = "s3_4637",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ1:|Hitem:236761::::::::90:263::::1:38:13:::::|h[Tranquility Bloom |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx4",
["timestamp"] = 1772820100,
["id"] = "s3_4638",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ2:|Hitem:236770::::::::90:263::::1:38:13:::::|h[Sanguithorn |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r",
["timestamp"] = 1772820108,
["id"] = "s3_4639",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: Meet me at the foot of the plateau. We won't be caught off guard again!",
["timestamp"] = 1772820116,
["id"] = "s3_4640",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: Here, Kvotheen.",
["timestamp"] = 1772820116,
["id"] = "s3_4641",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: Void beings are known for their all-consuming hunger. Rare to see one so... manipulative.",
["timestamp"] = 1772820147,
["id"] = "s3_4642",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Deceitful Voidwalker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Deceitful Voidwalker says: Your essence will fuel my ascension!",
["timestamp"] = 1772820153,
["id"] = "s3_4643",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Deceitful Voidwalker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Deceitful Voidwalker says: I... could have been... more...",
["timestamp"] = 1772820161,
["id"] = "s3_4644",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ0:|Hitem:260677::::::::90:263:::::::::|h[Void Flakes]|h|r",
["timestamp"] = 1772820162,
["id"] = "s3_4645",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: We lost many to this wretched being... but I'm glad to see some of you safe.",
["timestamp"] = 1772820165,
["id"] = "s3_4646",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ3:|Hitem:237497::::::::90:263:::::::::|h[Resilient Seed]|h|r",
["timestamp"] = 1772820170,
["id"] = "s3_4647",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ2:|Hitem:236770::::::::90:263::::1:38:13:::::|h[Sanguithorn |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2",
["timestamp"] = 1772820170,
["id"] = "s3_4648",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Missing Scout",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Missing Scout says: Faindel tried to distract it... to let us escape... but we were all so weak...",
["timestamp"] = 1772820170,
["id"] = "s3_4649",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: I wish we'd gotten here sooner. Let's see the rest of you back to Locus Point.",
["timestamp"] = 1772820176,
["id"] = "s3_4650",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ3:|Hitem:266098::::::::90:263::::1:28:3321:::::|h[Faindel's Longbow]|h|r",
["timestamp"] = 1772820177,
["id"] = "s3_4651",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive item: |cnIQ2:|Hitem:264297::::::::90:263::60:1:13573:2:9:90:28:3321:::::|h[Nightbreaker's Cuffs]|h|r",
["timestamp"] = 1772820209,
["id"] = "s3_4652",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Lucia Nightbreaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lucia Nightbreaker says: Tell you what, minion. After one hundred years, if you're still unhappy with our arrangement, I'll allow you to renegotiate our terms.",
["timestamp"] = 1772820211,
["id"] = "s3_4653",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kalgorg",
},
["event"] = "CHAT_MSG_MONSTER_WHISPER",
["type"] = "MONSTER_WHISPER",
},
["color"] = {
["r"] = 1,
["g"] = 0.7098039388656616,
["b"] = 0.9215686917304993,
},
["text"] = "Kalgorg whispers: You will both die screaming in agony.",
["timestamp"] = 1772820218,
["id"] = "s3_4654",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Lucia Nightbreaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lucia Nightbreaker says: Threatening my new associate? Make it two hundred years.",
["timestamp"] = 1772820221,
["id"] = "s3_4655",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Astre",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Riftblade Astre says: Oh, Kvotheen. Do you have word from Hieron and the others?",
["timestamp"] = 1772820232,
["id"] = "s3_4656",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Astre",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Riftblade Astre says: I see. Hieron is gone.",
["timestamp"] = 1772820240,
["id"] = "s3_4657",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Astre",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Riftblade Astre says: Why couldn't the blood elves have just fought their own battle? Damn these whispers.",
["timestamp"] = 1772820299,
["id"] = "s3_4658",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive item: |cnIQ2:|Hitem:264423::::::::90:263::60:1:13573:2:9:90:28:3321:::::|h[Voidcaster's Reaver]|h|r",
["timestamp"] = 1772820314,
["id"] = "s3_4659",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: That creature was gathering power... feeding on the essence of so many of us.",
["timestamp"] = 1772820315,
["id"] = "s3_4660",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: We may have stopped it from becoming something even more horrific.",
["timestamp"] = 1772820320,
["id"] = "s3_4661",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Scout Nefina says: The Void's presence is too much in this place. I feel it even now, tugging at my very being...",
["timestamp"] = 1772820324,
["id"] = "s3_4662",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Scout Nefina",
},
["event"] = "CHAT_MSG_MONSTER_EMOTE",
["type"] = "MONSTER_EMOTE",
},
["color"] = {
["r"] = 1,
["g"] = 0.501960813999176,
["b"] = 0.250980406999588,
},
["text"] = "Scout Nefina stares into the fire intently.",
["timestamp"] = 1772820330,
["id"] = "s3_4663",
},
