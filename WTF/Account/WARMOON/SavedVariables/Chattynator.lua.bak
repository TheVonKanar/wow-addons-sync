:\"Danath Trollbane\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Danath Trollbane says: I understand your frustration, Geya'rah. But do not rush to conclusions.\",\"id\":\"s17_3752\",\"timestamp\":1777658305},{\"recordedBy\":\"Quiproquo-Uldaman\",\"typeInfo\":{\"player\":{\"name\":\"Mr. Sunflower\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mr. Sunflower says: A very pleasant day to you, ma'am.\",\"timestamp\":1777658344,\"id\":\"s17_3753\"},{\"recordedBy\":\"Quiproquo-Uldaman\",\"typeInfo\":{\"player\":{\"name\":\"Mr. Sunflower\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mr. Sunflower says: Do you have any small gold stars? Preferably in a sticker format.\",\"timestamp\":1777658353,\"id\":\"s17_3754\"},{\"recordedBy\":\"Quiproquo-Uldaman\",\"typeInfo\":{\"player\":{\"name\":\"Mr. Sunflower\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mr. Sunflower says: Oh yes please! Can I get them with writing on it?\",\"timestamp\":1777658364,\"id\":\"s17_3755\"},{\"recordedBy\":\"Quiproquo-Uldaman\",\"typeInfo\":{\"player\":{\"name\":\"Mr. Sunflower\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mr. Sunflower says: Some with \\\"Good Job!\\\", \\\"Well Done!\\\", and \\\"Not murdered anyone recently!\\\" would be wonderful.\",\"timestamp\":1777658368,\"id\":\"s17_3756\"},{\"recordedBy\":\"Quiproquo-Uldaman\",\"typeInfo\":{\"player\":{\"name\":\"Mr. Sunflower\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mr. Sunflower says: Fantastic. I shall return later. Wonderful to meet you.\",\"timestamp