{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Decimus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Decimus says: Your more... \"adventurous\" scouts have attempted to make use of this world's volatile resources. Avoid causing any unfortunate mishaps while collecting it.",
["id"] = "s20_3162",
["timestamp"] = 1787244314,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Commander Tala'saan",
},
["event"] = "CHAT_MSG_MONSTER_WHISPER",
["type"] = "MONSTER_WHISPER",
},
["color"] = {
["b"] = 0.9215686917304993,
["g"] = 0.7098039388656616,
["r"] = 1,
},
["text"] = "Commander Tala'saan whispers: Between these shifting ice storms and the creatures below, traversing the valley will be dangerous. Use caution, Kvotheen.",
["id"] = "s20_3163",
["timestamp"] = 1787244318,
},
