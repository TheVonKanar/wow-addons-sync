},
["text"] = "You receive loot: |cnIQ1:|Hitem:242640::::::::90:263:::::::::|h[Plant Protein]|h|r",
["timestamp"] = 1772660853,
["id"] = "s3_2952",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: Meet me back at Har'kuai. We're going to summon ourselves a flying serpent!",
["timestamp"] = 1772660887,
["id"] = "s3_2953",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: There you are! Come on. Throw the shards into the pools!",
["timestamp"] = 1772660899,
["id"] = "s3_2954",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: Look! It's happening!",
["timestamp"] = 1772660905,
["id"] = "s3_2955",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: ...Wait. That's it? That-- that can't be! I was so sure...",
["timestamp"] = 1772660911,
["id"] = "s3_2956",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive item: |cnIQ3:|Hitem:255826::::::::90:263:::::::::|h[Mysterious Skyshards]|h|rx5",
["timestamp"] = 1772660922,
["id"] = "s3_2957",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kamari",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kamari says: I hope you are not too disappointed, little one. Mysteries and legends are fickle things.",
["timestamp"] = 1772660925,
["id"] = "s3_2958",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: Disappointed?! No way!",
["timestamp"] = 1772660929,
["id"] = "s3_2959",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: So our first attempt didn't work. That doesn't mean Aln'sharan isn't real! It just means I'm missing something.",
["timestamp"] = 1772660930,
["id"] = "s3_2960",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: Our home is filled to the brim with wonders. Everything is so strange and old! I bet Aln'sharan is out there. I just have to figure out how to call him down!",
["timestamp"] = 1772660936,
["id"] = "s3_2961",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Su'meera",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Su'meera says: This way, shaman. Race you there!",
["timestamp"] = 1772660954,
["id"] = "s3_2962",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
