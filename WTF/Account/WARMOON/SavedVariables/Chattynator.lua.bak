Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 4 Gold, 56 Silver, 6 Copper (+9 Silver, 11 Copper)\",\"timestamp\":1787208101,\"id\":\"s19_4727\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thalassian Professor says: Kvotheen, my students and I were just discussing the surprisingly welcoming nature of the Twilight's Blade. Would you not agree?\",\"timestamp\":1787208102,\"id\":\"s19_4728\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Stay here and recover.\",\"timestamp\":1787208106,\"id\":\"s19_4729\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"University Undergraduate\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"University Undergraduate says: The professor... is a monster!\",\"timestamp\":1787208107,\"id\":\"s19_4730\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thalassian Professor says: Kvotheen, there is nothing to see here. All is well.\",\"timestamp\":1787208116,\"id\":\"s19_4731\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Knife to the back.\",\"timestamp\":1787208128,\"id\":\"s19_4732\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 3 Gold, 50 Silver, 4 Copper (+6 Silver, 99 Copper)\",\"timestamp\":1787208136,\"id\":\"s19_4733\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Their life essence is yours. Claim it.\",\"timestamp\":1787208149,\"id\":\"s19_4734\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alina Everlark\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alina Everlark says: Kvotheen, thank goodness you're here. Some of our visiting professors are acting quite strange!\",\"timestamp\":1787208156,\"id\":\"s19_4735\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thalassian Professor says: You must welcome the Twilight's Blade to present their views at our institute of higher learning.\",\"timestamp\":1787208159,\"id\":\"s19_4736\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: I've drawn a healing circle.\",\"timestamp\":1787208164,\"id\":\"s19_4737\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"University Undergraduate\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"University Undergraduate says: This was not part of the assignment!\",\"timestamp\":1787208178,\"id\":\"s19_4738\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: I'll provide cover.\",\"timestamp\":1787208182,\"id\":\"s19_4739\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 6 Gold, 49 Silver, 66 Copper (+12 Silver, 98 Copper)\",\"timestamp\":1787208201,\"id\":\"s19_4740\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Valeera Sanguinar focuses on something shiny.\",\"timestamp\":1787208201,\"id\":\"s19_4741\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 1 Gold, 42 Silver, 42 Copper (+2 Silver, 84 Copper)\",\"timestamp\":1787208216,\"id\":\"s19_4742\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thalassian Professor\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thalassian Professor says: Kvotheen, perfect! Now, we'll witness the threat posed by the Twilight's Blade firsthand.\",\"timestamp\":1787208222,\"id\":\"s19_4743\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Valeera Sanguinar says: Stay here and recover.\",\"timestamp\":1787208224,\"id\":\"s19_4744\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\"