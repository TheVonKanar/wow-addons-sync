},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Riftblade Maella says: Let's move. Your hunch better not be a waste of time.",
["timestamp"] = 1772580037,
["id"] = "s2_3482",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
