\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:2803:0|h[Undercoin]|h|rx75\",\"timestamp\":1787209903,\"id\":\"s19_4948\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:272229::::::::90:263::174:4:12826:6652:13668:11215:1:28:6011:::::|h[Serpentine Talisman]|h|r\",\"timestamp\":1787209903,\"id\":\"s19_4949\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx45\",\"timestamp\":1787209904,\"id\":\"s19_4950\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:2803:0|h[Undercoin]|h|rx74\",\"timestamp\":1787209909,\"id\":\"s19_4951\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:244361::::::::90:263:::::::::|h[Void-Carved Amethyst]|h|r\",\"timestamp\":1787209909,\"id\":\"s19_4952\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3444:0|h[Champion Mistcrest]|h|rx5\",\"timestamp\":1787209910,\"id\":\"s19_4953\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx40\",\"timestamp\":1787209910,\"id\":\"s19_4954\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:274498::::::::90:263::174:3:12826:6652:11215:1:28:6011:::::|h[Spirit Ward]|h|r\",\"timestamp\":1787209912,\"id\":\"s19_4955\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:272247::::::::90:263::126:3:12819:6652:13663:1:28:6011:::::|h[Galerider's Byrnie]|h|r\",\"timestamp\":1787209912,\"id\":\"s19_4956\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3444:0|h[Champion Mistcrest]|h|rx6\",\"timestamp\":1787209913,\"id\":\"s19_4957\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:2803:0|h[Undercoin]|h|rx104\",\"timestamp\":1787209916,\"id\":\"s19_4958\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:249219::::::::90:263::27:1:13212:1:28:6011:::::|h[Ouroboric Curse]|h|r\",\"timestamp\":1787209917,\"id\":\"s19_4959\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:273000::::::::90:263:::::::::|h[Corrosive Soul]|h|r\",\"timestamp\":1787209917,\"id\":\"s19_4960\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:265695::::::::90:263:::::::::|h[Elementary Voidcore Shard]|h|r\",\"timestamp\":1787209917,\"id\":\"s19_4961\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:274493::::::::90:263::109:2:12834:6652:1:28:6011:::::|h[Effigy of Ula'tek's Faithful]|h|r\",\"timestamp\":1787209917,\"id\":\"s19_4962\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx140\",\"timestamp\":1787209917,\"id\":\"s19_4963\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mystic Birdhat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mystic Birdhat says: I feel like I lost an eighth of something.\",\"timestamp\":1787210002,\"id\":\"s19_4964\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Silvermoon's students have unique ways of studying the arcane. Perhaps you could learn a thing or two.\",\"timestamp\":1787210318,\"id\":\"s19_4965\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Ah, you've arrived. Good. Urgent matters are afoot.\",\"timestamp\":1787210319,\"id\":\"s19_4966\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: The Magisters' Terrace awaits. Let's not keep Magister Umbric waiting unsupervised. Shall we?\",\"timestamp\":1787210332,\"id\":\"s19_4967\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Human\",\"name\":\"Delondra-LaCroisadeécarlate\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Delondra-LaCroisadeécarlate:833:GUILD:|h[|cfff48cbaDelondra-LaCroisadeécarlate|r]|h: Hello\",\"timestamp\":1787210339,\"id\":\"s19_4968\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Kvotheen-Hyjal:838:GUILD:|h[|cff0070ddKvotheen|r]|h: yooo\",\"timestamp\":1787210353,\"id\":\"s19_4969\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Behold, the Sunstrider Omnium...\",\"timestamp\":1787210373,\"id\":\"s19_4970\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Silent and dormant since the fall of King Anasterian. Until now...\",\"timestamp\":1787210377,\"id\":\"s19_4971\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Long ago, Dath'Remar Sunstrider forged the Omnium to decipher and study the various magical forces he encountered in the ancient world.\",\"timestamp\":1787210400,\"id\":\"s19_4972\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Omnial Echo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Omnial Echo says: Omnial d-d-damage detected. M-m-mirror Echo Imprint--Failure imminent.\",\"timestamp\":1787210410,\"id\":\"s19_4973\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: This living compendium allowed our people to observe and study the many forces of magic, some more restricted or forbidden than others.\",\"timestamp\":1787210411,\"id\":\"s19_4974\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Omnial Echo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Omnial Echo says: Omnial d-d-damage detected. M-m-mirror Echo Imprint--Failure imminent.\",\"timestamp\":1787210476,\"id\":\"s19_4975\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Image of Dar'Khan Drathir\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Image of Dar'Khan Drathir says: I will not be denied the knowledge within any longer--the Void Magicule is mine!\",\"timestamp\":1787210481,\"id\":\"s19_4976\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Whether it was arcane, fel, or even Light or... Void, Dath'Remar created the Omnium to preserve knowledge within.\",\"timestamp\":1787210513,\"id\":\"s19_4977\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: But when King Anasterian fell, the Omnium shut down--not even Kael'thas knew how to revive it.\",\"timestamp\":1787210527,\"id\":\"s19_4978\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Omnial Echo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Omnial Echo says: Unauthorized Magister detected. Sunstrider security ward engaged.\",\"timestamp\":1787210533,\"id\":\"s19_4979\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Image of Dath'Remar Sunstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Image of Dath'Remar Sunstrider says: The limitless pursuit of knowledge is not for the unworthy!\",\"timestamp\":1787210537,\"id\":\"s19_4980\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: So why is it active now? And what's causing it to malfunction? Do you think Kael'thas--\",\"timestamp\":1787210542,\"id\":\"s19_4981\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Damaged it? No. Apart from the stench of fel, the Omnium was still silent when found in his possessions.\",\"timestamp\":1787210552,\"id\":\"s19_4982\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx150\",\"timestamp\":1787210561,\"id\":\"s19_4983\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Omnial Echo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Omnial Echo says: Sunstrider Key-Cipher not recognized. Mirror Echo Imprint engaged.\",\"timestamp\":1787210574,\"id\":\"s19_4984\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Image of Kael'thas Sunstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Image of Kael'thas Sunstrider says: Not recognized? I am a Sunstrider! The Omnium belongs to ME!\",\"timestamp\":1787210578,\"id\":\"s19_4985\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Then if it was still dormant when you recovered it, could it somehow have been damaged before the King was slain?\",\"timestamp\":1787210582,\"id\":\"s19_4986\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: The Omnium was well protected here in the Magisters' Terrace... until Silvermoon fell under attack.\",\"timestamp\":1787210591,\"id\":\"s19_4987\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx150\",\"timestamp\":1787210597,\"id\":\"s19_4988\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: There was much carnage that day, Rommath. Perhaps these anomalies can tell us more.\",\"timestamp\":1787210598,\"id\":\"s19_4989\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: If I can find the missing component Dar'Khan ripped from the Omnium, will you be able to recalibrate and stabilize it?\",\"timestamp\":1787210613,\"id\":\"s19_4990\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: I will. Belo'vir should have locked the Grand Magister's key-cipher in his study... well, now my study.\",\"timestamp\":1787210622,\"id\":\"s19_4991\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: His safeguards will need to be unraveled. I will meet our champion there.\",\"timestamp\":1787210630,\"id\":\"s19_4992\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: And I will search Dawnstar Spire to find the missing piece. Join me when you can, Kvotheen. And Rommath, good luck.\",\"timestamp\":1787210635,\"id\":\"s19_4993\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx100\",\"timestamp\":1787210817,\"id\":\"s19_4994\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: How many times must Dar'Khan's crimes haunt us? Be on your guard, champion. I sense... something.\",\"timestamp\":1787210819,\"id\":\"s19_4995\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260669::::::::90:263:::::::::|h[Colorless Pebbles]|h|r\",\"timestamp\":1787210847,\"id\":\"s19_4996\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:274036::::::::90:263:::::::::|h[Void Magicule]|h|r\",\"timestamp\":1787210847,\"id\":\"s19_4997\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Dar'Khan must've hidden this even from his master. I can't help but wonder what secrets he gleaned from it...\",\"timestamp\":1787210848,\"id\":\"s19_4998\"}]",
["endTimestamp"] = 1787210848,
},
},
}
