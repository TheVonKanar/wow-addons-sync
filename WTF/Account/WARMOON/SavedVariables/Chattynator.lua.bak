},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Brakko says: And sporegliders are near pool. Can make go splish if we fight on way!",
["timestamp"] = 1772659475,
["id"] = "s3_2761",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
