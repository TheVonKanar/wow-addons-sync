},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hagar says: Some meddlesome miscreants have spread acorns around the Cradle. Clean them up, won't you?",
["id"] = "s21_2936",
["timestamp"] = 1787605916,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Hagar",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Hagar says: Lightbloom spores are spilling out of The Blinding Bloom. Get rid of them before they spread.",
["id"] = "s21_2937",
["timestamp"] = 1787605975,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
