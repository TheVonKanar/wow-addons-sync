},
["text"] = "|Hchannel:PARTY|h[Party]|h |Hplayer:Kvotheen-Hyjal:603:PARTY:|h[|cff0070ddKvotheen|r]|h: heyo",
["timestamp"] = 1787694135,
["id"] = "s21_3048",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Vorrik",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Vorrik says: This temple is the resting place of Sethraliss, a powerful loa that protected my people from destruction long ago.",
["timestamp"] = 1787694163,
["id"] = "s21_3049",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "MagharOrc",
["name"] = "Bloodlùst-Draenor",
["sex"] = 3,
},
["event"] = "CHAT_MSG_PARTY_LEADER",
["type"] = "PARTY_LEADER",
},
["color"] = {
["r"] = 0.4627451300621033,
["g"] = 0.7843137979507446,
["b"] = 1,
},
["text"] = "|Hchannel:PARTY|h[Party Leader]|h |Hplayer:Bloodlùst-Draenor:609:PARTY:|h[|cff0070ddBloodlùst-Draenor|r]|h: re enter if the dungeon is in progress",
["timestamp"] = 1787694177,
["id"] = "s21_3050",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Vorrik",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Vorrik says: She sacrificed herself to stop Mythrax... but with her death, the jungles of Vol'dun withered to sand.",
["timestamp"] = 1787694178,
["id"] = "s21_3051",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Vorrik",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Vorrik says: The time of her rebirth has passed, and now I fear something is preventing her from returning.",
["timestamp"] = 1787694192,
["id"] = "s21_3052",
},
