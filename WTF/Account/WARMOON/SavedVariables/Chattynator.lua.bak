},
["text"] = "You receive loot: |cnIQ3:|Hitem:236949::::::::81:263:::::::::|h[Mote of Light]|h|rx2",
["timestamp"] = 1772214836,
["id"] = "s0_2915",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
