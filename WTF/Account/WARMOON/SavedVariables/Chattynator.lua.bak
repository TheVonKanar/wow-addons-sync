},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Voltface-Dalaran:660:GUILD:|h[|cffa330c9Voltface|r]|h: cooucou",
["id"] = "s20_3148",
["timestamp"] = 1787244147,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Maella",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Riftblade Maella says: Allari, you and Leona establish a perimeter. Belath, scout ahead with Baraat and the others.",
["id"] = "s20_3149",
["timestamp"] = 1787244165,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["race"] = "Human",
["class"] = "PALADIN",
