{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ranger Captain Lilatha",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ranger Captain Lilatha says: The shal'dorei have joined our fight against the naga, but their constructs are wavering! Gather harvested arcane energy and help bolster their defenses!",
["timestamp"] = 1787222956,
["id"] = "s20_2731",
},
