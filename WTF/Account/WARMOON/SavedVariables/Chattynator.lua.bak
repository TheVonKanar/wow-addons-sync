:{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260671::::::::82:263:::::::::|h[Oversized Gland]|h|r\",\"timestamp\":1772238081,\"id\":\"s0_3553\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 1 Gold, 43 Silver, 87 Copper (+2 Silver, 87 Copper)\",\"timestamp\":1772238115,\"id\":\"s0_3554\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: The soothing sounds of my harp brought Vereesa joy beyond measure. I'll need that relic.\",\"timestamp\":1772238121,\"id\":\"s0_3555\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260666::::::::82:263:::::::::|h[Earthy Mushroom]|h|r\",\"timestamp\":1772238186,\"id\":\"s0_3556\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260665::::::::82:263:::::::::|h[Sizable Tusk]|h|r\",\"timestamp\":1772238216,\"id\":\"s0_3557\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Well now--that dragonhawk seems to have stolen my harp. She won't let you close without a fight.\",\"timestamp\":1772238228,\"id\":\"s0_3558\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Beautiful! She reminds me of Vereesa. My sister was also ferocity itself if her family was threatened.\",\"timestamp\":1772238303,\"id\":\"s0_3559\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 10 Gold, 48 Silver, 12 Copper\",\"timestamp\":1772238307,\"id\":\"s0_3560\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Come, we have one more relic to find.\",\"timestamp\":1772238312,\"id\":\"s0_3561\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 59 Silver, 94 Copper (+1 Silver, 19 Copper)\",\"timestamp\":1772238359,\"id\":\"s0_3562\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Alleria hunted the Old Horde with a ferocity bordering on obsession.\",\"timestamp\":1772238421,\"id\":\"s0_3563\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: For good reason--they took my life, savaged our home.\",\"timestamp\":1772238428,\"id\":\"s0_3564\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: One of Alleria's scouting maps is within. It seems to have called on the ghosts of vengeance past. We'll need that map from them.\",\"timestamp\":1772238435,\"id\":\"s0_3565\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260660::::::::82:263:::::::::|h[Putrid Mushroom Spores]|h|r\",\"timestamp\":1772238516,\"id\":\"s0_3566\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260660::::::::82:263:::::::::|h[Putrid Mushroom Spores]|h|rx2\",\"timestamp\":1772238569,\"id\":\"s0_3567\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Commander Kroluk\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Commander Kroluk yells: Honorless... scum...\",\"timestamp\":1772238683,\"id\":\"s0_3568\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 11 Gold, 32 Silver, 65 Copper (+22 Silver, 65 Copper)\",\"timestamp\":1772238685,\"id\":\"s0_3569\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: We've done it! One last task remains.\",\"timestamp\":1772238689,\"id\":\"s0_3570\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Austin Huxworth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Austin Huxworth says: We can use this to continue.\",\"timestamp\":1772238691,\"id\":\"s0_3571\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"|Hplayer:Austin Huxworth|h[Austin Huxworth]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"timestamp\":1772238691,\"id\":\"s0_3572\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: I'll use these relics to return peace to the spire. Perhaps then my sisters will return to me.\",\"timestamp\":1772238704,\"id\":\"s0_3573\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: There! The restless heart that haunts us! Please, lay it to rest.\",\"timestamp\":1772238712,\"id\":\"s0_3574\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Restless Heart\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Restless Heart yells: At... last...\",\"timestamp\":1772238793,\"id\":\"s0_3575\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has 