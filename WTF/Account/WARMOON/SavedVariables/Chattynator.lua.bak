{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Aksem",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Aksem says: Welcome to the Cradle.",
["timestamp"] = 1772650426,
["id"] = "s2_4336",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Aksem",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Aksem says: I am Aksem, and I listen to the voice of the Cradle. I carry knowledge that is hidden to even most haranir.",
["timestamp"] = 1772650429,
["id"] = "s2_4337",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Aksem",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Aksem says: The goddess's memories have been shared with me, and I share them only with those who understand their importance.",
["timestamp"] = 1772650438,
["id"] = "s2_4338",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Aksem",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Aksem says: Continue to learn about the haranir and our history. I am interested to see if you, and perhaps another, are worthy of those memories.",
["timestamp"] = 1772650447,
["id"] = "s2_4339",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Magister Umbric says: The Terrace holds what we require to gain entry to the Voidstorm... the Cynosure of Twilight.",
["timestamp"] = 1772650584,
["id"] = "s2_4340",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
