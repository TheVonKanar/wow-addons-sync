["id"] = "s0_9",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Mystic Birdhat",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
