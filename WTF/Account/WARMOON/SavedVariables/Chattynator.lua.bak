},
["text"] = "You receive item: |cnIQ3:|Hitem:242747::::::::90:263:::::::::|h[Hearty Royal Roast]|h|r",
["timestamp"] = 1772656937,
["id"] = "s2_4957",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: Anguish seems a malleable force... Let us see what else it is capable of.",
["timestamp"] = 1772656959,
["id"] = "s2_4958",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: First, prepare the cleansing salts. This should protect our knight from the cruelest side effects of anguish.",
["timestamp"] = 1772656990,
["id"] = "s2_4959",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: Now, the vessel. We will amplify its potency. Place it here--carefully.",
["timestamp"] = 1772657000,
["id"] = "s2_4960",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: This power can be temperamental, but the reward is worth the risk!",
["timestamp"] = 1772657009,
["id"] = "s2_4961",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: The Void's touch is cleansed. These forces are potent... versatile... and their side effects appear... manageable.",
["timestamp"] = 1772657029,
["id"] = "s2_4962",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: The enchantments need refinement, but sacrifices must always be made in the name of progress!",
["timestamp"] = 1772657059,
["id"] = "s2_4963",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: Let's see what effects these anguish-wrought trinkets have conjured.",
["timestamp"] = 1772657071,
["id"] = "s2_4964",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: I expect a powerful vigor and vitality in those that wear them.",
["timestamp"] = 1772657079,
["id"] = "s2_4965",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Astalor Bloodsworn",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Astalor Bloodsworn says: K'aresh produced some of the deadliest predators in the cosmos. This is one of them.",
["timestamp"] = 1772657084,
["id"] = "s2_4966",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Blood Knight",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Blood Knight says: It's mine! You can't have it!",
["timestamp"] = 1772657113,
["id"] = "s2_4967",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Silvermoon Resident",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Silvermoon Resident says: The colors of our city are brighter, and the smells of food richer. It's magnificent!",
["timestamp"] = 1772657131,
["id"] = "s2_4968",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Blood Knight Adept",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Blood Knight Adept says: Everything was great... until I realized my training partner tried to steal my gemstone!",
["timestamp"] = 1772657145,
["id"] = "s2_4969",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Blood Knight Adept",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Blood Knight Adept says: Paranoia and lies! I know it was YOU who tried stealing MY brooch.",
["timestamp"] = 1772657150,
["id"] = "s2_4970",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
