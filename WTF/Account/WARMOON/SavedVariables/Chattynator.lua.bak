["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ0:|Hitem:260670::::::::80:263:::::::::|h[Bloody Broken Beak]|h|r",
["timestamp"] = 1772211998,
["id"] = "s0_2629",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
