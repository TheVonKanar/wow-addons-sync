rdedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3150:0|h[Midnight Alchemy Knowledge]|h|rx2\",\"id\":\"s13_4234\",\"timestamp\":1775633722},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:247725::::::::90:263:::::::::|h[Resourceful Rebar]|h|r\",\"id\":\"s13_4235\",\"timestamp\":1775633722},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:238511::::::::90:263::::1:38:13:::::|h[Void-Tempered Leather |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx5\",\"id\":\"s13_4236\",\"timestamp\":1775633722},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vereesa Windrunner says: I agree to this compact, though I will never forgive the Horde for what it has done.\",\"id\":\"s13_4237\",\"timestamp\":1775633806},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx10\",\"id\":\"s13_4238\",\"timestamp\":1775633807},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Aethas Sunreaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Archmage Aethas Sunreaver says: As I will never forgive the Alliance for purging us from Dalaran. Yet I, too, agree to this compact.\",\"id\":\"s13_4239\",\"timestamp\":1775633812},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: I trust--and hope--that things went well, Kvotheen.\",\"id\":\"s13_4240\",\"timestamp\":1775633842},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: We believe we can heal the Darkwell, and we would like you there when we do.\",\"id\":\"s13_4241\",\"timestamp\":1775633870},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: The others have gathered gifts from their home to help with the Darkwell. Please let them know we are ready for them.\",\"id\":\"s13_4242\",\"timestamp\":1775633972},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"First Arcanist Thalyssra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"First Arcanist Thalyssra says: The fruit of the Arcan'dor can cleanse all manner of magic. I'm certain it will do so here.\",\"id\":\"s13_4243\",\"timestamp\":1775633986},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: I know this is no small thing you offer us. Silvermoon owes you a debt of gratitude.\",\"id\":\"s13_4244\",\"timestamp\":1775634014},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"First Arcanist Thalyssra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"First Arcanist Thalyssra says: Nonsense, my love. That we have the fruit at all is in no small part thanks to the sin'dorei.\",\"id\":\"s13_4245\",\"timestamp\":1775634021},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vereesa Windrunner says: Aethas and I have agreed to bring Anasterian's crown. A symbolic gesture befitting the last king of Silvermoon.\",\"id\":\"s13_4246\",\"timestamp\":1775634025},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vereesa Windrunner says: Are you sure about this, Aethas? The crown has only just been returned to its home.\",\"id\":\"s13_4247\",\"timestamp\":1775634053},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Aethas Sunreaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Archmage Aethas Sunreaver says: I am. We cannot greet the future without saying farewell to the past.\",\"id\":\"s13_4248\",\"timestamp\":1775634060},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: Trust me, Rommath. This shard will regulate the Void energies within the well.\",\"id\":\"s13_4249\",\"timestamp\":1775634069},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: To allow the Void to remain at all... your calculations have to be perfect, Umbric.\",\"id\":\"s13_4250\",\"timestamp\":1775634099},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: Well then it's a good thing you're looking over my shoulder, isn't it?\",\"id\":\"s13_4251\",\"timestamp\":1775634105},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Shandris Feathermoon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Shandris Feathermoon says: We have brought the purifying waters of our moonwells. I hope it will help.\",\"id\":\"s13_4252\",\"timestamp\":1775634119},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Halduron Brightwing says: Thank you for coming. I know this was not an easy decision.\",\"id\":\"s13_4253\",\"timestamp\":1775634157},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Shandris Feathermoon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Shandris Feathermoon says: The right decision is seldom easy. A lesson that we must all take to heart.\",\"id\":\"s13_4254\",\"timestamp\":1775634161},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Unknown says: My soldiers are too accustomed to sparring with the Light. They need to learn the tricks of other martial traditions.\",\"id\":\"s13_4255\",\"timestamp\":1775634188},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: We stand here today because of you, champion. Let us put an end to this Darkwell.\",\"id\":\"s13_4256\",\"timestamp\":1775634200},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx10\",\"id\":\"s13_4257\",\"timestamp\":1775634211},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Rouxkhine-Ysondre\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Rouxkhine-Ysondre|h[|cffa330c9Rouxkhine-Ysondre|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1335-0A89F993:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4258\",\"timestamp\":1775634349},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Nightborne\",\"class\":\"PRIEST\",\"name\":\"Kälinaa-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kälinaa-Hyjal|h[|cffffffffKälinaa|r]|h has earned the achievement |cffffff00|Hachievement:42117:Player-1390-0B3AF47F:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[The War of Light and Shadow]|h|r!\",\"id\":\"s13_4259\",\"timestamp\":1775634355},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"playe