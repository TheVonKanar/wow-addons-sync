["text"] = "You receive loot: |cnIQ1:|Hitem:246399::::::::80:263:::::::::|h[Cultist Dagger]|h|r",
["timestamp"] = 1771526676,
["id"] = "s0_1181",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Gehl Harrowtongue",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Gehl Harrowtongue says: You. Acolyte. Haven't you finished your training? Where is your tabard?",
["timestamp"] = 1771526677,
["id"] = "s0_1182",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Gehl Harrowtongue",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Gehl Harrowtongue says: Prove yourself as one Xal'atath's faithful. Only then may you attend the initiation ceremony.",
["timestamp"] = 1771526704,
["id"] = "s0_1183",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Studious Voidcaster",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Studious Voidcaster says: With this fight, I'll prove myself to Xal'atath!",
["timestamp"] = 1771526731,
["id"] = "s0_1184",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Twilight's Blade Instructor",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Twilight's Blade Instructor says: For Xal'atath! For the Twilight's Blade!",
["timestamp"] = 1771526739,
["id"] = "s0_1185",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Restless Neophyte",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Restless Neophyte says: Excellent, a target to practice on!",
["timestamp"] = 1771526740,
["id"] = "s0_1186",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Studious Voidcaster",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Studious Voidcaster says: Prove you're worthy of being Twilight's Blade!",
["timestamp"] = 1771526746,
["id"] = "s0_1187",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Studious Voidcaster",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Studious Voidcaster says: Excellent, a target to practice on!",
["timestamp"] = 1771526750,
["id"] = "s0_1188",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Restless Neophyte",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Restless Neophyte says: I won't let you win!",
["timestamp"] = 1771526754,
["id"] = "s0_1189",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Restless Neophyte",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Restless Neophyte says: We fight for Xal'atath!",
["timestamp"] = 1771526758,
["id"] = "s0_1190",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["event"] = "CHAT_MSG_MONEY",
["type"] = "MONEY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0,
},
["text"] = "You loot 5 Gold, 23 Silver, 53 Copper (+10 Silver, 46 Copper)",
["timestamp"] = 1771526762,
["id"] = "s0_1191",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Studious Voidcaster",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Studious Voidcaster says: I've had enough practice. You'll be my first sacrifice!",
["timestamp"] = 1771526763,
["id"] = "s0_1192",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Gehl Harrowtongue",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Gehl Harrowtongue says: You appear to be ready for your initiation now, fledgling. This way.",
["timestamp"] = 1771526792,
["id"] = "s0_1193",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Gehl Harrowtongue",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Gehl Harrowtongue says: Take heed of Mor'duun's speech. Our leader's words have set many cultists' hearts afire. I'm sure they will yours as well.",
["timestamp"] = 1771526808,
["id"] = "s0_1194",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Projection of Mor'duun",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Projection of Mor'duun says: We are the Twilight's Blade. The void-black dagger Xal'atath wields against Azeroth.",
["timestamp"] = 1771526835,
["id"] = "s0_1195",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ1:|Hitem:250465::::::::80:263:::::::::|h[Shadow Crystal]|h|r",
["timestamp"] = 1771526845,
["id"] = "s0_1196",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ1:|Hitem:250465::::::::80:263:::::::::|h[Shadow Crystal]|h|r",
["timestamp"] = 1771526847,
["id"] = "s0_1197",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Projection of Mor'duun",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Projection of Mor'duun says: We cut deep. Blood. Carnage. Chaos! This is what gains her favor. This is our glorious purpose!",
["timestamp"] = 1771526848,
["id"] = "s0_1198",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Projection of Mor'duun",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Projection of Mor'duun says: We shall strike at the heart of Azeroth and end this flawed world. For Xal'atath! For the Twilight's Blade!",
["timestamp"] = 1771526855,
["id"] = "s0_1199",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Magister Umbric says: Excellent work, Kvotheen. I believe we have learned enough here. Time to tear this camp apart.",
["timestamp"] = 1771526871,
["id"] = "s0_1200",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Magister Umbric says: I will meet you back at the basecamp. Our fight against this cult is only beginning.",
["timestamp"] = 1771526896,
["id"] = "s0_1201",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Gehl Harrowtongue",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Gehl Harrowtongue says: You still haven't learned. The Twilight's Blade will be your end!",
["timestamp"] = 1771526906,
["id"] = "s0_1202",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Eoin Dunwald",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Eoin Dunwald yells: Soul-less, ale-hatin', uncultured vagabonds! Ya better hide!",
["timestamp"] = 1771526909,
["id"] = "s0_1203",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Gehl Harrowtongue",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Gehl Harrowtongue says: I didn't... teach you that.",
["timestamp"] = 1771526914,
["id"] = "s0_1204",
},
{
