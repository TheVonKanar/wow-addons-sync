},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Vereesa Windrunner yells: Belo'ren! Please, we are defenders of the Sunwell, as are you!",
["id"] = "s17_4823",
["timestamp"] = 1777927362,
},
{
