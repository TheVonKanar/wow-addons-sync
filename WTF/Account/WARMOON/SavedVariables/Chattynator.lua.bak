\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260660::::::::90:263:::::::::|h[Putrid Mushroom Spores]|h|rx2\",\"timestamp\":1774303813,\"id\":\"s9_2635\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Our mother's bow meant everything to Sylvanas, once. I'll need it.\",\"timestamp\":1774303816,\"id\":\"s9_2636\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Latch\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Latch yells: Latch... sorry...\",\"timestamp\":1774303870,\"id\":\"s9_2637\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:251084::::::::90:263::23:5:12785:13439:6652:13577:12699:1:28:3025:::::|h[Whipcoil Sabatons]|h|r\",\"timestamp\":1774303871,\"id\":\"s9_2638\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 16 Gold, 67 Silver, 68 Copper (+33 Silver, 35 Copper)\",\"timestamp\":1774303872,\"id\":\"s9_2639\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lirath Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lirath Windrunner says: Sylvanas was sometimes vain, and loved to be admired, but she never wanted to be worshipped.\",\"timestamp\":1774303875,