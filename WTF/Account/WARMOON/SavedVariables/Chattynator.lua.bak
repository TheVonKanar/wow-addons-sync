},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Blessed Lightbringer says: I will fail neither the Light nor Turalyon! Press the attack!",
["id"] = "s0_3399",
["timestamp"] = 1772235496,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
