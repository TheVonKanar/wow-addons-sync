},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 1,
["r"] = 0.250980406999588,
},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Calwyn-KirinTor:90:GUILD:|h[|cff8788eeCalwyn|r]|h: GG",
["id"] = "s0_1066",
["timestamp"] = 1771505931,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Allari the Souleater",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Allari the Souleater says: The Illidari currently lack such expertise. We will train any void elves who wish to join us.",
["id"] = "s0_1067",
["timestamp"] = 1771505931,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Magister Umbric",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Magister Umbric says: I will direct those who are interested to you. May this exchange of knowledge benefit us all.",
["id"] = "s0_1068",
["timestamp"] = 1771505937,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Leona Darkstrider",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Leona Darkstrider says: My thanks, Allari. I look forward to walking the path ahead of me.",
["id"] = "s0_1069",
["timestamp"] = 1771505942,
},
