},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Decimus says: Strangely, I find myself wanting to know you better. And I want you to know me.",
["id"] = "s2_3150",
["timestamp"] = 1772576699,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
