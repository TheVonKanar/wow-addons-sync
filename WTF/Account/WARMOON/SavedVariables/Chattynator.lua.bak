["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive loot: |cnIQ0:|Hitem:260651::::::::90:263:::::::::|h[Lustrous Wildlife Pelt]|h|r",
["timestamp"] = 1786974367,
["id"] = "s18_4238",
},
