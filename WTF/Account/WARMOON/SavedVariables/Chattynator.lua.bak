["id"] = "s3_4569",
["timestamp"] = 1772819161,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Rehgar Earthfury",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Rehgar Earthfury says: No one stands in our way.",
["id"] = "s3_4570",
["timestamp"] = 1772819170,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
