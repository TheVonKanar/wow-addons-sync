["b"] = 0,
},
["text"] = "You loot 3 Gold, 72 Silver, 1 Copper (+7 Silver, 43 Copper)",
["timestamp"] = 1771526916,
["id"] = "s0_1205",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Eoin Dunwald",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
