["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Orn'shan says: I failed everyone, myself most of all, yet you stepped in and made it right. Thank you.",
["timestamp"] = 1772658272,
["id"] = "s3_2615",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
