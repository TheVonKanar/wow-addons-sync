t\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3392:0|h[Remnant of Anguish]|h|rx200\",\"id\":\"s7_3362\",\"timestamp\":1773833805},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:262936::::::::90:263::11::2:9:90:28:5223:::::|h[Preyseeker's Veteran Sack]|h|r\",\"id\":\"s7_3363\",\"timestamp\":1773833809},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:62154:Player-1390-09230B89:1:3:18:26:4294967295:4294967295:4294967295:4294967295|h[Prey: A Different Kind of Void (Hard)]|h|r!\",\"id\":\"s7_3364\",\"timestamp\":1773833810},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:62154:Player-1390-09230B89:1:3:18:26:4294967295:4294967295:4294967295:4294967295|h[Prey: A Different Kind of Void (Hard)]|h|r!\",\"id\":\"s7_3365\",\"timestamp\":1773833810},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: The sheer power... Perhaps the ren'dorei are onto something after all.\",\"id\":\"s7_3366\",\"timestamp\":1773833810},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3341:0|h[Veteran Dawncrest]|h|rx10\",\"id\":\"s7_3367\",\"timestamp\":1773833810},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"WARLOCK\",\"name\":\"Reavv-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Reavv-Hyjal|h[|cff8788eeReavv|r]|h has earned the achievement |cffffff00|Hachievement:62154:Player-1390-0D49744A:1:3:18:26:4294967295:4294967295:4294967295:4294967295|h[Prey: A Different Kind of Void (Hard)]|h|r!\",\"id\":\"s7_3368\",\"timestamp\":1773833812},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Just a minor setback.\",\"id\":\"s7_3369\",\"timestamp\":1773833842},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Blood Knight Adept\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Blood Knight Adept says: My head... and heart...\",\"id\":\"s7_3370\",\"timestamp\":1773833961},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Do not bore me with your details... The field work is your responsibility.\",\"id\":\"s7_3371\",\"timestamp\":1773834003},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"HUNTER\",\"name\":\"Amëy-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Amëy-Hyjal|h[|cffaad372Amëy|r]|h has earned the achievement |cffffff00|Hachievement:62161:Player-1390-0C9D1DAC:1:3:18:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Outsmarting the Schemers (Hard)]|h|r!\",\"id\":\"s7_3372\",\"timestamp\":1773834010},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Besides, any anguish spilt in the city can be recovered all the same.\",\"id\":\"s7_3373\",\"timestamp\":1773834010},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"MONK\",\"name\":\"Momet-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Momet-Hyjal|h[|cff00ff98Momet|r]|h has earned the achievement |cffffff00|Hachievement:62161:Player-1390-0BC61680:1:3:18:26:4294967295:4294967295:4294967295:4294967295|h[Prey: Outsmarting the Schemers (Hard)]|h|r!\",\"id\":\"s7_3374\",\"timestamp\":1773834014},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Come to my chambers below. I will relieve you of the burden of hosting so much anguish.\",\"id\":\"s7_3375\",\"timestamp\":1773834015},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: There are those who would look down upon us, champion--who would turn their noses at the blood we have spilled.\",\"id\":\"s7_3376\",\"timestamp\":1773834043},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: But from that blood we have drawn power. The power to defend our city. The power to annihilate our foes.\",\"id\":\"s7_3377\",\"timestamp\":1773834064},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Just as Silvermoon was not rebuilt in a day, so too will the consequences of our work here unfold over the years to come. They might not be fully felt today, or tomorrow...\",\"id\":\"s7_3378\",\"timestamp\":1773834073},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: ...but when they are, all of Azeroth will come to fear the might and determination of the blood elves.\",\"id\":\"s7_3379\",\"timestamp\":1773834087},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: You are the teeth of my predation--a hero of the people!\",\"id\":\"s7_3380\",\"timestamp\":1773834116},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: I am not one to dismiss the power of the trolls. Let us harness it.\",\"id\":\"s7_3381\",\"timestamp\":1773834238},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ1:|Hcurrency:3316:0|h[Voidlight Marl]|h|rx120\",\"id\":\"s7_3382\",\"timestamp\":1773834275},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PRIEST\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Jamelmoignon-Hyjal:769:GUILD:|h[|cffffffffJamelmoignon|r]|h: io\",\"id\":\"s7_3383\",\"timestamp\":1773834291},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MAGE\",\"name\":\"Whitecetra-MarécagedeZangar\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Whitecetra-MarécagedeZangar:770:GUILD:|h[|cff3fc7ebWhitecetra|r]|h: salut\",\"id\":\"s7_3384\",\"timestamp\":1773834305},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Your |cnIQ4:|Hitem:250256::::::::90:263::23:4:12779:13439:6652:12699:1:28:3025:::::|h[Heart of Wind]|h|r was changed to |cnIQ4:|Hitem:250256::::::::90:263::23:4:13439:6652:12699:12780:1:28:3025:::::|h[Heart of Wind]|h|r.\",\"id\":\"s7_3385\",\"timestamp\":1773834317},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Your |cnIQ