["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kurdran Wildhammer says: Odd! I dinnae have the slightest idea what that's about.",
["id"] = "s2_3629",
["timestamp"] = 1772581890,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
