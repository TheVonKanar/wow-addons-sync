["timestamp"] = 1772216884,
["id"] = "s0_3011",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Arator says: Kvotheen, find Umbric. I'll keep guard here.",
["timestamp"] = 1772216967,
["id"] = "s0_3012",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
