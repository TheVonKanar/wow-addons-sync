},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: This is amazing! We'll have enough in no time.",
["timestamp"] = 1772660726,
["id"] = "s3_2941",
},
