},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Jan'mo the Loud says: Ladies and gentlemons, it is time once again to bear witness to the game of kings and the king of games: headball!",
