":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Dawnblaze says: It is amusing to receive a lecture from someone who accepts gold for murder.\",\"id\":\"s0_3946\",\"timestamp\":1772275734},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Jaeth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jaeth says: Your head's worth gold too. Remember that.\",\"id\":\"s0_3947\",\"timestamp\":1772275742},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Dawnblaze\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Magister Dawnblaze smiles and sips her wine.\",\"id\":\"s0_3948\",\"timestamp\":1772275753},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Valeera Sanguinar begins making a campfire.\",\"id\":\"s0_3949\",\"timestamp\":1772275769},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Sitch Lowdown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sitch Lowdown says: Trust me, this is the good stuff!\",\"id\":\"s0_3950\",\"timestamp\":1772275773},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Bloomkeeper Thornflare\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Bloomkeeper Thornflare says: Your aid is much appreciated!\",\"id\":\"s0_3951\",\"timestamp\":1772275777},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Sitch Lowdown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016