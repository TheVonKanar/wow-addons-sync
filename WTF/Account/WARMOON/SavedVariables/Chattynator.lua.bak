},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Tuktuk says: Hey, want to go back to pool? Is nice. Is warm. Is soggy!",
["timestamp"] = 1772659471,
["id"] = "s3_2760",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
