\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3345:0|h[Hero Dawncrest]|h|rx20\",\"id\":\"s13_4170\",\"timestamp\":1775632706},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3150:0|h[Midnight Alchemy Knowledge]|h|rx1\",\"id\":\"s13_4171\",\"timestamp\":1775632708},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3256:0|h[Artisan Alchemist's Moxie]|h|rx5\",\"id\":\"s13_4172\",\"timestamp\":1775632708},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3154:0|h[Midnight Herbalism Knowledge]|h|rx1\",\"id\":\"s13_4173\",\"timestamp\":1775632716},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3260:0|h[Artisan Herbalist's Moxie]|h|rx5\",\"id\":\"s13_4174\",\"timestamp\":1775632716},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mystic Birdhat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Mystic Birdhat says: There is nothing in all Pandaria that can stay the rampage of the Grand Expedition Yak. Pray you never see it.\",\"id\":\"s13_4175\",\"timestamp\":1775632794},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Camberon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Camberon says: I'm far too busy to keep up with your training, but you're welcome to use my cauldron over there.\",\"id\":\"s13_4176\",\"timestamp\":1775632812},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You create: |cnIQ1:|Hitem:241307::::::::90:263::::2:38:13:40:3253:::::|h[Refreshing Serum |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx5.\",\"id\":\"s13_4177\",\"timestamp\":1775632878},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3256:0|h[Artisan Alchemist's Moxie]|h|rx30\",\"id\":\"s13_4178\",\"timestamp\":1775632896},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:263462::::::::90:263:::::::::|h[Thalassian Herbalist's Notes]|h|r\",\"id\":\"s13_4179\",\"timestamp\":1775632934},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3154:0|h[Midnight Herbalism Knowledge]|h|rx3\",\"id\":\"s13_4180\",\"timestamp\":1775632940},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3260:0|h[Artisan Herbalist's Moxie]|h|rx15\",\"id\":\"s13_4181\",\"timestamp\":1775632940},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:263454::::::::90:263:::::::::|h[Thalassian Alchemist's Notebook]|h|r\",\"id\":\"s13_4182\",\"timestamp\":1775632953},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3256:0|h[Artisan Alchemist's Moxie]|h|rx5\",\"id\":\"s13_4183\",\"timestamp\":1775632958},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3150:0|h[Midnight Alchemy Knowledge]|h|rx1\",\"id\":\"s13_4184\",\"timestamp\":1775632958},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Saucifflard-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Saucifflard-Hyjal|h[|cff0070ddSaucifflard|r]|h has earned the achievement |cffffff00|Hachievement:61679:Player-1390-0BBC7B2A:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Epic]|h|r!\",\"id\":\"s13_4185\",\"timestamp\":1775633054},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Despite our long history of animosity, we elves have proven that together we are greater than our grievances.\",\"id\":\"s13_4186\",\"timestamp\":1775633255},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Perhaps the rifts between us will never fully heal. But we must at least attempt to bridge them.\",\"id\":\"s13_4187\",\"timestamp\":1775633264},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Let's get this over with. Umbric, in light of all you have done for Silvermoon, I hereby return your research materials.\",\"id\":\"s13_4188\",\"timestamp\":1775633345},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: It's Magister Umbric, actually. But it's good to be acknowledged.\",\"id\":\"s13_4189\",\"timestamp\":1775633357},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: My old workspace! Complete with nullification runes and enchantments.\",\"id\":\"s13_4190\",\"timestamp\":1775633363},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: My old harmonial... You kept it?\",\"id\":\"s13_4191\",\"timestamp\":1775633369},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: That desk was a menace. It kept eating magic items we left on it.\",\"id\":\"s13_4192\",\"timestamp\":1775633370},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Well... a lot of work went into it and you did earn it.\",\"id\":\"s13_4193\",\"timestamp\":1775633375},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: Wait... Does this mean what I think it means?\",\"id\":\"s13_4194\",\"timestamp\":1775633387},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: To show our gratitude for your aid, we... I... am awarding you this property as an embassy for the ren'dorei.\",\"id\":\"s13_4195\",\"timestamp\":1775633412},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3391:0|h[Adventurer Dawncrest]|h|rx10\",\"id\":\"s13_4196\",\"timestamp\":1775633413},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: You are actually letting us back in the city regularly? Willingly?\",\"id\":\"s13_4197\",\"timestamp\":1775633422},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: I still do not approve of your research into the Void.\",\"id\":\"s13_4198\",\"timestamp\":1775633429},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: You gave us our equipment back. That is literally you approving of what we do. You approve of me.\",\"id\":\"s13_4199\",\"timestamp\":1775633433},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: I regret this already.\",\"id\":\"s13_4200\",\"timestamp\":1775633442},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: This creature can be rather... temperamental.\",\"id\":\"s13_4201\",\"timestamp\":1775633497},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Vilidøns-Dalaran\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Vilidøns-Dalaran:437:GUILD:|h[|cffa330c9Vilidøns|r]|h: yooo\",\"id\":\"s13_4202\",\"timestamp\":1775633532},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Worgen\",\"class\":\"MAGE\",\"name\":\"Pauleau-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Pauleau-Dalaran|h[|cff3fc7ebPauleau-Dalaran|r]|h a accompli le haut fait |cffffff00|Hachievement:42768:Player-1621-0BA6CEE5:1:4:8:26:4294967295:4294967295:4294967295:4294967295|h[Champion of the Dawn]|h|r !\",\"id\":\"s13_4203\",\"timestamp\":1775633540},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Kvotheen-Hyjal:441:GUILD:|h[|cff0070ddKvotheen|r]|h: yooooo\",\"id\":\"s13_4204\",\"timestamp\":1775633546},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Aethas Sunreaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Archmage Aethas Sunreaver says: Vereesa and I have decided that our people can no longer afford to fight each other.\",\"id\":\"s13_4205\",\"timestamp\":1775633564},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vereesa Windrunner says: Not when greater threats lurk outside our walls.\",\"id\":\"s13_4206\",\"timestamp\":1775633571},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PRIEST\",\"name\":\"Hèlio-Archimonde\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hèlio-Archimonde:454:GUILD:|h[|cffffffffHèlio|r]|h: coucou\",\"id\":\"s13_4207\",\"timestamp\":1775633575},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"PRIEST\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Jamelmoignon-Hyjal:455:GUILD:|h[|cffffffffJamelmoignon|r]|h: io\",\"id\":\"s13_4208\",\"timestamp\":1775633576},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vereesa Windrunner says: The Silver Covenant was formed to oppose the Horde. Our enmity toward them could not be quelled.\",\"id\":\"s13_4209\",\"timestamp\":1775633599},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Vilidøns-Dalaran\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Vilidøns-Dalaran:463:GUILD:|h[|cffa330c9Vilidøns|r]|h: jambes bis on est content\",\"id\":\"s13_4210\",\"timestamp\":1775633610},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"PRIEST\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Jamelmoignon-Hyjal:471:GUILD:|h[|cffffffffJamelmoignon|r]|h: ptdr jamais vu ça \",\"id\":\"s13_4211\",\"timestamp\":1775633631},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Aethas Sunreaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Archmage Aethas Sunreaver says: The Sunreavers sought to reclaim our place in the Kirin Tor. We never meant to become a political tool.\",\"id\":\"s13_4212\",\"timestamp\":1775633631},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Archmage Aethas Sunreaver\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Archmage Aethas Sunreaver says: Let this flame remind us of our true calling: to share knowledge and power against a common foe.\",\"id\":\"s13_4213\",\"timestamp\":1775633638},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mystic Birdhat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Mystic Birdhat says: Those yaungol have straight swords. Straight. Swords.\",\"id\":\"s13_4214\",\"timestamp\":1775633642},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Dracthyr\",\"class\":\"PRIEST\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Jamelmoignon-Hyjal:477:GUILD:|h[|cffffffffJamelmoignon|r]|h: mon meilleur item du chest : le bijou nm des dragons\",\"id\":\"s13_4215\",\"timestamp\":1775633643},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Vilidøns-Dalaran\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Vilidøns-Dalaran:480:GUILD:|h[|cffa330c9Vilidøns|r]|h: |cnIQ4:|Hitem:49817:7935:::::::90:1480::35:5:12801:13440:6652:13577:12699::::::|h[Jambières velues en cuir de wyrm]|h|r\",\"id\":\"s13_4216\",\"timestamp\":1775633650},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:137287::::::::90:263:::::::::|h[Glyph of the Spectral Raptor]|h|r\",\"id\":\"s13_4217\",\"timestamp\":1775633712},{\"recordedBy\":\"Kvot