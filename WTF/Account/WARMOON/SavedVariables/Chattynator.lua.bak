81},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: One more, and the barrier should lose its power.\",\"id\":\"s18_4934\",\"timestamp\":1787070484},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: No way across... we'll have to jump down.\",\"id\":\"s18_4935\",\"timestamp\":1787070492},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Be on guard. It looks like the Children of Ula'tek have been throwing their sacrifices down there.\",\"id\":\"s18_4936\",\"timestamp\":1787070499},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: That hydra might be expecting another meal.\",\"id\":\"s18_4937\",\"timestamp\":1787070506},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Thank the Light you were not devoured.\",\"id\":\"s18_4938\",\"timestamp\":1787070564},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 11 Gold, 35 Silver, 73 Copper (+22 Silver, 71 Copper)\",\"id\":\"s18_4939\",\"timestamp\":1787070565},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: There's a path to the altar through these snake tunnels. Come with me.\",\"id\":\"s18_4940\",\"timestamp\":1787070568},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: Ula'tek's influence is evolving these creatures.\",\"id\":\"s18_4941\",\"timestamp\":1787070574},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: The Children of Ula'tek infuse these eggs with her venom to transform them into these abominations.\",\"id\":\"s18_4942\",\"timestamp\":1787070577},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: They even consume each other when given the chance.\",\"id\":\"s18_4943\",\"timestamp\":1787070582},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:274951::::::::90:263:::::::::|h[Corroded Scale]|h|r\",\"id\":\"s18_4944\",\"timestamp\":1787070662},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::90:263:::::::::|h[Practically