recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: The Sunwell holds the Voidstorm at bay for now. But its current state cannot be sustained forever.\",\"timestamp\":1772179812,\"id\":\"s0_2498\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"ROGUE\",\"race\":\"BloodElf\",\"name\":\"Azuurea-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Azuurea-Hyjal|h[|cfffff468Azuurea|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-09EC8D99:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772179815,\"id\":\"s0_2499\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Halduron Brightwing says: And there's no telling how it could be affecting the rest of Eversong, especially the Lightbloom. We need an alternative course of action.\",\"timestamp\":1772179818,\"id\":\"s0_2500\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"Dwarf\",\"name\":\"Ascha-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Ascha-Hyjal|h[|cff0070ddAscha|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0CAEB334:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772179824,\"id\":\"s0_2501\"}]",
["endTimestamp"] = 1772179824,
},
{
["startTimestamp"] = 1772179826,
["data"] = "[{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: We ren'dorei can aid you in finding one. Grant us entry into Silvermoon--\",\"timestamp\":1772179826,\"id\":\"s0_2502\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Grand Magister Rommath says: Absolutely not! Your mere presence would risk defiling the Sunwell with Void magic.\",\"timestamp\":1772179831,\"id\":\"s0_2503\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Goblin\",\"name\":\"Trizzik-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Trizzik-Hyjal|h[|cffc69b6dTrizzik|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-06DC6FD9:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772179834,\"id\":\"s0_2504\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Magister Umbric says: Then it seems we have nothing more to discuss. I'll continue my research in Tranquillien, should you choose to see reason.\",\"timestamp\":1772179838,\"id\":\"s0_2505\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"NightElf\",\"name\":\"Tacoum-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Tacoum-Hyjal|h[|cffff7c0aTacoum|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0CC7846B:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772179847,\"id\":\"s0_2506\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"High Exarch Turalyon says: The Grand Magister is right about one thing--protecting the Sunwell is our top priority. The Vanguard of the Light will see to its defense.\",\"timestamp\":1772179848,\"id\":\"s0_2507\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Dwarf\",\"name\":\"Démenos-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Démenos-Hyjal|h[|cffffffffDémenos|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0CAEB63C:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772179853,\"id\":\"s0_2508\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: Your aid was timely and welcome, Turalyon. But remember that Silvermoon and the Sunwell belong to the sin'dorei. You are guests in our fair city.\",\"timestamp\":1772179858,\"id\":\"s0_2509\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"High Exarch Turalyon says: Guests, allies, and saviors, Lor'themar. Rest assured that we will guard your city and your people with the full strength of the Light.\",\"timestamp\":1772179868,\"id\":\"s0_2510\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"DarkIronDwarf\",\"name\":\"Choysard-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Choysard-Hyjal|h[|cff0070ddChoysard|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0C0B74E4:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772179886,\"id\":\"s0_2511\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"VoidElf\",\"name\":\"Sùntzù-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Sùntzù-Hyjal|h[|cffa330c9Sùntzù|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0D5E4D03:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"timestamp\":1772179897,\"id\":\"s0_2512\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lor'themar Theron says: I'll speak to the Vanguard while you get the other matters settled.\",\"timestamp\":1772179907,\"id\":\"s0_2513\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Voltarynn-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voltarynn-Dalaran:70:GUILD:|h[|cff33937fVoltarynn|r]|h: re \",\"timestamp\":1772180012,\"id\":\"s0_2514\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"EarthenDwarf\",\"name\":\"Yapludruhm-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Yapludruhm-Hyjal:71:GUILD:|h[|cfff48cbaYapludruhm|r]|h: bonjour\",\"timestamp\":1772180015,\"id\":\"s0_2515\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"EarthenDwarf\",\"name\":\"Yapludruhm-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Yapludruhm-Hyjal:72:GUILD:|h[|cfff48cbaYapludruhm|r]|h: re\",\"timestamp\":1772180019,\"id\":\"s0_2516\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Kvotheen-Hyjal:73:GUILD:|h[|cff0070ddKvotheen|r]|h: yooo\",\"timestamp\":1772180026,\"id\":\"s0_2517\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Øskytankul-Archimonde:80:GUILD:|h[|cff00ff98Øskytankul|r]|h: Yop !\",\"timestamp\":1772180115,\"id\":\"s0_2518\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Øskytankul-Archimonde:82:GUILD:|h[|cff00ff98Øskytankul|r]|h: re ! alors la nuit fut bonne Yapudrhum ?\",\"timestamp\":1772180127,\"id\":\"s0_2519\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"Dwarf\",\"name\":\"Dwalgo-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dwalgo-Hyjal:85:GUILD:|h[|cffaad372Dwalgo|r]|h: coucou\",\"timestamp\":1772180227,\"id\":\"s0_2520\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Øskytankul-Archimonde:86:GUILD:|h[|cff00ff98Øskytankul|r]|h: cocou\",\"timestamp\":1772180231,\"id\":\"s0_2521\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"Dwarf\",\"name\":\"Dwalgo-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dwalgo-Hyjal:87:GUILD:|h[|cffaad372Dwalgo|r]|h: ooui ,j'ai juste fais les quetes de départ jusque la capitale perso\",\"timestamp\":1772180247,\"id\":\"s0_2522\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Voltarynn-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voltarynn-Dalaran:88:GUILD:|h[|cff33937fVoltarynn|r]|h: pareil puis du farme compo\",\"timestamp\":1772180321,\"id\":\"s0_2523\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: You have already taken so many of my Blood Knights to empower the Sunwell! Quel'Thalas is largely undefended!\",\"id\":\"s0_2524\",\"timestamp\":1772180469},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: And I am telling you that it is still not enough. Only by the faith of our forces is the Sunwell holding back the Void.\",\"id\":\"s0_2525\",\"timestamp\":1772180477},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: The Sunwell must not fall.\",\"id\":\"s0_2526\",\"timestamp\":1772180485},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: Then make sure we have everything we need and keep enemies off our backs.\",\"id\":\"s0_2527\",\"timestamp\":1772180487},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: General, perhaps you could see to our forces at the Sunwell. I will discuss matters with the Regent Lord.\",\"id\":\"s0_2528\",\"timestamp\":1772180493},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: As you will it, High Exarch.\",\"id\":\"s0_2529\",\"timestamp\":1772180500},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"General Amias Bellamy says: Vanguard, collect every weapon not nailed to a wall and let's move out!\",\"id\":\"s0_2530\",\"timestamp\":1772180501},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ceera\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ceera says: The last I saw shadows descend on Quel'Danas, Arthas marched on our kingdom with his army of Scourge. Now another army marches in our streets, saying they're here for our protection... are you certain of that?\",\"id\":\"s0_2531\",\"timestamp\":1772180518},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magistrix Narinth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magistrix Narinth says: That burst of energy from the Sunwell--it was more powerful than any magic I've ever encountered, and I am well practiced. They say that army protects us, but I heard the surge was their doing! Do they even understand what they meddle with?\",\"id\":\"s0_2532\",\"timestamp\":1772180555},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Innkeeper Jovia\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Innkeeper Jovia says: With all that has happened, that... utterly mad vortex of shadow in the sky, guests are leaving in droves. If I weren't overseeing this place, I'm not so certain I'd still be here myself. If you wish a room, it is yours.\",\"id\":\"s0_2533\",\"timestamp\":1772180595},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"b\":1,\"g\":0.3333333432674408,\"r\":0.3333333432674408},\"text\":\"You have gained the Midnight Cooking skill.\",\"id\":\"s0_2534\",\"timestamp\":1772180619},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Skymaster Skyles\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Skymaster Skyles says: That surge from the Sunwell set off the dragonhawks--they know when there's danger. I've never seen them this unnerved. If the animals are this affected, what about the rest of Eversong?\",\"id\":\"s0_2535\",\"timestamp\":1772180653},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Of course--the Reliquary will lend aid wherever it's needed. Let me know if you're interested as well.\",\"id\":\"s0_2536\",\"timestamp\":1772180685},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magistrix Nizara\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magistrix Nizara says: Ah. Well, if you ever need a reprieve from the bustle of our visiting... friends, seek the red banners around the city. We'll keep the Alliance out of those areas.\",\"id\":\"s0_2537\",\"timestamp\":1772180741},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: You're needed in Fairbreeze, champion. A problem with the Lightbloom.\",\"id\":\"s0_2538\",\"timestamp\":1772180772},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Gnome\",\"class\":\"MAGE\",\"name\":\"Tendô-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Tendô-Hyjal|h[|cff3fc7ebTendô|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0755020C:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2539\",\"timestamp\":1772180779},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"MONK\",\"name\":\"Skilzorr-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Skilzorr-Hyjal|h[|cff00ff98Skilzorr|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0CC2FB5F:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2540\",\"timestamp\":1772180783},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Jeeves\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jeeves says: If you'll excuse me, I'm afraid I have other business I must attend to.  Please call on me again in the future.\",\"id\":\"s0_2541\",\"timestamp\":1772180812},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Khazir-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Khazir-Hyjal|h[|cfff48cbaKhazir|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0B36AE36:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2542\",\"timestamp\":1772180818},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"SHAMAN\",\"name\":\"Hopë-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Hopë-Hyjal|h[|cff0070ddHopë|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0D2BA85D:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2543\",\"timestamp\":1772180824},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:248044::::::::80:263::11:2:13573:6652:2:9:80:28:3085:::::|h[Reluctant Diplomat's Vambraces]|h|r\",\"id\":\"s0_2544\",\"timestamp\":1772180840},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:250352::::::::80:263:::::::::|h[Worn Supply Bag]|h|r\",\"id\":\"s0_2545\",\"timestamp\":1772180840},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:263231::::::::80:263::11::1:28:3085:::::|h[Silvermoon Curio Shelves]|h|r\",\"id\":\"s0_2546\",\"timestamp\":1772180840},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-09230B89:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2547\",\"timestamp\":1772180840},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-09230B89:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2548\",\"timestamp\":1772180840},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEATHKNIGHT\",\"name\":\"Mörkëv-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Mörkëv-Hyjal|h[|cffc41e3aMörkëv|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0CE031FA:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2549\",\"timestamp\":1772180849},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Grand Magister Rommath\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Grand Magister Rommath says: Use this arcane projector to keep us informed.\",\"id\":\"s0_2550\",\"timestamp\":1772180863},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Arator, you may be needed at the Sunwell.\",\"id\":\"s0_2551\",\"timestamp\":1772180871},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Arator says: This Lightbloom might actually be of use to the Vanguard. At the very least, I need to find out.\",\"id\":\"s0_2552\",\"timestamp\":1772180876},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"LightforgedDraenei\",\"class\":\"PALADIN\",\"name\":\"Lyiâ-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Lyiâ-Hyjal|h[|cfff48cbaLyiâ|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-1390-0D59293A:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s0_2553\",\"timestamp\":1772180877},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"ROGUE\",\"name\":\"Nélyax-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Nélyax-Hyjal|h[|cfffff468Nélyax|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0D5E59BB:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2554\",\"timestamp\":1772180879},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Draenei\",\"class\":\"PALADIN\",\"name\":\"Erêbe-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Erêbe-Hyjal|h[|cfff48cbaErêbe|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-1390-0D5F7DEE:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s0_2555\",\"timestamp\":1772180884},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Is everything all right, Lady Liadrin? You've said little since we arrived.\",\"id\":\"s0_2556\",\"timestamp\":1772180886},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: My apologies--my thoughts are with the Sunwell. I did not expect it to react with such... force.\",\"id\":\"s0_2557\",\"timestamp\":1772180891},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: You ask, and the Light provides. Need it be more complicated than that?\",\"id\":\"s0_2558\",\"timestamp\":1772180900},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: She speaks of the Sunwell, not the Light.\",\"id\":\"s0_2559\",\"timestamp\":1772180907},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Your fount was blessed by the heart of a naaru. It is one and the same.\",\"id\":\"s0_2560\",\"timestamp\":1772180911},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: I suggest you hold your tongue, High Exarch. That \\\"fount\\\" you so blithely pretend to understand predates the existence of human civilization.\",\"id\":\"s0_2561\",\"timestamp\":1772180916},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Pandaren\",\"class\":\"MONK\",\"name\":\"Wínstons-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Wínstons-Hyjal|h[|cff00ff98Wínstons|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-1390-0CAE2F95:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s0_2562\",\"timestamp\":1772180920},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Erzanà-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Erzanà-Hyjal|h[|cfff48cbaErzanà|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-1390-08673B08:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s0_2563\",\"timestamp\":1772180926},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: And in all that time, I have never heard of the Sunwell reacting with that kind of... aggression. Liadrin, what was that beam of light?\",\"id\":\"s0_2564\",\"timestamp\":1772180927},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Nectalol-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Nectalol-Hyjal|h[|cffa330c9Nectalol|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-1390-0B1D3046:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s0_2565\",\"timestamp\":1772180933},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: I wish I knew. It holds back the Void, yet I still wonder... if the Sunwell is capable of such power, what else will it do?\",\"id\":\"s0_2566\",\"timestamp\":1772180936},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"HUNTER\",\"name\":\"Nelhelel-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Nelhelel-Hyjal|h[|cffaad372Nelhelel|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-1390-0D4F2CEC:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s0_2567\",\"timestamp\":1772180946},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: That question worries me, Liadrin. Is it wrong for it to do so?\",\"id\":\"s0_2568\",\"timestamp\":1772180947},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Garadrood-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Garadrood-Hyjal|h[|cffff7c0aGaradrood|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0D13D139:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2569\",\"timestamp\":1772180952},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Jiilipal-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Jiilipal-Hyjal|h[|cfff48cbaJiilipal|r]|h has earned the achievement |cffffff00|Hachievement:41802:Player-1390-0CFAAF8A:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Eversong In Reprise]|h|r!\",\"id\":\"s0_2570\",\"timestamp\":1772180953},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: The effects of the Sunwell have never been malicious. It has blessed Eversong's forests with small groves of Lightbloom for years.\",\"id\":\"s0_2571\",\"timestamp\":1772180953},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Small at first, but Fairbreeze now reports a problem. If the Sunwell is aggressive, what of the Lightbloom?\",\"id\":\"s0_2572\",\"timestamp\":1772180963},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Diannase-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Diannase-Hyjal|h[|cffa330c9Diannase|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0BB98B75:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2573\",\"timestamp\":1772180963},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: These worries will lead you nowhere, Regent Lord. As long as the Vanguard maintains the connection to the Sunwell, the Light will see us through.\",\"id\":\"s0_2574\",\"timestamp\":1772180971},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"HUNTER\",\"name\":\"Fèlésh-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Fèlésh-Hyjal|h[|cffaad372Fèlésh|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0D5EAB77:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2575\",\"timestamp\":1772180973},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"High Exarch Turalyon says: Have faith. That is all that is needed from you.\",\"id\":\"s0_2576\",\"timestamp\":1772180981},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lor'themar Theron\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lor'themar Theron says: Perhaps you should save your words for when they are asked for, High Exarch. I suspect they would be better received.\",\"id\":\"s0_2577\",\"timestamp\":1772180986},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"PALADIN\",\"name\":\"Shayt-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Shayt-Hyjal|h[|cfff48cbaShayt|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0D35AA50:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2578\",\"timestamp\":1772181011},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Hygurashi-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Hygurashi-Hyjal|h[|cffa330c9Hygurashi|r]|h has earned the achievement |cffffff00|Hachievement:62273:Player-1390-0D0CD72F:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Echoes of Midnight]|h|r!\",\"id\":\"s0_2579\",\"timestamp\":1772181012},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"c