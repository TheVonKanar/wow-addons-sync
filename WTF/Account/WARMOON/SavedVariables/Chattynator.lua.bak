},
["text"] = "You receive item: |cnIQ2:|Hitem:237362::::::::90:263::::1:38:13:::::|h[Umbral Tin Ore |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2",
