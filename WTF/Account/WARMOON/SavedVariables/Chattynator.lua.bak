["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Rescued Civilian says: Thank you, Kvotheen. I had almost given up hope!",
["timestamp"] = 1772148263,
["id"] = "s0_2215",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
