},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lysikas says: I thought it best to avoid a panic.",
["timestamp"] = 1772580025,
["id"] = "s2_3481",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
