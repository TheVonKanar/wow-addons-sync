b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"L-N-0R the Recycler says: Just not... a... toaster.\",\"id\":\"s16_3492\",\"timestamp\":1776888254},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3392:0|h[Remnant of Anguish]|h|rx240\",\"id\":\"s16_3493\",\"timestamp\":1776888254},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3310:0|h[Coffer Key Shards]|h|rx58\",\"id\":\"s16_3494\",\"timestamp\":1776888258},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ4:|Hitem:262346::::::::90:263::11::2:9:90:28:5236:::::|h[Preyseeker's Champion Chest]|h|r\",\"id\":\"s16_3495\",\"timestamp\":1776888258},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Metal is no match for magic.\",\"id\":\"s16_3496\",\"timestamp\":1776888258},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3343:0|h[Champion Dawncrest]|h|rx10\",\"id\":\"s16_3497\",\"timestamp\":1776888259},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3345:0|h[Hero Dawncrest]|h|rx5\",\"id\":\"s16_3498\",\"timestamp\":1776888259},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: K'aresh produced some of the deadliest predators in the cosmos. This is one of them.\",\"id\":\"s16_3499\",\"timestamp\":1776888288},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hagar says: Some meddlesome miscreants have spread acorns around the Cradle. Clean them up, won't you?\",\"id\":\"s16_3500\",\"timestamp\":1776888324},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Of all the relics, Sky's Hope is perhaps the most mysterious. I look forward to what we uncover.\",\"id\":\"s16_3501\",\"timestamp\":1776888356},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:236770::::::::90:263::::1:38:13:::::|h[Sanguithorn |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx10\",\"id\":\"s16_3502\",\"timestamp\":1776888393},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Kill for me. Now!\",\"id\":\"s16_3503\",\"timestamp\":1776888393},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3392:0|h[Remnant of Anguish]|h|rx7\",\"id\":\"s16_3504\",\"timestamp\":1776888409},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: In the early days of Harandar, our sky was dark. The goddess was gone. The land was growing weak.\",\"id\":\"s16_3505\",\"timestamp\":1776888423},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: It was Awe'ohna who saw the damage the darkened sky was causing.\",\"id\":\"s16_3506\",\"timestamp\":1776888432},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Sânghr-Hyjal|h[|cff00ff98Sânghr|r]|h a accompli le haut fait |cffffff00|Hachievement:61796:Player-1390-0CD41AF9:1:4:22:26:4294967295:4294967295:4294967295:4294967295|h[Midnight: Journey's End (Season 1)]|h|r !\",\"id\":\"s16_3507\",\"timestamp\":1776888454},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Awe'ohna was the one who reached out to the rutaani and the fungarians. He asked if it was always this way.\",\"id\":\"s16_3508\",\"timestamp\":1776888456},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thornhat\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Thornhat says: If only we were all so brave and foolish.\",\"id\":\"s16_3509\",\"timestamp\":1776888493},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Tarati\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tarati says: Waste your time for all I care. The end comes for us all.\",\"id\":\"s16_3510\",\"timestamp\":1776888522},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: It was a time of fear, but Awe'ohna knew what he had to do. He took the shape of a local flying beast.\",\"id\":\"s16_3511\",\"timestamp\":1776888522},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Awe'ohna's goal was to reach the Cradle, where the goddess had once been. An impossible task.\",\"id\":\"s16_3512\",\"timestamp\":1776888536},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Haranir magic was made for hunting, and most borrow the shape of hunters.\",\"id\":\"s16_3513\",\"timestamp\":1776888543},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"Take to the skies and fly through the rings.\",\"id\":\"s16_3514\",\"timestamp\":1776888544},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Awe'ohna chose the shape of prey. A small, but tenacious creature of Harandar that could fly for long hours.\",\"id\":\"s16_3515\",\"timestamp\":1776888549},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: He flew, as hard and as far as he could, tiny wings beating faster than any.\",\"id\":\"s16_3516\",\"timestamp\":1776888558},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: If Awe'ohna reached the Cradle, or what he found, we will never know.\",\"id\":\"s16_3517\",\"timestamp\":1776888621},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: From the sky a stone fell, and the light returned. Awe'ohna was no more.\",\"id\":\"s16_3518\",\"timestamp\":1776888627},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: The rutaani and fungarian elders, in a rare act of cooperation, blessed the stone together and gave it to the haranir.\",\"id\":\"s16_3519\",\"timestamp\":1776888637},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zur'ashar Kassameh\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zur'ashar Kassameh says: Light bathed our realm again, the plants breathed, the roots prospered. And now we see the stone again.\",\"id\":\"s16_3520\",\"timestamp\":1776888650},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"As you step inside, drawn ever closer to hidden treasure, your Coffer Key Shards stir as if awakened by the promise of riches. They shimmer, then fuse together, becoming whole once more.\",\"id\":\"s16_3521\",\"timestamp\":1776888676},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ4:|Hcurrency:3028:0|h[Restored Coffer Key]|h|rx1\",\"id\":\"s16_3522\",\"timestamp\":1776888677},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Valeera Sanguinar begins making a campfire.\",\"id\":\"s16_3523\",\"timestamp\":1776888679},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Boletus\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Boletus yells: Kvotheen, help! This not scheduled fight!\",\"id\":\"s16_3524\",\"timestamp\":1776888679},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Lightbloom capturing fungarians? As if the rutaani weren't bad enough.\",\"id\":\"s16_3525\",\"timestamp\":1776888682},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: One moment.\",\"id\":\"s16_3526\",\"timestamp\":1776888685},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: I'll staunch the bleeding.\",\"id\":\"s16_3527\",\"timestamp\":1776888688},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"DRUID\",\"name\":\"Ælëen-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Ælëen-Hyjal|h[|cffff7c0aÆlëen|r]|h a accompli le haut fait |cffffff00|Hachievement:42768:Player-1390-0CEEF927:1:4:22:26:4294967295:4294967295:4294967295:4294967295|h[Champion of the Dawn]|h|r !\",\"id\":\"s16_3528\",\"timestamp\":1776888689},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Take strength from this.\",\"id\":\"s16_3529\",\"timestamp\":1776888699},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Valeera Sanguinar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Valeera Sanguinar says: Won't see me coming.\",\"id\":\"s16_3530\",\"tim