["timestamp"] = 1772819187,
["id"] = "s3_4571",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "WARRIOR",
["race"] = "Orc",
["name"] = "Grodar-Archimonde",
["sex"] = 2,
},
