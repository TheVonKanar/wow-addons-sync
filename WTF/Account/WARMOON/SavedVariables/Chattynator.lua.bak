},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Lirath Windrunner says: Vereesa was the peacekeeper of our family. She spent many days tending to the gardens here, but the wilderness has overtaken it now.",
