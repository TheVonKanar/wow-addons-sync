},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Locus-Walker says: Can it truly be? At long last, the All-Devouring is vanquished... my world, my people... we are finally avenged.",
["id"] = "s0_946",
["timestamp"] = 1770068378,
},
