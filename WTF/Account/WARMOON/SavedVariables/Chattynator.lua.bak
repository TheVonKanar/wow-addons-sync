["r"] = 1,
["g"] = 0.250980406999588,
["b"] = 0.250980406999588,
},
["text"] = "Arcane Sentry yells: Unauthorized entry. Please hold.",
["timestamp"] = 1772650590,
["id"] = "s2_4341",
},
