["g"] = 1,
["b"] = 0.250980406999588,
},
["text"] = "|Hplayer:Øskydrood-Archimonde|h[|cffff7c0aØskydrood-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:6019:Player-1302-0D61520B:1:3:4:26:4294967295:4294967295:4294967295:4294967295|h[Come One, Come All!]|h|r !",
["timestamp"] = 1772660962,
["id"] = "s3_2963",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Su'meera",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Su'meera says: Over here, Zandalari.",
["timestamp"] = 1772660972,
["id"] = "s3_2964",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Orweyna",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Orweyna says: These vicious rutaani have overgrown Blooming Lattice. Prune them back.",
