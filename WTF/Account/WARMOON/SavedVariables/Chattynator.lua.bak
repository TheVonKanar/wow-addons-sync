},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Orweyna says: Alndust is limited, so we must cull the areas where the Lightbloom is most active.",
["id"] = "s21_2938",
["timestamp"] = 1787606011,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
