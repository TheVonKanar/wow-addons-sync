},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Veteran Blood Knight says: Stop? We've only just turned the tides!",
["id"] = "s0_3402",
["timestamp"] = 1772235510,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
