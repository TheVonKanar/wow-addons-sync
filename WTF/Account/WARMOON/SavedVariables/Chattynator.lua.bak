["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zadu, Fist of Nalorakk says: Time to die.",
["id"] = "s2_3259",
["timestamp"] = 1772577600,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kalgorg the Unshackled",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kalgorg the Unshackled says: I will escape into the Twisting Nether if I must!",
["id"] = "s2_3260",
["timestamp"] = 1772577601,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Lucia Nightbreaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lucia Nightbreaker says: Your service isn't over, Kalgorg. Come see, Kvotheen.",
["id"] = "s2_3261",
["timestamp"] = 1772577604,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kalgorg the Unshackled",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Kalgorg the Unshackled yells: You think you've won? I am eternal! I am Void! You are both nothing but mortal cur!",
["id"] = "s2_3262",
["timestamp"] = 1772577613,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Lucia Nightbreaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lucia Nightbreaker says: I admire your spirit, Kalgorg. And that is why I demand that you return to me.",
["id"] = "s2_3263",
["timestamp"] = 1772577618,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zadu, Fist of Nalorakk",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zadu, Fist of Nalorakk says: Impressive.",
["id"] = "s2_3264",
["timestamp"] = 1772577618,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kalgorg the Unshackled",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Kalgorg the Unshackled says: Brazen elf! I will return, only so that I might witness your end!",
["id"] = "s2_3265",
["timestamp"] = 1772577623,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Lucia Nightbreaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lucia Nightbreaker says: I wouldn't have it any other way, but don't forget who's in charge. Perhaps some time in a lesser form will remind you.",
["id"] = "s2_3266",
["timestamp"] = 1772577627,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zadu, Fist of Nalorakk",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zadu, Fist of Nalorakk says: I be prey to no one!",
["id"] = "s2_3267",
["timestamp"] = 1772577628,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
