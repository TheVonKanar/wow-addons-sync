["type"] = "GUILD_ACHIEVEMENT",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 1,
["r"] = 0.250980406999588,
},
["text"] = "|Hplayer:Delondra-LaCroisadeécarlate|h[|cfff48cbaDelondra-LaCroisadeécarlate|r]|h a accompli le haut fait |cffffff00|Hachievement:62439:Player-1127-09547AED:1:8:20:26:4294967295:4294967295:4294967295:4294967295|h[Keystone Hero: Den of Nalorakk]|h|r !",
["id"] = "s20_3150",
["timestamp"] = 1787244169,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Maella",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Riftblade Maella says: Y'mera, keep us hidden while we gather our bearings. Champion, to me.",
["id"] = "s20_3151",
["timestamp"] = 1787244173,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["event"] = "CHAT_MSG_CURRENCY",
["type"] = "CURRENCY",
},
["color"] = {
["b"] = 0,
["g"] = 0.6666666865348816,
["r"] = 0,
},
["text"] = "You receive currency: |cnIQ4:|Hcurrency:3405:0|h[Field Accolade]|h|rx10",
["id"] = "s20_3152",
["timestamp"] = 1787244200,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Riftblade Maella",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Riftblade Maella says: Our allies have scouted ahead to see what we're dealing with. Regroup with them and see what they found.",
["id"] = "s20_3153",
["timestamp"] = 1787244205,
},
