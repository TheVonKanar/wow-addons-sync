["color"] = {
["r"] = 1,
["g"] = 0.501960813999176,
["b"] = 0.250980406999588,
},
["text"] = "Valeera Sanguinar falls asleep. Zzzzzzz.",
["timestamp"] = 1787504478,
["id"] = "s20_4720",
},
