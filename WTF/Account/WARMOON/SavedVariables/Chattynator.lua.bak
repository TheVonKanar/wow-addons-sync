rebirth.\",\"id\":\"s17_4814\",\"timestamp\":1777927253},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Quickly now! Bring him down before they hatch anew!\",\"id\":\"s17_4815\",\"timestamp\":1777927253},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Two halves of a whole--Vereesa, follow the Light phoenix. I'll take the other side.\",\"id\":\"s17_4816\",\"timestamp\":1777927262},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: Are you sure?\",\"id\":\"s17_4817\",\"timestamp\":1777927268},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: I know what the Void can do. I can handle this.\",\"id\":\"s17_4818\",\"timestamp\":1777927270},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Champions! Prepare yourselves!\",\"id\":\"s17_4819\",\"timestamp\":1777927296},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: We must stop Belo'ren!\",\"id\":\"s17_4820\",\"timestamp\":1777927300},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"ROGUE\",\"name\":\"Mangousto\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Mangousto receives loot: |cnIQ0:|Hitem:260659::::::::90:263:::::::::|h[Stellar Vortex Residue]|h|r.\",\"id\":\"s17_4821\",\"timestamp\":1777927333},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: Heroes, now! We must bring them down together!\",\"id\":\"s17_4822\",\"timestamp\":1777927356},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: Belo'ren! Please, we are defenders of the Sunwell, as are you!\",\"id\":\"s17_4823\",\"timestamp\":1777927362},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Belo'ren\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Light and Void converge, forging a phoenix reborn in the essence of Twilight.\",\"id\":\"s17_4824\",\"timestamp\":1777927364},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: The Void... mother says it speaks to you. To Belo'ren, we are attacking what he was sworn to defend.\",\"id\":\"s17_4825\",\"timestamp\":1777927367},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"