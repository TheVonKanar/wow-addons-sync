},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Xal'atath says: Do not savor this victory for too long. With Dimensius's defeat, the Dark Heart is on the verge of collapse.",
