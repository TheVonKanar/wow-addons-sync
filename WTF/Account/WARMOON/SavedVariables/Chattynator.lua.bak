235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: We must make haste. Xal'atath is using Alleria's rage and pain to erode her mastery over the Void.\",\"id\":\"s11_4125\",\"timestamp\":1774897283},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: After what happened with Turalyon and Arator... I can see how Alleria would struggle to maintain control. I doubt I'd be able to, if it were me.\",\"id\":\"s11_4126\",\"timestamp\":1774897293},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Sânghr-Hyjal:384:RAID:|h[|cff00ff98Sânghr|r]|h: CEST TIPAR MOKTAR\",\"id\":\"s11_4127\",\"timestamp\":1774897300},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Grodar-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Grodar-Archimonde:386:RAID:|h[|cffc69b6dGrodar-Archimonde|r]|h: 2late dude\",\"id\":\"s11_4128\",\"timestamp\":1774897306},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Mother!\",\"id\":\"s11_4129\",\"timestamp\":1774897306},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"High Exarch Turalyo