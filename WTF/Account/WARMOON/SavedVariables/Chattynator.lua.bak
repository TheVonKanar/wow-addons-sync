cally Beef]|h|rx5\",\"timestamp\":1771960176,\"id\":\"s0_1830\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thaed Pyremaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thaed Pyremaker says: Burn those defenses to ash before they turn the tide of battle!\",\"timestamp\":1771960195,\"id\":\"s0_1831\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thaed Pyremaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thaed Pyremaker says: Burn those defenses to ash before they turn the tide of battle!\",\"timestamp\":1771960201,\"id\":\"s0_1832\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thaed Pyremaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thaed Pyremaker says: There are too many injured on the field. Bring them the warmth of the Sacred Flame!\",\"timestamp\":1771960239,\"id\":\"s0_1833\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thaed Pyremaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thaed Pyremaker says: We've got them on the run! To me--let us give them a reason to keep running!\",\"timestamp\":1771960263,\"id\":\"s0_1834\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thaed Pyremaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Thaed Pyremaker says: We've got them on the run! To me--let us give them a reason to keep running!\",\"timestamp\":1771960272,\"id\":\"s0_1835\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Thaed Pyremaker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER