"b\":0.6235294342041016},\"text\":\"Lothraxion says: War is no place for a tender heart, boy.\",\"timestamp\":1772560997,\"id\":\"s1_4487\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:267082::::::::90:263::11::1:28:3084:::::|h[Ornate Cosmic Table]|h|r\",\"timestamp\":1772560997,\"id\":\"s1_4488\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:260866::::::::90:263::60:1:13573:2:9:90:28:3084:::::|h[Neverending Vortex Chainmail]|h|r\",\"timestamp\":1772561019,\"id\":\"s1_4489\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Make ready. It's time we claim the Mantle of Predation.\",\"timestamp\":1772561059,\"id\":\"s1_4490\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Soon we'll have all we need. We should strike down this wretch before their hunger turns on us.\",\"timestamp\":1772561064,\"id\":\"s1_4491\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Don't you think we have enough enemies ahead of us? I'll take allies where I can get them.\",\"timestamp\":1772561072,\"id\":\"s1_4492\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: The Void holds allegiance to none!\",\"timestamp\":1772561078,\"id\":\"s1_4493\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: It corrupts and confounds, makes enemies of friends, twists right into wrong.\",\"timestamp\":1772561083,\"id\":\"s1_4494\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: The Light isn't harmless either. I've felt its fury. Seen the sacrifices it can compel us to make.\",\"timestamp\":1772561091,\"id\":\"s1_4495\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Voltarynn-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voltarynn-Dalaran:274:GUILD:|h[|cff33937fVoltarynn|r]|h: re coucou\",\"timestamp\":1772561095,\"id\":\"s1_4496\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: I have served the Light for millennia. I understand sacrifice better than you ever could.\",\"timestamp\":1772561099,\"id\":\"s1_4497\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Then don't become numb to it! We all fight for the same cause.\",\"timestamp\":1772561107,\"id\":\"s1_4498\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Yet only I seem to understand what is at stake.\",\"timestamp\":1772561113,\"id\":\"s1_4499\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Stay together. No one fights alone, no one gets left behind.\",\"timestamp\":1772561120,\"id\":\"s1_4500\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"Vulpera\",\"name\":\"Seizuko-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Seizuko-Hyjal:279:GUILD:|h[|cffaad372Seizuko|r]|h: ils ont debug les armes 1 mains en hunt :DDD\",\"timestamp\":1772561139,\"id\":\"s1_4501\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: That look in Lothraxion's eyes is the same I saw in father's.\",\"timestamp\":1772561151,\"id\":\"s1_4502\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: I wish Turalyon were here. Lothraxion might listen to him.\",\"timestamp\":1772561157,\"id\":\"s1_4503\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Can you feel it? The Mantle is close at hand.\",\"timestamp\":1772561163,\"id\":\"s1_4504\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Don't look so eager, beast. You've fooled Alleria, but I see through you.\",\"timestamp\":1772561170,\"id\":\"s1_4505\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Claim the Mantle. We'll watch your back.\",\"timestamp\":1772561179,\"id\":\"s1_4506\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Terminas\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Terminas says: Away for but a moment and the vermin move in. You were right to alert me, Decimus.\",\"timestamp\":1772561188,\"id\":\"s1_4507\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: I warned you! This was always their plot!\",\"timestamp\":1772561198,\"id\":\"s1_4508\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Do keep our magnificent lord entertained, friends. I'd so hate for him to lose interest.\",\"timestamp\":1772561201,\"id\":\"s1_4509\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: What did I miss? Why wait until now to betray us?\",\"timestamp\":1772561212,\"id\":\"s1_4510\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Weapons ready. We'll make ourselves an opening and deal with Decimus afterward.\",\"timestamp\":1772561232,\"id\":\"s1_4511\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Voltarynn-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voltarynn-Dalaran:295:GUILD:|h[|cff33937fVoltarynn|r]|h: ah cool ça ! \",\"timestamp\":1772561242,\"id\":\"s1_4512\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Trusting Decimus was madness!\",\"timestamp\":1772561258,\"id\":\"s1_4513\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: I don't understand. They could have betrayed us at any time.\",\"timestamp\":1772561262,\"id\":\"s1_4514\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: I knew you were blind to the Void's schemes!\",\"timestamp\":1772561267,\"id\":\"s1_4515\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: No, something's not right. Decimus would not miss this spectacle.\",\"timestamp\":1772561273,\"id\":\"s1_4516\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260659::::::::90:263:::::::::|h[Stellar Vortex Residue]|h|rx2\",\"timestamp\":1772561286,\"id\":\"s1_4517\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Terminas\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Terminas says: Such dull camaraderie. You shall learn your place as Decimus has.\",\"timestamp\":1772561292,\"id\":\"s1_4518\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Terminas\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Terminas says: Fight one another or die. I will cull these weak distractions.\",\"timestamp\":1772561301,\"id\":\"s1_4519\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: This was Decimus's plan. Keep Terminas's eyes on us, Kvotheen.\",\"timestamp\":1772561313,\"id\":\"s1_4520\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: Are you mad, Alleria?\",\"timestamp\":1772561318,\"id\":\"s1_4521\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: I've seen you fight, Kvotheen. I know you can do more.\",\"timestamp\":1772561328,\"id\":\"s1_4522\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Entertained, Terminas? Come down here if you dare.\",\"timestamp\":1772561348,\"id\":\"s1_4523\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Sânghr-Hyjal:307:GUILD:|h[|cff00ff98Sânghr|r]|h: les mecs qui sont full gear pvp ils ont pas de vie ?\",\"timestamp\":1772561367,\"id\":\"s1_4524\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"Vulpera\",\"name\":\"Seizuko-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Seizuko-Hyjal|h[|cffaad372Seizuko|r]|h a accompli le haut fait |cffffff00|Hachievement:62269:Player-1390-0C65DBA2:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Altar of Blessings: Amani Curious]|h|r !\",\"timestamp\":1772561385,\"id\":\"s1_4525\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"BloodElf\",\"name\":\"Iranus-Ysondre\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Iranus-Ysondre:309:GUILD:|h[|cffa330c9Iranus-Ysondre|r]|h: #Chomage\",\"timestamp\":1772561390,\"id\":\"s1_4526\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Not bad, but it's time to end this.\",\"timestamp\":1772561392,\"id\":\"s1_4527\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Sânghr-Hyjal:311:GUILD:|h[|cff00ff98Sânghr|r]|h: jpense mdr\",\"timestamp\":1772561402,\"id\":\"s1_4528\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Human\",\"name\":\"Hitni-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hitni-Archimonde:312:GUILD:|h[|cff3fc7ebHitni|r]|h: chomage  et surtout pas de vie\",\"timestamp\":1772561429,\"id\":\"s1_4529\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Human\",\"name\":\"Hitni-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hitni-Archimonde:313:GUILD:|h[|cff3fc7ebHitni|r]|h: mdrr je suis au chomage et j'ai pas h24 du temps pour wow xD vie de couple,autres passions :c\",\"timestamp\":1772561448,\"id\":\"s1_4530\"},{\"recordedB