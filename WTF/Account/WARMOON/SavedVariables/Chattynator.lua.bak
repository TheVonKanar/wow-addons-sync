},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Grand Magister Rommath says: How dare the Amani threaten the sin'dorei again!",
["id"] = "s0_3401",
["timestamp"] = 1772235505,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
