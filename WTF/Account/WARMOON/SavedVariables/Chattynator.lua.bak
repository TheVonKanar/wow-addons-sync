},
["type"] = "MONSTER_SAY",
["event"] = "CHAT_MSG_MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Veteran Blood Knight says: Look what they've done! I will have my vengeance!",
["id"] = "s0_3398",
["timestamp"] = 1772235493,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
