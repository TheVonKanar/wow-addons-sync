["g"] = 1,
["r"] = 0.250980406999588,
},
["text"] = "|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:61916:Player-1390-09230B89:1:2:19:26:4294967295:4294967295:4294967295:4294967295|h[Rage of the Ren'dorei]|h|r!",
["id"] = "s0_1064",
["timestamp"] = 1771505923,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Allari the Souleater",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Allari the Souleater says: Leona has shown me that the ren'dorei are uniquely suited to both wield and combat the Void.",
["id"] = "s0_1065",
["timestamp"] = 1771505925,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["race"] = "VoidElf",
["class"] = "WARLOCK",
