 be stopped.\",\"timestamp\":1776365959,\"id\":\"s14_4668\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Human\",\"name\":\"Hitni-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"r\":1,\"g\":0.4980392456054688,\"b\":0},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Hitni-Archimonde:92:RAID:|h[|cff3fc7ebHitni-Archimonde|r]|h: c'est fait déja\",\"timestamp\":1776366033,\"id\":\"s14_4669\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_SAY\",\"type\":\"SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":1},\"text\":\"|Hplayer:Sânghr-Hyjal:93:SAY:|h[|cff00ff98Sânghr|r]|h says: et le truc pour up les gear cest arme et bijou uniquement \",\"timestamp\":1776366069,\"id\":\"s14_4670\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGHT\",\"race\":\"BloodElf\",\"name\":\"Øskydk\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Øskydk places a cozy Harandar Celebration for everyone to enjoy!\",\"timestamp\":1776366087,\"id\":\"s14_4671\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"r\":0.6666666865348816,\"g\":0.6666666865348816,\"b\":1},\"text\":\"[Tank] |Hplayer:Øskydk|h[Øskydk]: |h|A:ping_chat_onmyway:0:0:0:0|aOn my way\",\"timestamp\":1776366089,\"id\":\"s14_4672\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Human\",\"name\":\"Hitni\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Hitni sets out a Toy Train Set!\",\"timestamp\":1776366110,\"id\":\"s14_4673\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DEATHKNIGH