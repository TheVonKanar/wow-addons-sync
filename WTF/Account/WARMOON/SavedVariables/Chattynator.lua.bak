},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Eversong Magister says: And give them the upper hand? Never! Glory to the sin'dorei!",
["id"] = "s0_3400",
["timestamp"] = 1772235502,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
