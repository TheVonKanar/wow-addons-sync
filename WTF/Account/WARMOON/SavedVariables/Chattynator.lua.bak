":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260657::::::::90:263:::::::::|h[Holey Organ]|h|rx3\",\"id\":\"s19_4023\",\"timestamp\":1787159772},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260672::::::::90:263:::::::::|h[Fetid Eye]|h|r\",\"id\":\"s19_4024\",\"timestamp\":1787159797},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ0:|Hitem:266002::::::::90:263:::::::::|h[Broken Trap Mechanism]|h|r\",\"id\":\"s19_4025\",\"timestamp\":1787159799},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Pack Hunter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Pack Hunter says: Found you...\",\"id\":\"s19_4026\",\"timestamp\":1787159844},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"Ambushed!\",\"id\":\"s19_4027\",\"timestamp\":1787159850},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: We must be careful. Untold horrors could be waking in the temple.\",\"id\":\"s19_4028\",\"timestamp\":1787159878},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: For thousands of years, dis temple been sealed away. We did not know why.\",\"id\":\"s19_4029\",\"timestamp\":1787159884},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Now we know it was to hide de Soulcoiler's unspeakable rituals--and de body of Ula'tek.\",\"id\":\"s19_4030\",\"timestamp\":1787159890},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"SHAMAN\",\"name\":\"Kàmz\",\"sex\":3},\"event\":\"CHAT_MSG_TEXT_EMOTE\",\"type\":\"EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"|Hplayer:Kàmz:523:TEXT_EMOTE:|h|cff0070ddKàmz|r|h waves at Yukestrasz.\",\"id\":\"s19_4031\",\"timestamp\":1787159890},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: And my brother has dug it all up again! Dey were all buried for a reason, Zul'jan! What have you got yourself into?\",\"id\":\"s19_4032\",\"timestamp\":1787159898},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"MONK\",\"name\":\"Yahaa\",\"sex\":3},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Yahaa's Ruby Whelpling flies upward with a look of determination.\",\"id\":\"s19_4033\",\"timestamp\":1787159933},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: We've awakened de spirits!\",\"id\":\"s19_4034\",\"timestamp\":1787159934},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Saripark-Throk'Feroth\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Saripark-Throk'Feroth receives loot: |cnIQ1:|Hitem:238513::::::::90:263::::1:38:13:::::|h[Void-Tempered Scales |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r.\",\"id\":\"s19_4035\",\"timestamp\":1787159934},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Boufalien-Vol'jin\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Boufalien-Vol'jin receives loot: |cnIQ1:|Hitem:238513::::::::90:263::::1:38:13:::::|h[Void-Tempered Scales |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r.\",\"id\":\"s19_4036\",\"timestamp\":1787159935},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"MagharOrc\",\"class\":\"MONK\",\"name\":\"Françoise-Throk'Feroth\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Françoise-Throk'Feroth receives loot: |cnIQ3:|Hitem:237016::::::::90:263::::1:38:14:::::|h[Sunfire Silk |A:Professions-ChatIcon-Quality-12-Tier2:17:15::1|a]|h|r.\",\"id\":\"s19_4037\",\"timestamp\":1787159937},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Saripark-Throk'Feroth\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Saripark-Throk'Feroth receives loot: |cnIQ1:|Hitem:238513::::::::90:263::::1:38:13:::::|h[Void-Tempered Scales |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2.\",\"id\":\"s19_4038\",\"timestamp\":1787159937},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: There is a dark presence. One I know well. Nek'zali--the one who raised Ula'tek--is here!\",\"id\":\"s19_4039\",\"timestamp\":1787159937},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Boufalien-Vol'jin\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Boufalien-Vol'jin receives loot: |cnIQ1:|Hitem:238513::::::::90:263::::1:38:13:::::|h[Void-Tempered Scales |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r.\",\"id\":\"s19_4040\",\"timestamp\":1787159937},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Boufalien-Vol'jin\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Boufalien-Vol'jin receives loot: |cnIQ3:|Hitem:238625::::::::90:263:::::::::|h[Fine Void-Tempered Hide]|h|r.\",\"id\":\"s19_4041\",\"timestamp\":1787159938},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nek'zali the Soulcoiler\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Nek'zali the Soulcoiler yells: Heh heh. So... you have come again?\",\"id\":\"s19_4042\",\"timestamp\":1787159966},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nek'zali the Soulcoiler\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Nek'zali the Soulcoiler yells: Flesh, breath, and bone. You think yourselves masters of what sleeps below.\",\"id\":\"s19_4043\",\"timestamp\":1787159971},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nek'zali the Soulcoiler\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Nek'zali the Soulcoiler yells: Dey thought their bones could hold me. But bones... crumble. Coils... only loosen with time.\",\"id\":\"s19_4044\",\"timestamp\":1787159981},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nek'zali the Soulcoiler\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Nek'zali the Soulcoiler yells: Mmm... de coils still hum with power. Even stone got a memory.\",\"id\":\"s19_4045\",\"timestamp\":1787159992},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nek'zali the Soulcoiler\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Nek'zali the Soulcoiler yells: Dey buried me with de loa I gave them...\",\"id\":\"s19_4046\",\"timestamp\":1787159999},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nek'zali the Soulcoiler\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Nek'zali the Soulcoiler yells: But now dey are trapped with me!\",\"id\":\"s19_4047\",\"timestamp\":1787160004},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Tauren\",\"class\":\"DRUID\",\"name\":\"Saripark-Throk'Feroth\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Saripark-Throk'Feroth receives loot: |cnIQ1:|Hitem:238513::::::::90:263::::1:38:13:::::|h[Void-Tempered Scales |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2.\",\"id\":\"s19_4048\",\"timestamp\":1787