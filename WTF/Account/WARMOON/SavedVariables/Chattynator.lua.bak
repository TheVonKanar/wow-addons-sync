["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Voltface-Dalaran:87:GUILD:|h[|cffa330c9Voltface|r]|h: re, et c'est moi qui file ^^",
["id"] = "s18_4477",
["timestamp"] = 1786983595,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "DRUID",
["race"] = "Troll",
["name"] = "Darkpewpew",
["sex"] = 2,
},
