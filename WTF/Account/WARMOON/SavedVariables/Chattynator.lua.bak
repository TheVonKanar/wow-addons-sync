["g"] = 0.6666666865348816,
["r"] = 0,
},
["text"] = "You receive loot: |cnIQ2:|Hitem:256963::::::::90:263:::::::::|h[Thalassian Lumber]|h|r",
["id"] = "s18_4525",
["timestamp"] = 1786986705,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["race"] = "ZandalariTroll",
