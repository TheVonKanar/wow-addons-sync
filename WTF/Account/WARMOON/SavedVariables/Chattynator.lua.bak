":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264257::::::::84:263::11::1:28:3086:::::|h[Zul'Aman Armament Rest]|h|r\",\"timestamp\":1772278346,\"id\":\"s0_4249\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: With me, elf. Let's get in close and distract him.\",\"timestamp\":1772278374,\"id\":\"s0_4250\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mor'duun\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Mor'duun yells: Mere mortal-born armaments cannot harm the grand glory of Xal'atath!\",\"timestamp\":1772278377,\"id\":\"s0_4251\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jan says: Get over here, Kvotheen! I'll load de bolts. You start firing.\",\"timestamp\":1772278378,\"id\":\"s0_4252\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mor'duun\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Mor'duun yells: GRAH! Your weapons are empowered with Light?\",\"timestamp\":1772278391,\"id\":\"s0_4253\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jan says: Warriors, attack!\",\"timestamp\":1772278408,\"id\":\"s0_4254\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"DarkIronDwarf\",\"name\":\"Koutkekette-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Koutkekette-Hyjal|h[|cffc69b6dKoutkekette|r]|h has earned the achievement |cffffff00|Hachievement:61311:Player-1390-0D4834E8:1:2:28:26:4294967295:4294967295:4294967295:4294967295|h[Ready to Remodel]|h|r!\",\"timestamp\":1772278474,\"id\":\"s0_4255\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jan says: Running away? Coward. De victory should have been ours!\",\"timestamp\":1772278491,\"id\":\"s0_4256\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: Dis was no victory. We bought de civilians' escape with blood.\",\"timestamp\":1772278497,\"id\":\"s0_4257\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Zul'jan's eyes glow with the desire for vengeance.\",\"timestamp\":1772278502,\"id\":\"s0_4258\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:248565::::::::84:263::11:2:13573:6652:2:9:84:28:3086:::::|h[Zulguard's Striders]|h|r\",\"timestamp\":1772278504,\"id\":\"s0_4259\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Liadrin says: If we help eliminate the Twilight's Blade, the need for lightwood, and the raids into Eversong, will end.\",\"timestamp\":1772278534,\"id\":\"s0_4260\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Zul'jarra says: We can end de threat inside and outside our gates. If you really want to join our fight, then come with me.\",\"timestamp\":1772278541,\"id\":\"s0_4261\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"EarthenDwarf\",\"name\":\"Yapludruhm-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Yapludruhm-Hyjal|h[|cfff48cbaYapludruhm|r]|h a accompli le haut fait |cffffff00|Hachievement:41805:Player-1390-0D1876B7:1:2:28:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r !\",\"timestamp\":1772279187,\"id\":\"s0_4262\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Human\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Jamelmoignon-Hyjal:1322:GUILD:|h[|cffffffffJamelmoignon|r]|h: ish\",\"timestamp\":1772279264,\"id\":\"s0_4263\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Human\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Jamelmoignon-Hyjal:1323:GUILD:|h[|cffffffffJamelmoignon|r]|h: j'ai pris une demi barre en montant un peu mes métiers mdrr\",\"timestamp\":1772279274,\"id\":\"s0_4264\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"Draenei\",\"name\":\"Cïarrah-KhazModan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Cïarrah-KhazModan|h[|cfff48cbaCïarrah-KhazModan|r]|h a accompli le haut fait |cffffff00|Hachievement:40525:Player-3690-08F60A13:1:2:28:26:4294967295:4294967295:4294967295:4294967295|h[Fungal Folly Stories]|h|r !\",\"timestamp\":1772279404,\"id\":\"s0_4265\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"|TInterface\\\\ICONS\\\\Tracking_WildPet.blp:20|t  Track Pets via minimap to find wild pets.\",\"id\":\"s0_4266\",\"timestamp\":1772289101},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: For your own safety, I suggest you keep your blade sheathed and stay close to me in Amani'Zar.\",\"id\":\"s0_4267\",\"timestamp\":1772289144},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Come with me. De leaders of de forest tribes have gathered to discuss our war plan.\",\"id\":\"s0_4268\",\"timestamp\":1772289186},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Where were all of you when de drums sounded? You let Atal'Aman fall!\",\"id\":\"s0_4269\",\"timestamp\":1772289242},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Atal'Aman has fallen.\",\"id\":\"s0_4270\",\"timestamp\":1772289255},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: No thanks to all of you!\",\"id\":\"s0_4271\",\"timestamp\":1772289257},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Kul'amara the Fierce says: We are under attack. De Vilebranch--\",\"id\":\"s0_4272\",\"timestamp\":1772289261},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: No time for barin' our tusks. We need a plan. Torundo?\",\"id\":\"s0_4273\",\"timestamp\":1772289263},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Torundo the Grizzled says: Not many Amani made it back here.\",\"id\":\"s0_4274\",\"timestamp\":1772289270},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lilaju\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lilaju says: De Revantusk also suffered heavy losses.\",\"id\":\"s0_4275\",\"timestamp\":1772289273},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Tak'lejo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tak'lejo says: I have sent out a call to my people. We will see.\",\"id\":\"s0_4276\",\"timestamp\":1772289277},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Forgive me...\",\"id\":\"s0_4277\",\"timestamp\":1772289281},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: But what about the loa? Can you not call upon them to aid you?\",\"id\":\"s0_4278\",\"timestamp\":1772289282},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Torundo the Grizzled says: De loa? Dey abandoned us long ago.\",\"id\":\"s0_4279\",\"timestamp\":1772289286},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: We never needed them. We can rely on our own strength!\",\"id\":\"s0_4280\",\"timestamp\":1772289290},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: I ask again for your assistance. We've got to make a stand.\",\"id\":\"s0_4281\",\"timestamp\":1772289296},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Make ready what you can.\",\"id\":\"s0_4282\",\"timestamp\":1772289300},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: No point in talkin' about de loa. Dey abandoned us long ago. Come. Let us check on de refugees.\",\"id\":\"s0_4283\",\"timestamp\":1772289334},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Small Refugee\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Small Refugee says: Mama! I'm so hungry...\",\"id\":\"s0_4284\",\"timestamp\":1772289368},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Torundo, I need ya report. When can our soldiers be ready for battle?\",\"id\":\"s0_4285\",\"timestamp\":1772289369},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Torundo the Grizzled\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Torundo the Grizzled says: It don't look good. All that's left be de old, de injured, and de hungry.\",\"id\":\"s0_4286\",\"timestamp\":1772289375},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Your people's situation is far more desperate than I realized.\",\"id\":\"s0_4287\",\"timestamp\":1772289389},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: De tribes have splintered since Zul'jin fell. De Twilight Blade pickin' us apart because we no longer work as one.\",\"id\":\"s0_4288\",\"timestamp\":1772289395},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lilaju\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lilaju says: De Revantusk's best smiths be repairing our weapons, Zul'jarra.\",\"id\":\"s0_4289\",\"timestamp\":1772289411},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lilaju\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lilaju says: We are workin' as fast as we can. But many of our weapons were broken in de attack.\",\"id\":\"s0_4290\",\"timestamp\":1772289423},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Keep it up. These weapons are our best chance against de Void.\",\"id\":\"s0_4291\",\"timestamp\":1772289430},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: If de lightwood weapons are not ready, maybe de Shadowpine shamans can help.\",\"id\":\"s0_4292\",\"timestamp\":1772289435},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Tak'lejo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tak'lejo says: Ah, Zul'jarra. You come seeking de power of my tribe's shamans?\",\"id\":\"s0_4293\",\"timestamp\":1772289529},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Tak'lejo\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Tak'lejo says: You know none can order de Shadowpine. We wander, obeying only de inner fire in each of us.\",\"id\":\"s0_4294\",\"timestamp\":1772289541},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Then we be left with few warriors, few weapons, and few shamans as well...\",\"id\":\"s0_4295\",\"timestamp\":1772289551},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: It is time for desperate acts. Would you let your people perish because you did not try every option?\",\"id\":\"s0_4296\",\"timestamp\":1772289558},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Fool elf, I told you de loa be silent! If you need proof, let de old loa speaker tell you himself!\",\"id\":\"s0_4297\",\"timestamp\":1772289567},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Sparring Partner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Sparring Partner says: For Zul'Aman!\",\"id\":\"s0_4298\",\"timestamp\":1772289572},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: You were with me as a child when I last went to Akil'zon's temple, Zul'jarra. Do you not remember?\",\"id\":\"s0_4299\",\"timestamp\":1772289593},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Yes, uncle. But even den de loa did not speak to us.\",\"id\":\"s0_4300\",\"timestamp\":1772289602},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: De loa always heed us in times of crisis. Dey may listen now to de right voice--someone on de path of de hash'ey!\",\"id\":\"s0_4301\",\"timestamp\":1772289680},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Light de shrines on your way to de temple. And don't forget to leave Akil'zon an offerin'!\",\"id\":\"s0_4302\",\"timestamp\":1772289723},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: De temple be overrun with gnarldin. Killin' dem will help us pass de time on de way. Come, \\\"hash'ura.\\\"\",\"id\":\"s0_4303\",\"timestamp\":1772289730},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Recruit Dar'rak\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Recruit Dar'rak says: Anyone willin' to punch me? Rough me up a little? Anyone?\",\"id\":\"s0_4304\",\"timestamp\":1772289738},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Recruit Dar'rak\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Recruit Dar'rak says: I'll meet you upstairs with my commander. Hope you're as strong as you look!\",\"id\":\"s0_4305\",\"timestamp\":1772289754},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Uncle, de loa haven't spoken to you in years. Why you think dey will speak to us now?\",\"id\":\"s0_4306\",\"timestamp\":1772289765},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: You did not know de world with de loa in it, my child. Dey were our strength. Our hope.\",\"id\":\"s0_4307\",\"timestamp\":1772289773},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: Akil'zon bestowed on me a great honor when she made me her speaker.\",\"id\":\"s0_4308\",\"timestamp\":1772289783},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: I tried to instill in de both of you--you and Zul'jan--a love for de loa.\",\"id\":\"s0_4309\",\"timestamp\":1772289790},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: I remember de stories about Akil'zon, Halazzi, Jan'alai, and Nalorakk, and how dey protected us.\",\"id\":\"s0_4310\",\"timestamp\":1772289800},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: I loved listenin' to your stories, uncle. But even then I wondered if they were true.\",\"id\":\"s0_4311\",\"timestamp\":1772289809},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: How much do you remember about goin' to Akil'zon's temple?\",\"id\":\"s0_4312\",\"timestamp\":1772289816},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: We climbed to de temple. Zul'jan fell. I did not get de loa's blessin'. And my mother died.\",\"id\":\"s0_4313\",\"timestamp\":1772289822},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: You saved your brother. And you defended your right to lead as Zul'jin's granddaughter--all on your own.\",\"id\":\"s0_4314\",\"timestamp\":1772289831},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: If anyone can get to de loa and get answers, it is you.\",\"id\":\"s0_4315\",\"timestamp\":1772289838},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: As de \\\"hash'ey?\\\" I'm no priestess. No mystic or uniter.\",\"id\":\"s0_4316\",\"timestamp\":1772289844},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Kinduru\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Kinduru says: No, my Jarra. As my niece. Because I know you have de fire. And I love you more than anythin'.\",\"id\":\"s0_4317\",\"timestamp\":1772289850},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Den I will go. For our people and for you, uncle.\",\"id\":\"s0_4318\",\"timestamp\":1772289860},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Recruit Dar'rak\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Recruit Dar'rak says: For Zul'Aman!\",\"id\":\"s0_4319\",\"timestamp\":1772289892},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ri'kari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ri'kari says: Dar'rak, show me what you can do! Kvotheen, no holding back!\",\"id\":\"s0_4320\",\"timestamp\":1772289892},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ri'kari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ri'kari says: Enough. Well done, both of you.\",\"id\":\"s0_4321\",\"timestamp\":1772289899},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Recruit Dar'rak\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Recruit Dar'rak says: Whoa, you're amazing! Round two once my nose stops bleedin'?\",\"id\":\"s0_4322\",\"timestamp\":1772289900},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ri'kari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ri'kari says: Dar'rak, you've impressed me. Congratulations, soldier.\",\"id\":\"s0_4323\",\"timestamp\":1772289913},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Recruit Dar'rak\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Recruit Dar'rak says: I DID IT! I mean, thank you, Ri'kari. You've been a great teacher.\",\"id\":\"s0_4324\",\"timestamp\":1772289917},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Chana\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Chana says: Thank you, Kvotheen. I don't wanna do this on my own.\",\"id\":\"s0_4325\",\"timestamp\":1772289969},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Chana\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Chana says: I'll meet you in de Solemn Valley, across the river.\",\"id\":\"s0_4326\",\"timestamp\":1772289974},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ani says: Yum! Is that grilled scalebiter?\",\"id\":\"s0_4327\",\"timestamp\":1772289990},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Gijaniji\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Gijaniji says: Don't worry, Ani. I'll set some aside for you.\",\"id\":\"s0_4328\",\"timestamp\":1772289993},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ani\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ani says: Thanks, Gijaniji! Come on, Jynx.\",\"id\":\"s0_4329\",\"timestamp\":1772289995},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Unknown\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Unknown says: Brother, is dat you?\",\"id\":\"s0_4330\",\"timestamp\":1772290026},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Iz'ken\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Iz'ken says: I heard mother died. Who is dis Zandalari?\",\"id\":\"s0_4331\",\"timestamp\":1772290028},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Chana\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Chana says: I didn't think you'd show up. Dey came to help with de ceremony.\",\"id\":\"s0_4332\",\"timestamp\":1772290031},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Iz'ken\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Iz'ken says: To help, or to make sure we play nice and don' kill each other?\",\"id\":\"s0_4333\",\"timestamp\":1772290035},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Jak'zari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jak'zari says: You have a moment to spare, outsider? Some friends could use a hand!\",\"id\":\"s0_4334\",\"timestamp\":1772290058},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Jak'zari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Jak'zari says: Kahanea's new to her job, so she'll need all de help she can get!\",\"id\":\"s0_4335\",\"timestamp\":1772290079},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:239447::::::::84:263:::::::::|h[Weeping Spores]|h|rx5\",\"id\":\"s0_4336\",\"timestamp\":1772290086},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Chana\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Chana says: Iz'ken, be careful pickin' de spores. You don't wanna anger de boars.\",\"id\":\"s0_4337\",\"timestamp\":1772290086},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Iz'ken\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Iz'ken says: I see some things never change.\",\"id\":\"s0_4338\",\"timestamp\":1772290090},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Iz'ken\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Iz'ken says: Mother never gave me de chance to make mistakes.\",\"id\":\"s0_4339\",\"timestamp\":1772290095},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Iz'ken\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\"