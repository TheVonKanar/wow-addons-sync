["b"] = 0,
},
["text"] = "Bisnina-Archimonde receives loot: |cnIQ1:|Hitem:243599::::::::90:263::::1:38:13:::::|h[Eversinging Dust |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r.",
