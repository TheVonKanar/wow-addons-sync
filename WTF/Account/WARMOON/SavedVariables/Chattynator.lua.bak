["name"] = "Brakko",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Brakko says: Was great to learn fight from Kvotheen. And how not fear sporeglider.",
["timestamp"] = 1772659467,
["id"] = "s3_2759",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
