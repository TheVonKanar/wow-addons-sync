},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Boletus says: Amazing, beat Glow Guard! Trained much well, Kvotheen!",
["timestamp"] = 1772659442,
["id"] = "s3_2755",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ziny",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ziny says: Ziny is thank Kvotheen. Taught us to fight strong in Pit, where is scary.",
["timestamp"] = 1772659455,
["id"] = "s3_2756",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ziny",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ziny says: But taught us to be strong in caps, where can be scary too.",
["timestamp"] = 1772659460,
["id"] = "s3_2757",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
