},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Ja'bonu says: Look at her. So close, and yet so far.",
["id"] = "s21_3991",
["timestamp"] = 1788040097,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ja'bonu",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
