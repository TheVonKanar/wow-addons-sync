["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Locus-Walker says: How will we stop him?",
["timestamp"] = 1770066564,
["id"] = "s0_814",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Xal'atath",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Xal'atath says: We won't. Not alone. Your \"champions\" will hold off Dimensius until we can join the battle.",
["timestamp"] = 1770066567,
["id"] = "s0_815",
},
{
