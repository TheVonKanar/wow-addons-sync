},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Jan'mo the Loud says: Many teams enter, only one team leaves. With their heads, anyway!",
["id"] = "s20_4606",
["timestamp"] = 1787312324,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
