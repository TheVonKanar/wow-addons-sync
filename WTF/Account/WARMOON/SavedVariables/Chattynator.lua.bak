772561641,\"id\":\"s1_4549\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"You sense a nearby Skyriding Glyph.\",\"timestamp\":1772561657,\"id\":\"s1_4550\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"|TInterface\\\\ICONS\\\\INV_KaijuGladiatorMount_Purple.blp:20|t You are being targeted by |cFFFF0000|Hspell:1227420|h[Hungering Presence]|h|r! Fly back!\",\"timestamp\":1772561664,\"id\":\"s1_4551\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DEMONHUNTER\",\"race\":\"BloodElf\",\"name\":\"Iranus-Ysondre\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Iranus-Ysondre|h[|cffa330c9Iranus-Ysondre|r]|h a accompli le haut fait |cffffff00|Hachievement:61509:Player-1335-0687D0A1:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Voidscar Arena]|h|r !\",\"timestamp\":1772561670,\"id\":\"s1_4552\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"|TInterface\\\\ICONS\\\\INV_KaijuGladiatorMount_Purple.blp:20|t You are being targeted by |cFFFF0000|Hspell:1227420|h[Hungering Presence]|h|r! Fly back!\",\"timestamp\":1772561675,\"id\":\"s1_4553\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Damn, he's already torn his way in.\",\"timestamp\":1772561678,\"id\":\"s1_4554\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Decimus\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Decimus says: Stop that Light-addled fool. Then I will join you and use the Mantle to weaken the storm.\",\"timestamp\":1772561693,\"id\":\"s1_4555\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: All this time, Lothraxion thought that my judgment had been compromised by the Void.\",\"timestamp\":1772561701,\"id\":\"s1_4556\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Now his zealotry threatens all of Silvermoon.\",\"timestamp\":1772561708,\"id\":\"s1_4557\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: I've seen this before. In the Scarlet Crusade, in father, even in myself.\",\"timestamp\":1772561713,\"id\":\"s1_4558\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Given who Lothraxion was before he embraced the Light...\",\"timestamp\":1772561720,\"id\":\"s1_4559\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Maybe his conviction was the only thing that could anchor him in a place like this.\",\"timestamp\":1772561724,\"id\":\"s1_4560\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Perhaps. For a thousand years, I saw the Light bolster the resolve of its champions. But it also... changed them.\",\"timestamp\":1772561730,\"id\":\"s1_4561\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Lothraxion was obviously no exception. And neither was Turalyon.\",\"timestamp\":1772561741,\"id\":\"s1_4562\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: More than anything, that was what I feared for you, Arator. Not that you would come to harm, but that the Light would alter you forever.\",\"timestamp\":1772561747,\"id\":\"s1_4563\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: That in the face of peril, you, like Lothraxion, would lose yourself to wrath. Like I risk losing myself to the Void.\",\"timestamp\":1772561758,\"id\":\"s1_4564\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: I... understand. But I promise you that it will never happen. Not for me, and not for you.\",\"timestamp\":1772561770,\"id\":\"s1_4565\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: We're Windrunners, after all. No outside force has ever succeeded in telling us what to do.\",\"timestamp\":1772561777,\"id\":\"s1_4566\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Then let us save Silvermoon together. As Windrunners.\",\"timestamp\":1772561784,\"id\":\"s1_4567\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"BloodElf\",\"name\":\"Naramis-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Naramis-ConfrérieduThorium:364:GUILD:|h[|cfff48cbaNaramis|r]|h: On peut mettre combien de reroll dans la guilde ? Et aussi je peux récupérer mon rang svplease ? XD\",\"timestamp\":1772561808,\"id\":\"s1_4568\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PALADIN\",\"race\":\"LightforgedDraenei\",\"name\":\"Ellyoda-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Ellyoda-ConfrérieduThorium:366:GUILD:|h[|cfff48cbaEllyoda|r]|h: heyo\",\"timestamp\":1772561837,\"id\":\"s1_4569\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captain Garrick says: Be wary, we have to stop Lothraxion.\",\"timestamp\":1772561849,\"id\":\"s1_4570\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Meredy Huntswell says: Everyone get your buffs on.\",\"timestamp\":1772561851,\"id\":\"s1_4571\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Meredy Huntswell says: A mage table for all your summoned food needs.\",\"timestamp\":1772561854,\"id\":\"s1_4572\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Meredy Huntswell says: Check your adventure guide if you need more information about what we'll find here.\",\"timestamp\":1772561856,\"id\":\"s1_4573\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Alleria Windrunner yells: Lothraxion! Give up this foolishness. We have already won!\",\"timestamp\":1772561866,\"id\":\"s1_4574\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Arator yells: You put all of Silvermoon in danger. This isn't worth the risk!\",\"timestamp\":1772561872,\"id\":\"s1_4575\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Orc\",\"name\":\"Gabodémo-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Gabodémo-Dalaran|h[|cff8788eeGabodémo-Dalaran|r]|h a accompli le haut fait |cffffff00|Hachievement:61734:Player-1621-0BA8CD33:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Endgame]|h|r !\",\"timestamp\":1772561872,\"id\":\"s1_4576\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"WARLOCK\",\"race\":\"Orc\",\"name\":\"Gabodémo-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Gabodémo-Dalaran|h[|cff8788eeGabodémo-Dalaran|r]|h a accompli le haut fait |cffffff00|Hachievement:42328:Player-1621-0BA8CD33:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[One Warband Mentor: Midnight]|h|r !\",\"timestamp\":1772561872,\"id\":\"s1_4577\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: There seems to be a few pieces missing. We have to find them if we're going to stop Lothraxion!\",\"timestamp\":1772561878,\"id\":\"s1_4578\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"EVOKER\",\"race\":\"Dracthyr\",\"name\":\"Voltarynn-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Voltarynn-Dalaran:384:GUILD:|h[|cff33937fVoltarynn|r]|h: gg\",\"timestamp\":1772561907,\"id\":\"s1_4579\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"p