":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lothraxion\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lothraxion says: For the Light!\",\"timestamp\":1772150032,\"id\":\"s0_2320\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"VoidElf\",\"name\":\"Myrn-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Myrn-Archimonde|h[|cffaad372Myrn-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:62191:Player-1302-0CDAA8BD:1:2:27:26:4294967295:4294967295:4294967295:4294967295|h[Call of the Light]|h|r !\",\"timestamp\":1772150033,\"id\":\"s0_2321\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Commander Koruth Mountainfist\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Commander Koruth Mountainfist says: The Light offers respite! But ye must press on!\",\"timestamp\":1772150049,\"id\":\"s0_2322\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Commander Venel Lightblood\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Commander Venel Lightblood says: Keep going! Do not succumb to the darkness!\",\"timestamp\":1772150060,\"id\":\"s0_2323\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"General Amias Bellamy\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"General Amias Bellamy says: Forward! We will push back the shadows!\",\"timestamp\":1772150067,\"id\":\"s0_2324\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alonsus Faol\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alonsus Faol says: Hurry, Kvotheen! We need your help against that behemoth!\",\"timestamp\":1772150075,\"id\":\"s0_2325\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"High Exarch Turalyon says: Channel the Light from the weapons you recovered! Drive this monster back to the Void!\",\"timestamp\":1772150082,\"id\":\"s0_2326\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Lady Liadrin says: Turalyon! We must regroup at the Sunwell before it's too late!\",\"timestamp\":1772150201,\"id\":\"s0_2327\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"High Exarch Turalyon says: Damn it all! Vanguard, fall back!\",\"timestamp\":1772150206,\"id\":\"s0_2328\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Kvotheen! Mount up! Retreat to the Sunwell!\",\"timestamp\":1772150221,\"id\":\"s0_2329\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"Orc\",\"name\":\"Justhunt-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Justhunt-Ysondre|h[|cffaad372Justhunt-Ysondre|r]|h a accompli le haut fait |cffffff00|Hachievement:62273:Player-1335-