},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0,
},
["text"] = "|Hplayer:Kyoshika-KhazModan|h[|cfffff468Kyoshika-KhazModan|r]|h has earned the achievement |cffffff00|Hachievement:7860:Player-3690-0B89BBE6:1:2:24:26:4294967295:4294967295:4294967295:4294967295|h[We're Going to Need More Saddles]|h|r!",
["timestamp"] = 1771960314,
["id"] = "s0_1837",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Thaed Pyremaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Thaed Pyremaker says: Hold the line! Keep your strikes decisive, and your aim true! May the Flame guide you!",
["timestamp"] = 1771960378,
["id"] = "s0_1838",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Thaed Pyremaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Thaed Pyremaker says: The Sacred Flame blesses us with victory! But stay vigilant--the enemy will return to throw themselves upon our blades once more.",
