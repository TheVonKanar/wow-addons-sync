nfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Grodar-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Grodar-Archimonde:1161:RAID:|h[|cffc69b6dGrodar-Archimonde|r]|h: Grodar a fait 55 pour : |cnIQ4:|Hitem:249277::::::::90:72::3:3:6652:13333:12787:1:28:3607:::::|h[Jugement final de Bellamy]|h|r\",\"id\":\"s8_4900\",\"timestamp\":1774297810},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: After what happened with Turalyon and Arator... I can see how Alleria would struggle to maintain control. I doubt I'd be able to, if it were me.\",\"id\":\"s8_4901\",\"timestamp\":1774297813},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Mother!\",\"id\":\"s8_4902\",\"timestamp\":1774297823},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: Still, should Xal'atath succeed, and Alleria loses her grip on the dark naaru within her... I fear all may be lost.\",\"id\":\"s8_4903\",\"timestamp\":1774297823},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"High Exarch Turalyon yells: Alleria!\",\"id\":\"s8_4904\",\"timestamp\":1774297825},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Xal'atath yells: How touching. Your family has come to say goodbye.\",\"id\":\"s8_4905\",\"timestamp\":1774297827},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Xal'atath yells: Ah, and my favorite champions as well! I was afraid you might miss this.\",\"id\":\"s8_4906\",\"timestamp\":1774297832},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Justhunt\",\"sex\":2},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Justhunt places a cozy Quel'dorei Medley for everyone to enjoy!\",\"id\":\"s8_4907\",\"timestamp\":1774297836},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Alleria Windrunner grimaces in pain.\",\"id\":\"s8_4908\",\"timestamp\":1774297841},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Sânghr-Hyjal:1172:RAID:|h[|cff00ff98Sânghr|r]|h: Sânghr a fait 31 pour : |cnIQ4:|Hitem:249333::::::::90:269::3:4:6652:13577:13333:12787:1:28:3607:::::|h[Spallières en lumécorce fleurie]|h|r\",\"id\":\"s8_4909\",\"timestamp\":1774297842},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: What are you doing to her?!\",\"id\":\"s8_4910\",\"timestamp\":1774297842},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Xal'atath\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Xal'atath yells: Keeping my promise, of course. Taking everything she loves. Leaving her with nothing but the Void.\",\"id\":\"s8_4911\",\"timestamp\":1774297844},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_LEADER\",\"type\":\"RAID_LEADER\"},\"color\":{\"b\":0.03921568766236305,\"g\":0.2784313857555389,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid Leader]|h |Hplayer:Øskytankul-Archimonde:1179:RAID:|h[|cff00ff98Øskytankul-Archimonde|r]|h: Ellyoda-ConfrérieduThorium a reçu |cnIQ4:|Hitem:249358::::::::90:268::3:3:13347:13338:13333:1:28:3607:::::|h[Cœur-de-néant fanatique forgé dans le Vide]|h|r pour BIS !\",\"id\":\"s8_4912\",\"timestamp\":1774297875},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_LEADER\",\"type\":\"RAID_LEADER\"},\"color\":{\"b\":0.03921568766236305,\"g\":0.2784313857555389,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid Leader]|h |Hplayer:Øskytankul-Archimonde:1181:RAID:|h[|cff00ff98Øskytankul-Archimonde|r]|h: Sânghr-Hyjal a reçu |cnIQ4:|Hitem:249333::::::::90:268::3:4:6652:13577:13333:12787:1:28:3607:::::|h[Spallières en lumécorce fleurie]|h|r pour Légère amél. / double spé !\",\"id\":\"s8_4913\",\"timestamp\":1774297883},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_RAID_LEADER\",\"type\":\"RAID_LEADER\