},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen-Hyjal",
["sex"] = 2,
