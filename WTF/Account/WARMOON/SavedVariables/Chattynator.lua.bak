},
["text"] = "You receive loot: |cnIQ1:|Hitem:242640::::::::90:263:::::::::|h[Plant Protein]|h|rx2",
["timestamp"] = 1772660701,
["id"] = "s3_2938",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kuri",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kuri says: I'll stay out here and, uh, keep watch. You call out when you find a bunch of skyglass, and I'll come running!",
["timestamp"] = 1772660716,
["id"] = "s3_2939",
},
