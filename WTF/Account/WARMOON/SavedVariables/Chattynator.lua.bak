["g"] = 1,
["r"] = 1,
},
["text"] = "Allari the Souleater says: Be warned, Darkstrider. The path of a demon hunter is one of pain and sacrifice.",
["id"] = "s0_1017",
["timestamp"] = 1771505476,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Leona Darkstrider",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Leona Darkstrider says: I am prepared to meet the challenges that lie before me.",
["id"] = "s0_1018",
["timestamp"] = 1771505482,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Allari the Souleater",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Allari the Souleater says: Show me the precision of your attacks. If you can't focus your hatred, then the demon within you has already won.",
["id"] = "s0_1019",
["timestamp"] = 1771505620,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Leona Darkstrider",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Leona Darkstrider says: I'll carve out those pieces like I was holding a scalpel.",
["id"] = "s0_1020",
["timestamp"] = 1771505627,
},
