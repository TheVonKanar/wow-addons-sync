["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Jeeves says: If you'll excuse me, I'm afraid I have other business I must attend to.  Please call on me again in the future.",
["id"] = "s0_2541",
["timestamp"] = 1772180812,
},
