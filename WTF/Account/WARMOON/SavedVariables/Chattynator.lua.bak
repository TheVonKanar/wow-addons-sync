["timestamp"] = 1772573920,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Torundo the Grizzled",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Torundo the Grizzled says: No matter how many we strike down, de enemy forces keep stormin' into de city.",
["id"] = "s2_2897",
["timestamp"] = 1772573929,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Elder Doru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Elder Doru says: You complain like an old pango. Sit there and rest your bones a minute before leavin' de barrier again.",
["id"] = "s2_2898",
["timestamp"] = 1772573935,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Torundo the Grizzled",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Torundo the Grizzled says: Stay vigilant, Kvotheen. De echoes are weak, but dey'll swarm you if you aren't careful.",
["id"] = "s2_2899",
["timestamp"] = 1772573962,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Elder Doru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Elder Doru says: Stop talkin' with your arms, you oaf! Can't heal you if you keep fidgetin'!",
["id"] = "s2_2900",
["timestamp"] = 1772573968,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Elder Vu'lona",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Elder Vu'lona says: Thank you, hash'ura. And pass our appreciation on to Doru as well.",
["id"] = "s2_2901",
["timestamp"] = 1772573974,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["race"] = "Human",
["class"] = "ROGUE",
["name"] = "Mangousto-Hyjal",
["sex"] = 2,
},
["event"] = "CHAT_MSG_GUILD_ACHIEVEMENT",
["type"] = "GUILD_ACHIEVEMENT",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 1,
["r"] = 0.250980406999588,
},
["text"] = "|Hplayer:Mangousto-Hyjal|h[|cfffff468Mangousto|r]|h a accompli le haut fait |cffffff00|Hachievement:41805:Player-1390-06DC4442:1:3:3:26:4294967295:4294967295:4294967295:4294967295|h[Arator's Journey]|h|r !",
["id"] = "s2_2902",
["timestamp"] = 1772573976,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Elder Vu'lona",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Elder Vu'lona says: You should know, de Shadowpine's resourcefulness is unmatched. We could survive and protect de shrine for years if need be.",
["id"] = "s2_2903",
["timestamp"] = 1772573980,
},
