um\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Bastett-ConfrérieduThorium receives loot: |cnIQ0:|Hitem:121361::::::::90:263::23:1:6656:2:9:90:28:3025:::::|h[Rust-Encrusted Coif]|h|r.\",\"timestamp\":1774304649,\"id\":\"s9_2697\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Alleria Windrunner yells: Champions! Over Here!\",\"timestamp\":1774304680,\"id\":\"s9_2698\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Øskytankul-Archimonde receives loot: |cnIQ4:|Hitem:151336::::::::90:263::23:6:12785:13439:6652:12667:13577:12699:1:28:3025:::::|h[Voidlashed Hood]|h|r.\",\"timestamp\":1774304680,\"id\":\"s9_2699\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:151567::::::::90:263:::::::::|h[Lightweave Cloth]|h|rx2\",\"timestamp\":1774304680,\"id\":\"s9_2700\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 26 Gold, 1 Silver, 20 Copper (+52 Silver, 1 Copper)\",\"timestamp\":1774304681,\"id\":\"s9_2701\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Alleria Windrunner yells: Follow me!\",\"timestamp\":1774304683,\"id\":\"s9_2702\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: The Shadowguard is building up its presence near the temple.\",\"timestamp\":1774304686,\"id\":\"s9_2703\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: Disrupting their efforts would benefit us all. Also, their commander here has a particular item that would be useful to me.\",\"timestamp\":1774304691,\"id\":\"s9_2704\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Alleria Windrunner yells: Figure out their motives... and put a stop to their efforts.\",\"timestamp\":1774304700,\"id\":\"s9_2705\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Conversation Controller\"},\"event\":\"CHAT_MSG_RAID_BOSS_WHISPER\",\"type\":\"MONSTER_BOSS_WHISPER\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"|TInterface\\\\ICONS\\\\SPELL_WARLOCK_DEMONICPORTAL_PURPLE:20|tVoid tears appear in nearby areas!\",\"timestamp\":1774304706,\"id\":\"s9_2706\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Void Rift\"},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"r\":1,\"g\":0.8666667342185974,\"b\":0},\"text\":\"|TInterface\\\\ICONS\\\\INV_Ability_VoidweaverPriest_EntropicRift.BLP:20|t The Rift Warden is out of range - the rift becomes|cFFFF0000|Hspell:1264431|h[Destabilized]|h|r!\",\"timestamp\":1774304742,\"id\":\"s9_2707\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Saprish\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Saprish says: We will not be pushed out! Bring in more forces from the Void to deal with these intruders!\",\"timestamp\":1774304761,\"id\":\"s9_2708\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"HighmountainTauren\",\"name\":\"Bastett-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Bastett-ConfrérieduThorium receives loot: |cnIQ0:|Hitem:121345::::::::90:263::23:1:6656:2:9:90:28:3025:::::|h[Weatherworn Belt]|h|r.\",\"timestamp\":1774304772,\"id\":\"s9_2709\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"HighmountainTauren\",\"name\":\"Bastett-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Bastett-ConfrérieduThorium receives loot: |cnIQ0:|Hitem:132204::::::::90:263:::::::::|h[Sticky Volatile Substance]|h|r.\",\"timestamp\":1774304772,\"id\":\"s9_2710\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"BloodElf\",\"name\":\"Marchegland-Archimonde\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Marchegland-Archimonde receives loot: |cnIQ0:|Hitem:132223::::::::90:263:::::::::|h[Elemental Droplet]|h|r.\",\"timestamp\":1774304818,\"id\":\"s9_2711\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Saprish\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Saprish yells: It seems this nuisance requires a more personal touch. I shall handle you myself!\",\"timestamp\":1774304855,\"id\":\"s9_2712\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Øskytankul-Archimonde receives loot: |cnIQ4:|Hitem:151307::::::::90:263::23:4:12785:13439:6652:12699:1:28:3025:::::|h[Void Stalker's Contract]|h|r.\",\"timestamp\":1774304932,\"id\":\"s9_2713\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 13 Gold, 67 Silver, 99 Copper (+27 Silver, 35 Copper)\",\"timestamp\":1774304934,\"id\":\"s9_2714\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: Thank you for removing the obstacles between me and this staff, heroes.\",\"timestamp\":1774304936,\"id\":\"s9_2715\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: Yes, this will do nicely. You'll find their viceroy near the entrance to the temple, feebly trying to break in.\",\"timestamp\":1774304942,\"id\":\"s9_2716\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: Eliminating him will give us an opportunity to get in ourselves.\",\"timestamp\":1774304954,\"id\":\"s9_2717\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: I'll see to opening the way once he's taken care of.\",\"timestamp\":1774304962,\"id\":\"s9_2718\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"BloodElf\",\"name\":\"Marchegland-Archimonde\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Marchegland-Archimonde receives loot: |cnIQ1:|Hitem:151567::::::::90:263:::::::::|h[Lightweave Cloth]|h|rx4.\",\"timestamp\":1774305030,\"id\":\"s9_2719\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 7 Gold, 74 Silver, 77 Copper (+15 Silver, 49 Copper)\",\"timestamp\":1774305030,\"id\":\"s9_2720\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Viceroy Nezhar\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Viceroy Nezhar yells: No! The darkness... was to be mine...\",\"timestamp\":1774305127,\"id\":\"s9_2721\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"BloodElf\",\"name\":\"Marchegland-Archimonde\",\"sex\":3},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"Marchegland-Archimonde receives loot: |cnIQ4:|Hitem:258524::::::::90:263::23:4:12785:13439:6652:12701:1:28:3025:::::|h[Grips of the Dark Viceroy]|h|r.\",\"timestamp\":1774305129,\"id\":\"s9_2722\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:152204::::::::90:263:::::::::|h[Glowing Key Fragment]|h|r\",\"timestamp\":1774305129,\"id\":\"s9_2723\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 19 Gold, 32 Silver, 97 Copper (+38 Silver, 65 Copper)\",\"timestamp\":1774305130,\"id\":\"s9_2724\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: I sense great despair emanating from within. L'ura...\",\"timestamp\":1774305131,\"id\":\"s9_2725\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: Yes, the naaru. We must get inside. Alleria, the skills you have learned can open the way.\",\"timestamp\":1774305141,\"id\":\"s9_2726\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: Such chaos... such anguish. I have never sensed anything like it before.\",\"timestamp\":1774305152,\"id\":\"s9_2727\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Alleria Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Alleria Windrunner says: The way is open! Hurry, heroes!\",\"timestamp\":1774305155,\"id\":\"s9_2728\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: It is rare that a naaru falls into Void this way. The few cases I know of have occurred when mortals were involved. What fascinating implications...\",\"timestamp\":1774305160,\"id\":\"s9_2729\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Locus-Walker\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Locus-Walker says: Such musings can wait, though. This entity must die.\",\"timestamp\":1774305174,\"id\":\"s9_2730\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"HighmountainTauren\",\"name\":\"Bastett-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Bastett-ConfrérieduThorium|h[|cffff7c0aBastett-ConfrérieduThorium|r]|h a accompli le haut fait |cffffff00|Hachievement:12007:Player-1127-0B2B825D:1:3:23:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Seat of the Triumvirate]|h|r !\",\"timestamp\":1774305284,\"id\":\"s9_2731\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"HighmountainTauren\",\"name\":\"Bastett-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Bastett-ConfrérieduThorium|h[|cffff7c0aBastett-ConfrérieduThorium|r]|h has earned the achievement |cffffff00|Hachievement:12007:Player-1127-0B2B825D:1:3:23:26:4294967295:4294967295:4294967295:4294967295|h[Heroic: Seat of the Triumvirate]|h|r!\",\"timestamp\":1774305284,\"id\":\"s9_2732\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"HighmountainTauren\",\"name\":\"Bastett-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Bastett-ConfrérieduThorium|h[|cffff