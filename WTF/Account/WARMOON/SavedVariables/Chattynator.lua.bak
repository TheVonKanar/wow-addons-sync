["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wa'kani says: Good work, Kvotheen! That should stall de snakes.",
["id"] = "s21_3625",
["timestamp"] = 1788037361,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Wa'kani",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
