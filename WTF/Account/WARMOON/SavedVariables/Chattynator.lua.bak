},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0,
},
["text"] = "You loot 95 Silver, 89 Copper (+1 Silver, 91 Copper)",
["timestamp"] = 1772226094,
["id"] = "s0_3324",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Amani Feller",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
