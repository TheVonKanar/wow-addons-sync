6315},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 2 Gold, 57 Silver, 71 Copper (+5 Silver, 15 Copper)\",\"id\":\"s0_4802\",\"timestamp\":1772296317},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"King Mrgl-Mrgl\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"King Mrgl-Mrgl says: The hero returns... victorious, yes? Please say yes. I am tired of standing here.\",\"id\":\"s0_4803\",\"timestamp\":1772296342},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:264473::::::::85:263::11:4:13573:13613:13615:6652:2:9:85:28:3086:::::|h[Loa Impostor's Tidegrips]|h|r\",\"id\":\"s0_4804\",\"timestamp\":1772296350},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"King Mrgl-Mrgl\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"King Mrgl-Mrgl says: Triumphant hero! You have slain the Loa of the Deep, proving that I, King Mrgl-Mrgl, am the true Loa of Murlocs!\",\"id\":\"s0_4805\",\"timestamp\":1772296352},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"King Mrgl-Mrgl\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"King Mrgl-Mrgl says: Now that this threat has been dealt with, I must leave you, my children! Go forth and reclaim your land!\",\"id\":\"s0_4806\",\"timestamp\":1772296357},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Murloc Worshipper\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\