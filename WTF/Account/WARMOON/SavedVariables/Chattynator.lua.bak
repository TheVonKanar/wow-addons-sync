},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Elder Doru says: Throw your sympathies aside, Kvotheen.",
["id"] = "s2_2933",
["timestamp"] = 1772574143,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Elder Doru",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Elder Doru says: None of them are your actual companions.",
["id"] = "s2_2934",
["timestamp"] = 1772574146,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zungam",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zungam says: The least I can be doin' is stickin' around to offer my services!",
["id"] = "s2_2935",
["timestamp"] = 1772574151,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zungam",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zungam says: I never gon' forgive dat Griftah for sendin' me out here...",
["id"] = "s2_2936",
["timestamp"] = 1772574157,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
