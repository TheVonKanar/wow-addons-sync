["id"] = "s2_4546",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Decimus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Decimus says: Speak to me when you are ready. I am eager to impress you.",
["timestamp"] = 1772653389,
["id"] = "s2_4547",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Decimus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Decimus says: This is a delicate art. Your labor will imbue the blade with the energy of your very soul.",
["timestamp"] = 1772653399,
["id"] = "s2_4548",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Decimus",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Decimus says: It will be an exquisite weapon for you. Now, follow my directions precisely.",
["timestamp"] = 1772653404,
["id"] = "s2_4549",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
