\":1772211976,\"id\":\"s0_2624\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260675::::::::80:263:::::::::|h[Luminous Seeds]|h|r\",\"timestamp\":1772211976,\"id\":\"s0_2625\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kylia Solguard\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kylia Solguard says: Did you hear that Duskflight Exports is docked in port currently?\",\"timestamp\":1772211987,\"id\":\"s0_2626\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Leoron Summersong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Leoron Summersong says: Best not get involved with them. Their lips are looser than Lor'themar's coinpurse.\",\"timestamp\":1772211991,\"id\":\"s0_2627\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kylia Solguard\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kylia Solguard says: Mmm. I'd hate for them to indulge in idle gossip at our expense.\",\"timestamp\":1772211997,\"id\":\"s0_2628\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260670::::::::80:263:::::::::|h[Bloody Broken Beak]|h|r\",\"timestamp\":1772211998,\"id\":\"s0_2629\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260653::::::::80:263:::::::::|h[Large Lightbloom Fungi]|h|rx2\",\"timestamp\":1772211998,\"id\":\"s0_2630\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242640::::::::80:263:::::::::|h[Plant Protein]|h|rx6\",\"timestamp\":1772211998,\"id\":\"s0_2631\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vyean Lightstar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vyean Lightstar says: Ever met a Tideborne crew that wasn't drowning in secrets?\",\"timestamp\":1772212022,\"id\":\"s0_2632\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ineilian Crimsonpost\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Ineilian Crimsonpost says: Their books are clean, but their dealings stink worse than bilge water.\",\"timestamp\":1772212026,\"id\":\"s0_2633\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vyean Lightstar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vyean Lightstar says: Funny how their cargo vanishes the moment someone starts asking.\",\"timestamp\":1772212032,\"id\":\"s0_2634\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Aleeta Dawnstone\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Aleeta Dawnstone says: Please save my kitty, mister paladin!\",\"timestamp\":1772212040,\"id\":\"s0_2635\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Aleeta Dawnstone\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Aleeta Dawnstone says: Come down kitty!\",\"timestamp\":1772212045,\"id\":\"s0_2636\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: There we are--keep him close now!\",\"timestamp\":1772212047,\"id\":\"s0_2637\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Ugh! It looks--and smells--like the local pets were marking their territory. They're obviously distressed.\",\"timestamp\":1772212070,\"id\":\"s0_2638\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: Perhaps this sudden growth is tied to the empowerment of the Sunwell. I think I was right--this could be used to help the Vanguard.\",\"timestamp\":1772212079,\"id\":\"s0_2639\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: That creature must have come from the Lightbloom! We should let the Magistrix know.\",\"timestamp\":1772212096,\"id\":\"s0_2640\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: This nest... it's being choked by the Lightbloom growth. Let's fix this.\",\"timestamp\":1772212111,\"id\":\"s0_2641\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260643::::::::80:263:::::::::|h[Pile of Feathers]|h|r\",\"timestamp\":1772212116,\"id\":\"s0_2642\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::80:263:::::::::|h[Practically Pork]|h|r\",\"timestamp\":1772212116,\"id\":\"s0_2643\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Elenda Morrowflare\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Elenda Morrowflare says: Did you read the note? It seems we have another... engagement to attend to.\",\"timestamp\":1772212134,\"id\":\"s0_2644\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Drair Somberfall\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Drair Somberfall says: Indeed. We must return to the docks swiftly, before the light fades.\",\"timestamp\":1772212139,\"id\":\"s0_2645\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Elenda Morrowflare\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Elenda Morrowflare says: Quite so. The less we dawdle, the better for all involved.\",\"timestamp\":1772212144,\"id\":\"s0_2646\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:237722::::::::80:263:::::::::|h[Abandoned Note]|h|r\",\"timestamp\":1772212157,\"id\":\"s0_2647\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260653::::::::80:263:::::::::|h[Large Lightbloom Fungi]|h|rx2\",\"timestamp\":1772212188,\"id\":\"s0_2648\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242640::::::::80:263:::::::::|h[Plant Protein]|h|rx3\",\"timestamp\":1772212188,\"id\":\"s0_2649\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260670::::::::80:263:::::::::|h[Bloody Broken Beak]|h|r\",\"timestamp\":1772212188,\"id\":\"s0_2650\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Arator says: The nearest Lightbloom is nowhere near the village. How did the growth get all the way out here?\",\"timestamp\":1772212191,\"id\":\"s0_2651\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":