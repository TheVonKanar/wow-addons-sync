6497},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:213240::::::::87:263:::::::::|h[Decorated Truffle]|h|r\",\"id\":\"s1_3689\",\"timestamp\":1772386498},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:249646::::::::87:263::125:2:13564:13578:2:9:87:28:6009:::::|h[Elder Mossclogs]|h|r\",\"id\":\"s1_3690\",\"timestamp\":1772386498},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Øskytankul-Archimonde:767:GUILD:|h[|cff00ff98Øskytankul-Archimonde|r]|h: dans 29h l'initiative Dwalgo\",\"id\":\"s1_3691\",\"timestamp\":1772386505},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Dwarf\",\"class\":\"HUNTER\",\"name\":\"Dwalgo-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dwalgo-Hyjal:770:GUILD:|h[|cffaad372Dwalgo|r]|h: merci pour l'info!\",\"id\":\"s1_3692\",\"timestamp\":1772386556},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"SHAMAN\",\"name\":\"Khennaï-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Khennaï-Hyjal|h[|cff0070ddKhennaï|r]|h a accompli le haut fait |cffffff00|Hachievement:61734:Player-1390-0CEA7E58:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Delves: Endgame]|h|r !\",\"id\":\"s1_3693\",\"timestamp\":1772386605},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"SHAMAN\",\"name\":\"Khennaï-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Khennaï-Hyjal|h[|cff0070ddKhennaï|r]|h a accompli le haut fait |cffffff00|Hachievement:42328:Player-1390-0CEA7E58:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[One Warband Mentor: Midnight]|h|r !\",\"id\":\"s1_3694\",\"timestamp\":1772386605},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Human\",\"class\":\"MONK\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Sânghr-Hyjal:773:GUILD:|h[|cff00ff98Sânghr|r]|h: cest looooooooooooong le dernier lvl\",\"id\":\"s1_3695\",\"timestamp\":1772386631},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hagar says: Ah, you're awake. Welcome to Har'mara.\",\"id\":\"s1_3696\",\"timestamp\":1772386658},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:249620::::::::87:263::127:3:13648:6652:13668:2:9:87:28:3087:::::|h[Vibrant Wilderloop]|h|r\",\"id\":\"s1_3697\",\"timestamp\":1772386695},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hagar says: Come below when you're recovered. The others await.\",\"id\":\"s1_3698\",\"timestamp\":1772386703},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: Here in Har'mara, you will see a rare glimpse of the rutaani and fungarians at peace.\",\"id\":\"s1_3699\",\"timestamp\":1772386712},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hagar says: If rutaani march on your home, then perhaps their kin know of it. You will find some here.\",\"id\":\"s1_3700\",\"timestamp\":1772386754},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ1:|Hitem:238024::::::::87:263:::::::::|h[Watering Can]|h|r\",\"id\":\"s1_3701\",\"timestamp\":1772386781},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hagar says: Most rutaani are very territorial. This is one of the few places we interact with them in peace.\",\"id\":\"s1_3702\",\"timestamp\":1772386781},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Halduron Brightwing says: It is strange to see friendly rutaani.\",\"id\":\"s1_3703\",\"timestamp\":1772386808},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hungry Rotling\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hungry Rotling says: Finally! What took so long?\",\"id\":\"s1_3704\",\"timestamp\":1772386824},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:238471::::::::87:263::::1:28:3615:::::|h[Lightbloom Root]|h|r\",\"id\":\"s1_3705\",\"timestamp\":1772386834},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:251881::::::::87:263:::::::::|h[Small Pile of Luminous Dust]|h|r\",\"id\":\"s1_3706\",\"timestamp\":1772386844},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ2:|Hcurrency:3385:0|h[Luminous Dust]|h|rx1\",\"id\":\"s1_3707\",\"timestamp\":1772386845},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Rizam\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Rizam says: This one has seen many blooms. To bloom is good, yes?\",\"id\":\"s1_3708\",\"timestamp\":1772386865},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Øskytankul-Archimonde|h[|cff00ff98Øskytankul-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:62269:Player-1302-0D33F4E1:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Altar of Blessings: Amani Curious]|h|r !\",\"id\":\"s1_3709\",\"timestamp\":1772386900},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Teetem\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Teetem says: No Light-bloom. This stranger should offer trade or leave.\",\"id\":\"s1_3710\",\"timestamp\":1772386917},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hungry Rotling\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hungry Rotling says: Yum yum time!\",\"id\":\"s1_3711\",\"timestamp\":1772386938},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ4:|Hitem:238534::::::::87:263::::1:28:3615:::::|h[Vial of Rootlands Oddities]|h|r\",\"id\":\"s1_3712\",\"timestamp\":1772386975},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hungry Rotling\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hungry Rotling says: Good! So hungry we could eat a potatoad.\",\"id\":\"s1_3713\",\"timestamp\":1772386994},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Eonka\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Eonka says: This one has not seen this Light-bloom. But the Rift protects us, always.\",\"id\":\"s1_3714\",\"timestamp\":1772386999},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Keem\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Keem says: All rutaani bloom in the light. Only the spore-kin bloom in the dark.\",\"id\":\"s1_3715\",\"timestamp\":1772387011},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hungry Rotling\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hungry Rotling says: Finally! What took so long?\",\"id\":\"s1_3716\",\"timestamp\":1772387061},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meeka\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meeka says: No, this one has not seen rutaani behaving that way.\",\"id\":\"s1_3717\",\"timestamp\":1772387070},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:262614::::::::87:263::11::1:28:3087:::::|h[Harandar Runestone]|h|r\",\"id\":\"s1_3718\",\"timestamp\":1772387091},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:256188::::::::87:263::11:2:13573:6652:2:9:87:28:3087:::::|h[Spore-Touched Bludgeon]|h|r\",\"id\":\"s1_3719\",\"timestamp\":1772387100},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Hagar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Hagar says: Koozat is normally very calm, but can be quite dangerous when agitated. Be careful, Kvotheen.\",\"id\":\"s1_3720\",\"timestamp\":1772387115},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Powdercap\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Powdercap says: Dead! And Koozat not only one gone mad!\",\"id\":\"s1_3721\",\"timestamp\":1772387126},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Orweyna says: We will remain here to guard Hagar and the others.\",\"id\":\"s1_3722\",\"timestamp\":1772387179},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Halduron Brightwing\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Halduron Brightwing says: If these blooms take root, Har'mara will be destroyed!\",\"id\":\"s1_3723\",\"timestamp\":1772387195},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3150:0|h[Midnight Alchemy Knowledge]|h|rx3\",\"id\":\"s1_3724\",\"timestamp\":1772387202},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_CURRENCY\",\"type\":\"CURRENCY\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive currency: |cnIQ3:|Hcurrency:3256:0|h[Artisan Alchemist's Moxie]|h|rx15\",\"id\":\"s1_3725\",\"timestamp\":1772387202},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 3 Gold, 41 Silver, 24 Copper (+6 Silv