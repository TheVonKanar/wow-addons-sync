},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Alleria Windrunner says: One path leads towards where the Shadowguard produce arcane wrappings. The other, to the mage who binds them.",
["id"] = "s0_380",
["timestamp"] = 1770063081,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Xal'atath",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Xal'atath says: The Shadowguard? Do what you will. I have my own plans for the Manaforge.",
