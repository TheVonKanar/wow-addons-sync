},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:236951::::::::87:263:::::::::|h[Mote of Wild Magic]|h|rx2\",\"timestamp\":1772327921,\"id\":\"s1_3221\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260309::::::::87:263:::::::::|h[Thrumming Plant Matter]|h|r\",\"timestamp\":1772327923,\"id\":\"s1_3222\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:236951::::::::87:263:::::::::|h[Mote of Wild Magic]|h|rx2\",\"timestamp\":1772327923,\"id\":\"s1_3223\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260309::::::::87:263:::::::::|h[Thrumming Plant Matter]|h|r\",\"timestamp\":1772327925,\"id\":\"s1_3224\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:236951::::::::87:263:::::::::|h[Mote of Wild Magic]|h|r\",\"timestamp\":1772327925,\"id\":\"s1_3225\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260309::::::::87:263:::::::::|h[Thrumming Plant Matter]|h|r\",\"timestamp\":1772327927,\"id\":\"s1_3226\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:236951::::::::87:263:::::::::|h[Mote of Wild Magic]|h|r\",\"timestamp\":1772327927,\"id\":\"s1_3227\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dordok-Ysondre:3:GUILD:|h[|cffaad372Dordok-Ysondre|r]|h: yop !\",\"id\":\"s1_3228\",\"timestamp\":1772356455},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Kvotheen-Hyjal:4:GUILD:|h[|cff0070ddKvotheen|r]|h: yooo\",\"id\":\"s1_3229\",\"timestamp\":1772356467},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: De blood of those who died today will become de flood that washes de invaders from our lands!\",\"id\":\"s1_3230\",\"timestamp\":1772356510},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: So many dead... What have you done, Jan?\",\"id\":\"s1_3231\",\"timestamp\":1772356521},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Worgen\",\"class\":\"MAGE\",\"name\":\"Pauleau-Dalaran\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Pauleau-Dalaran|h[|cff3fc7ebPauleau-Dalaran|r]|h a accompli le haut fait |cffffff00|Hachievement:40860:Player-1621-0BA6CEE5:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[A Star of Dorn]|h|r !\",\"id\":\"s1_3232\",\"timestamp\":1772356534},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Sister, you return! While you were prostrating yourself before de loa, I secured real power!\",\"id\":\"s1_3233\",\"timestamp\":1772356540},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: And how many warriors did you sacrifice to take this lightwood back from de cult?\",\"id\":\"s1_3234\",\"timestamp\":1772356550},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jan says: Sacrifice? They are heroes. Heroes that fell as true Amani, reclaiming de lightwood at Atal'Aman.\",\"id\":\"s1_3235\",\"timestamp\":1772356557},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: And they are dead just de same, Jan!\",\"id\":\"s1_3236\",\"timestamp\":1772356568},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Warriors, you are relieved. Go be with your families. We will care for de dead.\",\"id\":\"s1_3237\",\"timestamp\":1772356572},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: And I swear if you do somethin' stupid while I go to Nalorakk, I'll cut off your head myself.\",\"id\":\"s1_3238\",\"timestamp\":1772356580},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jan\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Zul'jan scowls at Zul'jarra.\",\"id\":\"s1_3239\",\"timestamp\":1772356589},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MONK\",\"name\":\"Disyxoine-KhazModan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Disyxoine-KhazModan|h[|cff00ff98Disyxoine-KhazModan|r]|h a accompli le haut fait |cffffff00|Hachievement:41806:Player-3690-0BA7BEA3:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Breaching the Voidstorm]|h|r !\",\"id\":\"s1_3240\",\"timestamp\":1772356610},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"MONK\",\"name\":\"Disyxoine-KhazModan\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Disyxoine-KhazModan|h[|cff00ff98Disyxoine-KhazModan|r]|h a accompli le haut fait |cffffff00|Hachievement:42045:Player-3690-0BA7BEA3:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r !\",\"id\":\"s1_3241\",\"timestamp\":1772356610},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive item: |cnIQ2:|Hitem:264481::::::::87:263::11::1:28:3086:::::|h[Earthhide Amani Tapestry]|h|r\",\"id\":\"s1_3242\",\"timestamp\":1772356627},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Are you sure your brother will follow your orders?\",\"id\":\"s1_3243\",\"timestamp\":1772356659},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: We have no time to worry about Zul'jan. Our focus must be on Nalorakk. Let's go.\",\"id\":\"s1_3244\",\"timestamp\":1772356664},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:236761::::::::87:263::::1:38:13:::::|h[Tranquility Bloom |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2\",\"id\":\"s1_3245\",\"timestamp\":1772356674},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dordok-Ysondre:37:GUILD:|h[|cffaad372Dordok-Ysondre|r]|h: PTIN!\",\"id\":\"s1_3246\",\"timestamp\":1772356694},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dordok-Ysondre:38:GUILD:|h[|cffaad372Dordok-Ysondre|r]|h: IL ON REPARER LE JEUX CETTE NUIT !\",\"id\":\"s1_3247\",\"timestamp\":1772356714},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: On my life, Lilaju. With Nalorakk's blessin', I will rid Zul'Aman of all dat threaten us.\",\"id\":\"s1_3248\",\"timestamp\":1772356729},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lilaju\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lilaju says: Fine. To commune with de sleepin' Loa of War, ya must sit at his fire. But all that have did not come back.\",\"id\":\"s1_3249\",\"timestamp\":1772356737},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lilaju\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lilaju says: I hope ya be successful. But I wouldn't lose sleep if he eats ya face off.\",\"id\":\"s1_3250\",\"timestamp\":1772356749},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"NightElf\",\"class\":\"HUNTER\",\"name\":\"Aramasu-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Aramasu-Hyjal:49:GUILD:|h[|cffaad372Aramasu|r]|h: il ete cassé ?\",\"id\":\"s1_3251\",\"timestamp\":1772356768},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Watching you go through Jan'alai's trial was unsettling. Are you well?\",\"id\":\"s1_3252\",\"timestamp\":1772356780},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: I am fine. I feel as if a weight has been lifted from me. But another's takin' its place.\",\"id\":\"s1_3253\",\"timestamp\":1772356786},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dordok-Ysondre:54:GUILD:|h[|cffaad372Dordok-Ysondre|r]|h: oui\",\"id\":\"s1_3254\",\"timestamp\":1772356791},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: De last trial is all we have left. Or is it? What makes a hash'ey? Will I be able to help my people?\",\"id\":\"s1_3255\",\"timestamp\":1772356793},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: I... cannot say. I do not know.\",\"id\":\"s1_3256\",\"timestamp\":1772356803},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dordok-Ysondre:57:GUILD:|h[|cffaad372Dordok-Ysondre|r]|h: plein de hf que tu pouvais pas faire\",\"id\":\"s1_3257\",\"timestamp\":1772356803},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: But spiritual journeys, taken in earnest, are worthwhile whether they result in success or failure.\",\"id\":\"s1_3258\",\"timestamp\":1772356808},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: I have the Light. Coming to it with a sense of entitlement--that was my mistake.\",\"id\":\"s1_3259\",\"timestamp\":1772356816},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: But when I came to the Light in my darkest hour with good intentions, the Light was there for me.\",\"id\":\"s1_3260\",\"timestamp\":1772356823},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dordok-Ysondre|h[|cffaad372Dordok-Ysondre|r]|h a accompli le haut fait |cffffff00|Hachievement:61576:Player-1335-06882EAF:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Eversong Woods Glyph Hunter]|h|r !\",\"id\":\"s1_3261\",\"timestamp\":1772356829},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Dordok-Ysondre|h[|cffaad372Dordok-Ysondre|r]|h a accompli le haut fait |cffffff00|Hachievement:61584:Player-1335-06882EAF:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Midnight Glyph Hunter]|h|r !\",\"id\":\"s1_3262\",\"timestamp\":1772356829},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Your motivations are good. Now, if you could work on your attitude.\",\"id\":\"s1_3263\",\"timestamp\":1772356830},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"HUNTER\",\"name\":\"Dordok-Ysondre\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Dordok-Ysondre:64:GUILD:|h[|cffaad372Dordok-Ysondre|r]|h: genre lui\",\"id\":\"s1_3264\",\"timestamp\":1772356835},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Attitude? You don't think Nalorakk will take kindly to me walkin' up and threatenin' him with my axe?\",\"id\":\"s1_3265\",\"timestamp\":1772356837},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Liadrin says: Perhaps. But I do not think he would like to be formally greeted by an uppity, \\\"gokinye\\\" elf either.\",\"id\":\"s1_3266\",\"timestamp\":1772356845},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Ha ha ha! Thank you, Liadrin. I do not think I would have made it dis far without you. Without both my hash'ura.\",\"id\":\"s1_3267\",\"timestamp\":1772356853},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-1390-09230B89:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"id\":\"s1_3268\",\"timestamp\":1772356887},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:61856:Player-1390-09230B89:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Explore Zul'Aman]|h|r!\",\"id\":\"s1_3269\",\"timestamp\":1772356887},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: Get ready. We're here to support Zul'Jarra.\",\"id\":\"s1_3270\",\"timestamp\":1772356943},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Crenna Earth-Daughter says: Let's all buff up.\",\"id\":\"s1_3271\",\"timestamp\":1772356946},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meredy Huntswell says: A mage table for all your summoned food needs.\",\"id\":\"s1_3272\",\"timestamp\":1772356949},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Austin Huxworth\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Austin Huxworth says: Check your adventure guide if you need more information about what we'll find here.\",\"id\":\"s1_3273\",\"timestamp\":1772356950},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Dis must be de fire Lilaju spoke of.\",\"id\":\"s1_3274\",\"timestamp\":1772356955},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zul'jarra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Zul'jarra says: Sit and we will start de ritual--but be ready. Dis is de Loa of War. What ever he dreams of, we must complete de trial.\",\"id\":\"s1_3275\",\"timestamp\":1772356958},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meredy Huntswell says: Ready when you are.\",\"id\":\"s1_3276\",\"timestamp\":1772356960},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Meredy Huntswell|h[Meredy Huntswell]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"id\":\"s1_3277\",\"timestamp\":1772356960},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: Do not worry about your friend, de would-be hash'ey. Nalorakk, de dreamer, de Loa of War, will test her strength.\",\"id\":\"s1_3278\",\"timestamp\":1772357006},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: A hash'ey is only as strong as their warriors. So, you too will be tested in Nalorakk's dream.\",\"id\":\"s1_3279\",\"timestamp\":1772357017},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Meredy Huntswell says: This can be an offering.\",\"id\":\"s1_3280\",\"timestamp\":1772357024},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hplayer:Meredy Huntswell|h[Meredy Huntswell]: |h|A:ping_chat_nonthreat:0:0:0:0|aLook here\",\"id\":\"s1_3281\",\"timestamp\":1772357024},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: The loa dreams of de Amani's past. When de winter was their only foe. Preparin' for it will be your first trial.\",\"id\":\"s1_3282\",\"timestamp\":1772357027},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::87:263:::::::::|h[Unrecognizable Organ]|h|r\",\"id\":\"s1_3283\",\"timestamp\":1772357078},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Loa Speaker Nanea\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Loa Speaker Nanea says: Preparin' will help you in de trial ahead.\",\"id\":\"s1_3284\",\"timestamp\":1772357087},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:242639::::::::87:263:::::::::|h[Practically Pork]|h|rx2\",\"id\":\"s1_3285\",\"timestamp\":1772357147},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 77 Silver, 59 Copper (+1 Silver, 55 Copper)\",\"id\":\"s1_3286\",\"timestamp\":1772357148},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Tripadvisør-KirinTor\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Tripadvisør-KirinTor|h[|cffc69b6dTripadvisør-KirinTor|r]|h a accompli le haut fait |cffffff00|Hachievement:61212:Player-1127-0908264E:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Magisters' Terrace]|h|r !\",\"id\":\"s1_3287\",\"timestamp\":1772357168},{\"recordedBy\":\"K