{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kifaan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kifaan says: There's a group of rebels amidst the Shadowguard. All of them were once forced under the Void's will at Manaforge Omega.",
["timestamp"] = 1772821328,
["id"] = "s3_4744",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kifaan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kifaan says: But now they resist. They're led by an ethereal they call Sombersong.",
["timestamp"] = 1772821335,
["id"] = "s3_4745",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
