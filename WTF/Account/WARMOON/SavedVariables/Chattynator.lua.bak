["typeInfo"] = {
["player"] = {
["name"] = "Lucia Nightbreaker",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Lucia Nightbreaker says: Let us reconvene at Locus Point, Kvotheen.",
["id"] = "s2_3269",
["timestamp"] = 1772577634,
},
