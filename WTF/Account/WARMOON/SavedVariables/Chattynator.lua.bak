alariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::86:263:::::::::|h[Unrecognizable Organ]|h|rx2\",\"timestamp\":1772326763,\"id\":\"s1_3149\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: What she doin'? She's rendin' de souls. Twisting dem! Feeding dem to that monster!\",\"timestamp\":1772326793,\"id\":\"s1_3150\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: There are souls still that we can save. You confront her. I gonna release all de souls I can find.\",\"timestamp\":1772326801,\"id\":\"s1_3151\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Meredy Huntswell says: Get out of the way!\",\"timestamp\":1772326817,\"id\":\"s1_3152\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vordaza\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Vordaza yells: What's dis? New souls for my experiments?\",\"timestamp\":1772326914,\"id\":\"s1_3153\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vordaza\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Vordaza yells: Ya accomplished nothin'. Rak'tul will still rise!\",\"timestamp\":1772327026,\"id\":\"s1_3154\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:251161::::::::86:263::17:3:13441:13436:13578:2:9:86:28:5138:::::|h[Soulhunter's Mask]|h|r\",\"timestamp\":1772327027,\"id\":\"s1_3155\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:246586::::::::86:263:::::::::|h[Shell of Shadra]|h|r\",\"timestamp\":1772327027,\"id\":\"s1_3156\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: She's dead, but her evil lives on.\",\"timestamp\":1772327032,\"id\":\"s1_3157\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: There still be many angry souls. I will keep them busy--an' keep them from feedin' de monster.\",\"timestamp\":1772327036,\"id\":\"s1_3158\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: But de monster be up to you.\",\"timestamp\":1772327043,\"id\":\"s1_3159\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Zaib'yan\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Zaib'yan yells: Interlopers! You will never reach Rak'tul!\",\"timestamp\":1772327047,\"id\":\"s1_3160\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Crenna Earth-Daughter\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Crenna Earth-Daughter says: Don't stand there!\",\"timestamp\":1772327086,\"id\":\"s1_3161\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::86:263:::::::::|h[Lustrous Wildlife Pelt]|h|rx2\",\"timestamp\":1772327122,\"id\":\"s1_3162\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260614::::::::86:263:::::::::|h[Unrecognizable Organ]|h|r\",\"timestamp\":1772327122,\"id\":\"s1_3163\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260687::::::::86:263:::::::::|h[Decaying Leather]|h|r\",\"timestamp\":1772327122,\"id\":\"s1_3164\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:260651::::::::86:263:::::::::|h[Lustrous Wildlife Pelt]|h|r\",\"timestamp\":1772327153,\"id\":\"s1_3165\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Rak'tul\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Rak'tul yells: Rak'tul... awake. Rak'tul... hungry!\",\"timestamp\":1772327192,\"id\":\"s1_3166\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Meredy Huntswell\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Meredy Huntswell says: Don't stand there!\",\"timestamp\":1772327197,\"id\":\"s1_3167\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Rak'tul\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Rak'tul yells: Where are my souls? What have ya done?\",\"timestamp\":1772327200,\"id\":\"s1_3168\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: Be careful, Kvotheen. He seems powerful... an' unstable.\",\"timestamp\":1772327206,\"id\":\"s1_3169\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"WARRIOR\",\"race\":\"Human\",\"name\":\"Bisnina-Archimonde\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Bisnina-Archimonde|h[|cffc69b6dBisnina-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:41804:Player-1302-0CF49EB4:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[One Does Not Simply Walk Into Harandar]|h|r !\",\"timestamp\":1772327294,\"id\":\"s1_3170\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"VoidElf\",\"name\":\"Myrn-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Myrn-Archimonde|h[|cffaad372Myrn-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:61640:Player-1302-0CDAA8BD:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Nexus-Point Xenas]|h|r !\",\"timestamp\":1772327301,\"id\":\"s1_3171\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:61639:Player-1390-09230B89:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Maisara Caverns]|h|r!\",\"timestamp\":1772327389,\"id\":\"s1_3172\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Rak'tul\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Rak'tul yells: I'm losing... it all...\",\"timestamp\":1772327389,\"id\":\"s1_3173\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:61639:Player-1390-09230B89:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Maisara Caverns]|h|r!\",\"timestamp\":1772327389,\"id\":\"s1_3174\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ3:|Hitem:251179::::::::86:263::17:3:13441:13436:13578:2:9:86:28:5138:::::|h[Decaying Cuirass]|h|r\",\"timestamp\":1772327390,\"id\":\"s1_3175\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:264717::::::::86:263::17::1:28:5138:::::|h[Amani Warding Hex]|h|r\",\"timestamp\":1772327390,\"id\":\"s1_3176\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 26 Gold, 13 Silver, 55 Copper (+52 Silver, 27 Copper)\",\"timestamp\":1772327391,\"id\":\"s1_3177\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: With de creature dead an' de Vilebranch gone, we Witherbark all be sleepin' a little safer--for now.\",\"timestamp\":1772327395,\"id\":\"s1_3178\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Kul'amara the Fierce\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Kul'amara the Fierce says: We will always be lookin' over our shoulders at de Vilebranch. Come back with me. De chief be havin' a reward for ya.\",\"timestamp\":1772327405,\"id\":\"s1_3179\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Captain Garrick\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Captain Garrick says: Good job everyone. We're done here now. You can leave anytime.\",\"timestamp\":1772327409,\"id\":\"s1_3180\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: You have de shell? Let us begin!\",\"timestamp\":1772327476,\"id\":\"s1_3181\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: Stand in de middle there and focus on de three ritual objects.\",\"timestamp\":1772327587,\"id\":\"s1_3182\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Mixer Jamanga yells: Shadra, we bring your fang, eye, and shell together once more.\",\"timestamp\":1772327590,\"id\":\"s1_3183\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Mixer Jamanga yells: Return to your loyal Witherbark and Revantusk!\",\"timestamp\":1772327594,\"id\":\"s1_3184\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: An egg has formed!\",\"timestamp\":1772327597,\"id\":\"s1_3185\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: You'll have to assist it in hatchin'--carefully now!\",\"timestamp\":1772327600,\"id\":\"s1_3186\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Shadra\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"r\":1,\"g\":0.250980406999588,\"b\":0.250980406999588},\"text\":\"Shadra yells: I am reborn!\",\"timestamp\":1772327606,\"id\":\"s1_3187\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: Shadra, de Witherbark are honored to have you back among us.\",\"timestamp\":1772327608,\"id\":\"s1_3188\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"VoidElf\",\"name\":\"Myrn-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Myrn-Archimonde|h[|cffaad372Myrn-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:41806:Player-1302-0CDAA8BD:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Breaching the Voidstorm]|h|r !\",\"timestamp\":1772327611,\"id\":\"s1_3189\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"VoidElf\",\"name\":\"Myrn-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Myrn-Archimonde|h[|cffaad372Myrn-Archimonde|r]|h a accompli le haut fait |cffffff00|Hachievement:42045:Player-1302-0CDAA8BD:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Midnight]|h|r !\",\"timestamp\":1772327611,\"id\":\"s1_3190\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: And Nalorakk's Revantusk are ready to work with you, de Witherbark, and Halazzi against our common enemies.\",\"timestamp\":1772327613,\"id\":\"s1_3191\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"DRUID\",\"race\":\"Worgen\",\"name\":\"Matrox-Eitrigg\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Matrox-Eitrigg:858:GUILD:|h[|cffff7c0aMatrox-Eitrigg|r]|h: gg\",\"timestamp\":1772327620,\"id\":\"s1_3192\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Shadra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Shadra says: Hm. It seems there is much to do. I think I was reborn at just the right time.\",\"timestamp\":1772327620,\"id\":\"s1_3193\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Shadra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Shadra says: Vengeance on the foul Vilebranch will be the first task.\",\"timestamp\":1772327626,\"id\":\"s1_3194\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Øskytankul-Archimonde:861:GUILD:|h[|cff00ff98Øskytankul|r]|h: gg \",\"timestamp\":1772327627,\"id\":\"s1_3195\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Halazzi\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Halazzi says: Already your webs spin! I expected no less. Welcome to Zul'Aman, Shadra.\",\"timestamp\":1772327631,\"id\":\"s1_3196\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Shadra\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Shadra says: They will never see us coming, Halazzi. We will have such fun--like the old days.\",\"timestamp\":1772327635,\"id\":\"s1_3197\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: I am... relieved I was wrong. And dat we fought our real enemies together. And found a new, old ally.\",\"timestamp\":1772327643,\"id\":\"s1_3198\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"VoidElf\",\"name\":\"Myrn-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Myrn-Archimonde:870:GUILD:|h[|cffaad372Myrn|r]|h: Merci ! =D\",\"timestamp\":1772327648,\"id\":\"s1_3199\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Mixer Jamanga\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Mixer Jamanga says: Yes, having Shadra back is a wonderful boon. Perhaps she needs a speaker. Or two? Ah! We need to tell de chief!\",\"timestamp\":1772327650,\"id\":\"s1_3200\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MAGE\",\"race\":\"Human\",\"name\":\"Hitni-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Hitni-Archimonde:872:GUILD:|h[|cff3fc7ebHitni|r]|h: ggggg\",\"timestamp\":1772327652,\"id\":\"s1_3201\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"HUNTER\",\"race\":\"VoidElf\",\"name\":\"Myrn-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Myrn-Archimonde:874:GUILD:|h[|cffaad372Myrn|r]|h: C'est pas terminé j'suis pas encore 90 xD\",\"timestamp\":1772327663,\"id\":\"s1_3202\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: I will go with you, Kvotheen.\",\"timestamp\":1772327669,\"id\":\"s1_3203\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Orc\",\"name\":\"Øskytankul-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Øskytankul-Archimonde:878:GUILD:|h[|cff00ff98Øskytankul|r]|h: moi non plus =x\",\"timestamp\":1772327689,\"id\":\"s1_3204\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vun'zarah says: Nija. I had wondered why you had come to our village. Was it for Shadra?\",\"timestamp\":1772327750,\"id\":\"s1_3205\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: No, I came from de Hinterlands where de Witherbark hunted Revantusk. I wanted to know if de Witherbark here kept the old ways or if refugees like me are truly safe.\",\"timestamp\":1772327755,\"id\":\"s1_3206\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vun'zarah says: It is different here. The Witherbark were and always will be your allies. We do what we can to keep us all safe. The Vilebranch are our true enemy.\",\"timestamp\":1772327765,\"id\":\"s1_3207\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Nija Torntusk says: We all gotta resist de Vilebranch together.\",\"timestamp\":1772327773,\"id\":\"s1_3208\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vun'zarah\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Vun'zarah says: Dat is truth. And with our loa, we gonna do more than resist!\",\"timestamp\":1772327776,\"id\":\"s1_3209\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nija Torntusk\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"r\":1,\"g\":0.501960813999176,\"b\":0.250980406999588},\"text\":\"Nija Torntusk laughs and nods in agreement.\",\"timestamp\":1772327780,\"id\":\"s1_3210\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Human\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Jamelmoignon-Hyjal|h[|cffffffffJamelmoignon|r]|h a accompli le haut fait |cffffff00|Hachievement:61913:Player-1390-08FA49D3:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[A Singular Problem]|h|r !\",\"timestamp\":1772327781,\"id\":\"s1_3211\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"PRIEST\",\"race\":\"Human\",\"name\":\"Jamelmoignon-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"r\":0.250980406999588,\"g\":1,\"b\":0.250980406999588},\"text\":\"|Hplayer:Jamelmoignon-Hyjal|h[|cffffffffJamelmoignon|r]|h a accompli le haut fait |cffffff00|Hachievement:61922:Player-1390-08FA49D3:1:3:1:26:4294967295:4294967295:4294967295:4294967295|h[Ninety Percent is Good Enough]|h|r !\",\"timestamp\":1772327781,\"id\":\"s1_3212\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ3:|Hitem:251176::::::::87:263::17:3:13441:13436:13578:2:9:87:28:3086:::::|h[Reanimator's Weight]|h|r\",\"timestamp\":1772327824,\"id\":\"s1_3213\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_SKILL\",\"type\":\"SKILL\"},\"color\":{\"r\":0.3333333432674408,\"g\":0.3333333432674408,\"b\":1},\"text\":\"Your skill in Midnight Herbalism has increased to 52.\",\"timestamp\":1772327908,\"id\":\"s1_3214\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive loot: |cnIQ2:|Hitem:236770::::::::87:263::::1:38:13:::::|h[Sanguithorn |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|rx2\",\"timestamp\":1772327908,\"id\":\"s1_3215\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\