},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Herza-Eitrigg:459:GUILD:|h[|cfff48cbaHerza|r]|h: +1 aspire moi grand fou ",
["timestamp"] = 1787251485,
["id"] = "s20_3465",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Orweyna",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Orweyna says: We must be careful. Untold horrors could be waking in the temple.",
["timestamp"] = 1787251520,
["id"] = "s20_3466",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jarra",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Zul'jarra says: For thousands of years, dis temple been sealed away. We did not know why.",
["timestamp"] = 1787251525,
["id"] = "s20_3467",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "WARLOCK",
["race"] = "Scourge",
["name"] = "Wellhung-Archimonde",
["sex"] = 2,
},
["event"] = "CHAT_MSG_GUILD",
["type"] = "GUILD",
},
["color"] = {
["r"] = 0.250980406999588,
["g"] = 1,
["b"] = 0.250980406999588,
},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Wellhung-Archimonde:465:GUILD:|h[|cff8788eeWellhung|r]|h: je savais pas que l'encadrement proposait ce genre de service",
["timestamp"] = 1787251525,
["id"] = "s20_3468",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jarra",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Zul'jarra says: Now we know it was to hide de Soulcoiler's unspeakable rituals--and de body of Ula'tek.",
["timestamp"] = 1787251531,
["id"] = "s20_3469",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jarra",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Zul'jarra says: And my brother has dug it all up again! Dey were all buried for a reason, Zul'jan! What have you got yourself into?",
["timestamp"] = 1787251539,
["id"] = "s20_3470",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
