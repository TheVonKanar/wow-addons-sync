b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:253387::::::::80:263:::::::::|h[Unmarred Eyeball]|h|r\",\"id\":\"s0_1044\",\"timestamp\":1771505758},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:238847::::::::80:263:::::::::|h[Torn Maw Fragment]|h|r\",\"id\":\"s0_1045\",\"timestamp\":1771505768},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:257714::::::::80:263:::::::::|h[Spiny Protrusion]|h|r\",\"id\":\"s0_1046\",\"timestamp\":1771505768},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: Quick strikes and clean deaths. A promising start.\",\"id\":\"s0_1047\",\"timestamp\":1771505776},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: You fight well, but it is time to demonstrate your skills against a greater threat.\",\"id\":\"s0_1048\",\"timestamp\":1771505789},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: Lead the way. I will not rest until my prey lies dead at my feet.\",\"id\":\"s0_1049\",\"timestamp\":1771505794},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Ve'nari\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Ve'nari says: We can't let the devourers infest our home. Cull their numbers before they spread.\",\"id\":\"s0_1050\",\"timestamp\":1771505801},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vraxik\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vraxik says: I will devour you whole!\",\"id\":\"s0_1051\",\"timestamp\":1771505855},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: Face the wrath of the ren'dorei!\",\"id\":\"s0_1052\",\"timestamp\":1771505855},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vraxik\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vraxik says: Hold still, mortal!\",\"id\":\"s0_1053\",\"timestamp\":1771505858},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: No!\",\"id\":\"s0_1054\",\"timestamp\":1771505860},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Leona Darkstrider yells: Release them!\",\"id\":\"s0_1055\",\"timestamp\":1771505861},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vraxik\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Vraxik says: The void... is endless...\",\"id\":\"s0_1056\",\"timestamp\":1771505865},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: The strength of the ren'dorei against the void...\",\"id\":\"s0_1057\",\"timestamp\":1771505865},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: Impressive, Leona. You broke that creature's hold on Kvotheen with ease.\",\"id\":\"s0_1058\",\"timestamp\":1771505870},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: The ren'dorei hear the Void's whispers at all times. We are adept at silencing them.\",\"id\":\"s0_1059\",\"timestamp\":1771505874},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: I see. Let us return to Umbric. There is much for us to discuss.\",\"id\":\"s0_1060\",\"timestamp\":1771505879},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ0:|Hitem:238876::::::::80:263:::::::::|h[Malicious Mandible]|h|r\",\"id\":\"s0_1061\",\"timestamp\":1771505886},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: I will proudly take Leona on as my disciple. And not just her.\",\"id\":\"s0_1062\",\"timestamp\":1771505919},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_ACHIEVEMENT\",\"type\":\"ACHIEVEMENT\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:61916:Player-1390-09230B89:1:2:19:26:4294967295:4294967295:4294967295:4294967295|h[Rage of the Ren'dorei]|h|r!\",\"id\":\"s0_1063\",\"timestamp\":1771505923},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"ZandalariTroll\",\"class\":\"SHAMAN\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_GUILD_ACHIEVEMENT\",\"type\":\"GUILD_ACHIEVEMENT\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hplayer:Kvotheen-Hyjal|h[|cff0070ddKvotheen|r]|h has earned the achievement |cffffff00|Hachievement:61916:Player-1390-09230B89:1:2:19:26:4294967295:4294967295:4294967295:4294967295|h[Rage of the Ren'dorei]|h|r!\",\"id\":\"s0_1064\",\"timestamp\":1771505923},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: Leona has shown me that the ren'dorei are uniquely suited to both wield and combat the Void.\",\"id\":\"s0_1065\",\"timestamp\":1771505925},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"VoidElf\",\"class\":\"WARLOCK\",\"name\":\"Calwyn-KirinTor\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Calwyn-KirinTor:90:GUILD:|h[|cff8788eeCalwyn|r]|h: GG\",\"id\":\"s0_1066\",\"timestamp\":1771505931},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Allari the Souleater\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Allari the Souleater says: The Illidari currently lack such expertise. We will train any void elves who wish to join us.\",\"id\":\"s0_1067\",\"timestamp\":1771505931},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Magister Umbric\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Magister Umbric says: I will direct those who are interested to you. May this exchange of knowledge benefit us all.\",\"id\":\"s0_1068\",\"timestamp\":1771505937},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Leona Darkstrider\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Leona Darkstrider says: My thanks, Allari. I look forward to walking the path ahead of me.\",\"id\":\"s0_1069\",\"timestamp\":1771505942},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Naramis-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Naramis-ConfrérieduThorium:139:GUILD:|h[|cfff48cbaNaramis|r]|h: Hello !\",\"id\":\"s0_1070\",\"timestamp\":1771506718},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Faerin Lothar\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"c