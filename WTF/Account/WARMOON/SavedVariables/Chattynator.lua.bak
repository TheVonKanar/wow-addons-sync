["r"] = 0.250980406999588,
},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Khennaï-Hyjal:39:GUILD:|h[|cff0070ddKhennaï|r]|h: Et coucou",
["id"] = "s2_4174",
["timestamp"] = 1772648446,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Wey'nan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Wey'nan says: Add a little at a time to each vial till you reach the mark I put on the containers. Once you have the containers filled, let me know and I'll finish crafting the ward.",
["id"] = "s2_4175",
["timestamp"] = 1772648447,
},
