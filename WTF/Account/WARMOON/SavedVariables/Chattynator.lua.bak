95\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"High Exarch Turalyon\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"High Exarch Turalyon says: On that we agree. Arator, hold the line. Kvotheen, seize those weapons!\",\"timestamp\":1772149726,\"id\":\"s0_2296\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 1 Gold, 49 Silver, 41 Copper (+2 Silver, 98 Copper)\",\"timestamp\":1772149746,\"id\":\"s0_2297\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ5:|Hitem:238845::::::::80:263:::::::::|h[Staff of Disintegration]|h|r\",\"timestamp\":1772149750,\"id\":\"s0_2298\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 2 Gold, 5 Silver, 96 Copper (+4 Silver, 11 Copper)\",\"timestamp\":1772149763,\"id\":\"s0_2299\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMAN\",\"race\":\"ZandalariTroll\",\"name\":\"Kvotheen-Hyjal\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"r\":0,\"g\":0.6666666865348816,\"b\":0},\"text\":\"You receive item: |cnIQ5:|Hitem:238842::::::::80:263:::::::::|h[Cosmic Infuser]|h|r\",\"timestamp\":1772149763,\"id\":\"s0_2300\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0},\"text\":\"You loot 2 Gold, 11 Silver, 55 Copper (+4 Silver, 23 Copper)\",\"timestamp\":1772149787,\"id\":\"s0_2301\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"SHAMA