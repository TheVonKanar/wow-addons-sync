":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"You receive loot: |cnIQ1:|Hitem:265695::::::::90:263:::::::::|h[Elementary Voidcore Shard]|h|r\",\"id\":\"s14_4648\",\"timestamp\":1776286315},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Martin Victus\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Martin Victus yells: Brave champions, we owe you our lives, our freedom.... Though it be a tiny gesture in the face of this enormous debt, I pledge that from this day forth, all will know of your deeds, and the blazing path of light you cut through the shadow of this dark citadel.\",\"id\":\"s14_4649\",\"timestamp\":1776286315},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_MONEY\",\"type\":\"MONEY\"},\"color\":{\"b\":0,\"g\":1,\"r\":1},\"text\":\"You loot 256 Gold, 24 Silver, 58 Copper\",\"id\":\"s14_4650\",\"timestamp\":1776286316},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Grodar-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Grodar-Archimonde receives loot: |cnIQ4:|Hitem:49802::::::::90:263::33:4:12795:13440:6652:12701:1:28:1279:::::|h[Garfrost's Two-Ton Hammer]|h|r.\",\"id\":\"s14_4651\",\"timestamp\":1776286316},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Martin Victus\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Martin Victus yells: This day will stand as a testament not only to your valor, but to the fact that no foe, not even the Lich King himself, can stand when Alliance and Horde set aside their differences and---\",\"id\":\"s14_4652\",\"timestamp\":1776286330},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:2000|h[Loot]|h: You passed on: |cnIQ2:|Hitem:267007::::::::90:263::16::1:28:1279:::::|h[Eye of Acherus]|h|r |HlootHistory:2000|h|cnLOOT_LINK_COLOR:[View Loot Rolls]|r|h\",\"id\":\"s14_4653\",\"timestamp\":1776286334},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"|HlootHistory:2000|h[Loot]|h: Grodar (Need - 94, Main-Spec) Won: |cnIQ2:|Hitem:267007::::::::90:263::16::1:28:1279:::::|h[Eye of Acherus]|h|r\",\"id\":\"s14_4654\",\"timestamp\":1776286334},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"WARRIOR\",\"name\":\"Grodar-Archimonde\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Grodar-Archimonde receives loot: |cnIQ2:|Hitem:267007::::::::90:263::16::1:28:1279:::::|h[Eye of Acherus]|h|r.\",\"id\":\"s14_4655\",\"timestamp\":1776286334},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Jaina Proudmoore\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lady Jaina Proudmoore yells: NO! YOU MONSTER!\",\"id\":\"s14_4656\",\"timestamp\":1776286345},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Jaina Proudmoore\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lady Jaina Proudmoore yells: I... I could not save them... Damn you, Arthas! DAMN YOU!\",\"id\":\"s14_4657\",\"timestamp\":1776286348},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Jaina Proudmoore\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Lady Jaina Proudmoore says: The Frost Queen is gone. We must keep moving - our objective is near.\",\"id\":\"s14_4658\",\"timestamp\":1776286356},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Harronir\",\"class\":\"DRUID\",\"name\":\"Zaeya-KirinTor\",\"sex\":3},\"event\":\"CHAT_MSG_PARTY\",\"type\":\"PARTY\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"|Hchannel:PARTY|h[Party]|h |Hplayer:Zaeya-KirinTor:1142:PARTY:|h[|cffff7c0aZaeya-KirinTor|r]|h: jvais fumer vite fait\",\"id\":\"s14_4659\",\"timestamp\":1776286403},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"LightforgedDraenei\",\"class\":\"PALADIN\",\"name\":\"Ellyoda-ConfrérieduThorium\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Ellyoda-ConfrérieduThorium:1172:GUILD:|h[|cfff48cbaEllyoda|r]|h: ok\",\"id\":\"s14_4660\",\"timestamp\":1776286468},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Orweyna\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"r\":1,\"g\":1,\"b\":0.6235294342041016},\"text\":\"Orweyna says: The Den has been ravaged with vermin. If we deal with that problem the elders will be more favorable with us. Take a grymlinx--they are always up for a meal.\",\"timestamp\":1776365857,\"id\":\"s14_4661\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"r\":1,\"g\":0.4980392456054688,\"b\":0},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Sânghr-Hyjal:80:RAID:|h[|cff00ff98Sânghr|r]|h: coucou les copains\",\"timestamp\":1776365858,\"id\":\"s14_4662\"},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"class\":\"MONK\",\"race\":\"Human\",\"name\":\"Sânghr-Hyjal\",\"sex\":3},\