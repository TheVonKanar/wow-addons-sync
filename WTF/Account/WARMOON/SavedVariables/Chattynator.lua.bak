},
["text"] = "You receive loot: |cnIQ2:|Hitem:236770::::::::81:263::::1:38:13:::::|h[Sanguithorn |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r",
["timestamp"] = 1772214836,
["id"] = "s0_2916",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["event"] = "CHAT_MSG_CURRENCY",
