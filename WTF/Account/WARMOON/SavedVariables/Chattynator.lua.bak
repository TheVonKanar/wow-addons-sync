["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Vereesa Windrunner yells: Are you sure?",
["id"] = "s17_2886",
["timestamp"] = 1777320465,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
