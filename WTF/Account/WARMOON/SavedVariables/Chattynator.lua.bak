},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.501960813999176,
["r"] = 1,
},
["text"] = "Light and Void converge, forging a phoenix reborn in the essence of Twilight.",
["id"] = "s17_4824",
["timestamp"] = 1777927364,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Arator",
},
["event"] = "CHAT_MSG_MONSTER_YELL",
["type"] = "MONSTER_YELL",
},
["color"] = {
["b"] = 0.250980406999588,
["g"] = 0.250980406999588,
["r"] = 1,
},
["text"] = "Arator yells: The Void... mother says it speaks to you. To Belo'ren, we are attacking what he was sworn to defend.",
