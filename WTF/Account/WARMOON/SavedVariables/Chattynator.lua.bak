["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Thaed Pyremaker says: A squadron of those noxious pests have infested the battlefield. Get in there and squash them!",
["id"] = "s0_2076",
["timestamp"] = 1772042778,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
