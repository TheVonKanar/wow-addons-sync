["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Allari the Souleater says: I need you here, Leona. Take this incense and place it at the cardinal points around the platform.",
["id"] = "s3_4564",
["timestamp"] = 1772819128,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
