["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive item: |cnIQ1:|Hitem:267005::::::::90:263:::::::::|h[Rakan's Totem]|h|r",
["timestamp"] = 1772572590,
["id"] = "s2_2706",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Rakan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Rakan says: De loa will do de heavy liftin' through dat totem. You are just transferrin' their power.",
["timestamp"] = 1772572590,
["id"] = "s2_2707",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Rakan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Rakan says: Akil'zon. Loa of Victory. Lord of de sky, de wind, de rain, and de thunder!",
["timestamp"] = 1772572599,
["id"] = "s2_2708",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "MAGE",
["race"] = "Human",
["name"] = "Hitni-Archimonde",
["sex"] = 2,
},
["event"] = "CHAT_MSG_GUILD",
["type"] = "GUILD",
},
["color"] = {
["r"] = 0.250980406999588,
["g"] = 1,
["b"] = 0.250980406999588,
},
["text"] = "|Hchannel:GUILD|h[Guild]|h |Hplayer:Hitni-Archimonde:567:GUILD:|h[|cff3fc7ebHitni|r]|h: |cnIQ4:|Hitem:257180::::::::90:62::11::1:28:872:::::|h[Rênes du défenseur de Fulgarion maîtrisé]|h|r",
["timestamp"] = 1772572603,
["id"] = "s2_2709",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Rakan",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Rakan says: She's been guiding de Amani since we came to dis land and has remained de embodiment and icon of our tribe all dis time.",
["timestamp"] = 1772572609,
["id"] = "s2_2710",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Rul'ari",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Rul'ari says: Jan'alai. Loa of Fire. Master of magics and de flame inside each livin' being.",
["timestamp"] = 1772572622,
["id"] = "s2_2711",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Rul'ari",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Rul'ari says: Shadowpine became de primary worshippers of Jan'alai long ago when an ancient loa speaker led de tribe to safety because a vision seen in de temple fires.",
["timestamp"] = 1772572628,
["id"] = "s2_2712",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kaziil",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kaziil says: Halazzi. Loa of de Hunt. Agile, cunning, patient. An ideal hunter in all lands, and in pursuit of any prey.",
["timestamp"] = 1772572631,
["id"] = "s2_2713",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kaziil",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kaziil says: Witherbark from all over Zul'Aman make pilgrimage to Halazzi's temple to leave a piece of their hunts in worship.",
["timestamp"] = 1772572638,
["id"] = "s2_2714",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Kaziil",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Kaziil says: Including de Witherbark children fishin' up breakfast along de shore!",
["timestamp"] = 1772572646,
["id"] = "s2_2715",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Amala",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Amala says: Nalorakk. Loa of War. Stubborn and unforgiving, but fiercely loyal to his worshippers.",
["timestamp"] = 1772572646,
["id"] = "s2_2716",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Amala",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Amala says: De Revantusk favor him most out of de four great ones due to dis straight-forward attitude, as well as his battlefield mastery.",
["timestamp"] = 1772572652,
["id"] = "s2_2717",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Du'gal",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Du'gal says: You may use this altar to worship as often as you wish.",
["timestamp"] = 1772572690,
["id"] = "s2_2718",
},
