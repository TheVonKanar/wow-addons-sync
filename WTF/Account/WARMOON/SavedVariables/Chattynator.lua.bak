},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Valeera Sanguinar says: Kvotheen. Lor'themar sent me to help with that rat you're chasing.",
["id"] = "s0_3117",
["timestamp"] = 1772224205,
},
