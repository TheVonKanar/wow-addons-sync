["id"] = "s20_4784",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: I almost wish it was my own head down there, just so I could be closer to the action.",
["timestamp"] = 1787504813,
["id"] = "s20_4785",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["class"] = "SHAMAN",
["race"] = "ZandalariTroll",
["name"] = "Kvotheen",
["sex"] = 2,
},
["event"] = "CHAT_MSG_LOOT",
["type"] = "LOOT",
},
["color"] = {
["r"] = 0,
["g"] = 0.6666666865348816,
["b"] = 0,
},
["text"] = "You receive item: |cnIQ1:|Hitem:238511::::::::90:263::::1:38:13:::::|h[Void-Tempered Leather |A:Professions-ChatIcon-Quality-12-Tier1:17:15::1|a]|h|r",
["timestamp"] = 1787504815,
["id"] = "s20_4786",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: Absolute domination! I haven't seen a game like that in ages!",
["timestamp"] = 1787504823,
["id"] = "s20_4787",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: And it just keeps giving, folks! It looks like the captain of the Ula'tek Headhunters is planning an unscheduled double feature!",
["timestamp"] = 1787504829,
["id"] = "s20_4788",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: It's time for SUDDEN DEATH OVERTIME!",
["timestamp"] = 1787504839,
["id"] = "s20_4789",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Jan'mo the Loud",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Jan'mo the Loud says: GOAL! What an end to an already action packed day of headball! One for the history tablets, folks, and one I won't soon forget.",
["timestamp"] = 1787504880,
["id"] = "s20_4790",
},
