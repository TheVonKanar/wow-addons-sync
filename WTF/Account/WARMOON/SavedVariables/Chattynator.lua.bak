},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Orweyna",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Orweyna says: Ula'tek's influence here is overwhelming. Dark acts have stained this place.",
["id"] = "s20_3735",
["timestamp"] = 1787253456,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jarra",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jarra says: De heart of de temple. Dis must be where de Soulcoilers performed their rituals.",
["id"] = "s20_3736",
["timestamp"] = 1787253462,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Zul'jarra",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Zul'jarra says: Ula'tek's venom blocks our path. We'll have to find another way ahead.",
["id"] = "s20_3737",
["timestamp"] = 1787253468,
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Orweyna",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Orweyna says: I can sense the spirits of the Soulcoilers' victims on the ledges above. Perhaps we should investigate.",
["id"] = "s20_3738",
["timestamp"] = 1787253474,
},
