\",\"class\":\"DEMONHUNTER\",\"name\":\"Vilidøns-Dalaran\",\"sex\":3},\"event\":\"CHAT_MSG_WHISPER\",\"type\":\"WHISPER\"},\"color\":{\"b\":1,\"g\":0.501960813999176,\"r\":1},\"text\":\"|Hplayer:Vilidøns-Dalaran:887:WHISPER:VILIDØNS-DALARAN|h[|cffa330c9Vilidøns-Dalaran|r]|h whispers: |cnIQ4:|Hitem:249346::::::::90:1480::5:3:6652:13334:12798::::::|h[Ultime regard de Vaelgor]|h|r\",\"id\":\"s17_2882\",\"timestamp\":1777320364},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"DEMONHUNTER\",\"name\":\"Iranus-Ysondre\",\"sex\":3},\"event\":\"CHAT_MSG_GUILD\",\"type\":\"GUILD\"},\"color\":{\"b\":0.250980406999588,\"g\":1,\"r\":0.250980406999588},\"text\":\"|Hchannel:GUILD|h[Guild]|h |Hplayer:Iranus-Ysondre:888:GUILD:|h[|cffa330c9Iranus|r]|h: J’en profite pour faire ma propagande, si quelqu’un est intéressé par un projet pour jouer sur WoW (version spécial), allez voir sur le forum « partage-tes-idées » sur Discord \",\"id\":\"s17_2883\",\"timestamp\":1777320423},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Quickly now! Bring him down before they hatch anew!\",\"id\":\"s17_2884\",\"timestamp\":1777320450},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Two halves of a whole--Vereesa, follow the Light phoenix. I'll take the other side.\",\"id\":\"s17_2885\",\"timestamp\":1777320459},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: Are you sure?\",\"id\":\"s17_2886\",\"timestamp\":1777320465},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: I know what the Void can do. I can handle this.\",\"id\":\"s17_2887\",\"timestamp\":1777320467},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: Champions! Prepare yourselves!\",\"id\":\"s17_2888\",\"timestamp\":1777320493},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: We must stop Belo'ren!\",\"id\":\"s17_2889\",\"timestamp\":1777320497},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: Heroes, now! We must bring them down together!\",\"id\":\"s17_2890\",\"timestamp\":1777320556},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Vereesa Windrunner\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Vereesa Windrunner yells: Belo'ren! Please, we are defenders of the Sunwell, as are you!\",\"id\":\"s17_2891\",\"timestamp\":1777320558},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Belo'ren\"},\"event\":\"CHAT_MSG_MONSTER_EMOTE\",\"type\":\"MONSTER_EMOTE\"},\"color\":{\"b\":0.250980406999588,\"g\":0.501960813999176,\"r\":1},\"text\":\"Light and Void converge, forging a phoenix reborn in the essence of Twilight.\",\"id\":\"s17_2892\",\"timestamp\":1777320560},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Arator\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Arator yells: The Void... mother says it speaks to you. To Belo'ren, we are attacking what he was sworn to defend.\",\"id\":\"s17_2893\",\"timestamp\":1777320563},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Lady Liadrin\"},\"event\":\"CHAT_MSG_MONSTER_YELL\",\"type\":\"MONSTER_YELL\"},\"color\":{\"b\":0.250980406999588,\"g\":0.250980406999588,\"r\":1},\"text\":\"Lady Liadrin yells: Keep going, you two! We will hold them off--get to the Sunwell!\",\"id\":\"s17_2894\",\"timestamp\":1777320568},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"event\":\"CHAT_MSG_PING\",\"type\":\"PING\"},\"color\":{\"b\":1,\"g\":0.6666666865348816,\"r\":0.6666666865348816},\"text\":\"[Tank] |Hplayer:Sânghr|h[Sânghr]: |h|A:ping_chat_warning:0:0:0:0|aWarning: Entropy Wielder\",\"id\":\"s17_2895\",\"timestamp\":1777320627},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Vulpera\",\"class\":\"HUNTER\",\"name\":\"Seizuko-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_RAID\",\"type\":\"RAID\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:RAID|h[Raid]|h |Hplayer:Seizuko-Hyjal:901:RAID:|h[|cffaad372Seizuko|r]|h: les pets\",\"id\":\"s17_2896\",\"timestamp\":1777320643},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"Orc\",\"class\":\"MONK\",\"name\":\"Jocrisse-ConseildesOmbres\",\"sex\":2},\"event\":\"CHAT_MSG_LOOT\",\"type\":\"LOOT\"},\"color\":{\"b\":0,\"g\":0.6666666865348816,\"r\":0},\"text\":\"Jocrisse-ConseildesOmbres receives loot: |cnIQ0:|Hitem:260659::::::::90:263:::::::::|h[Stellar Vortex Residue]|h|r.\",\"id\":\"s17_2897\",\"timestamp\":1777320646},{\"