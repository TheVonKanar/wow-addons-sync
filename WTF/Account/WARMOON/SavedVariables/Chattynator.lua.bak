41016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: The Void's touch is cleansed. These forces are potent... versatile... and their side effects appear... manageable.\",\"id\":\"s9_3242\",\"timestamp\":1774385558},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: The enchantments need refinement, but sacrifices must always be made in the name of progress!\",\"id\":\"s9_3243\",\"timestamp\":1774385579},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Astalor Bloodsworn\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Astalor Bloodsworn says: Let's see what effects these anguish-wrought trinkets have conjured.\",\"id\":\"s9_3244\",\"timestamp\":1774385584},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"race\":\"BloodElf\",\"class\":\"PALADIN\",\"name\":\"Vespirà-Hyjal\",\"sex\":3},\"event\":\"CHAT_MSG_INSTANCE_CHAT\",\"type\":\"INSTANCE_CHAT\"},\"color\":{\"b\":0,\"g\":0.4980392456054688,\"r\":1},\"text\":\"|Hchannel:INSTANCE_CHAT|h[Instance]|h |Hplayer:Vespirà-Hyjal:1205:INSTANCE_CHAT:|h[|cfff48cbaVespirà|r]|h: hello\",\"id\":\"s9_3245\",\"timestamp\":1774385591},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nastasia Flairwatcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nastasia Flairwatcher says: Welcome to the Trial of Style: Azeroth's finest fashion destination!\",\"id\":\"s9_3246\",\"timestamp\":1774385597},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Atheris Voguesong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Atheris Voguesong says: I hope you brought your wardrobe with you, because today's competition looks FIERCE!\",\"id\":\"s9_3247\",\"timestamp\":1774385601},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nastasia Flairwatcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nastasia Flairwatcher says: The theme of today's competition is... Supernatural Flair!\",\"id\":\"s9_3248\",\"timestamp\":1774385610},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Atheris Voguesong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Atheris Voguesong says: Let's see your mystic, mythic, magical, supernatural flair!\",\"id\":\"s9_3249\",\"timestamp\":1774385614},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nastasia Flairwatcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nastasia Flairwatcher says: Take the next few moments to prepare your costume.\",\"id\":\"s9_3250\",\"timestamp\":1774385618},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nastasia Flairwatcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nastasia Flairwatcher says: We've also provided barber chairs, in case you need to touch up your hairdo.\",\"id\":\"s9_3251\",\"timestamp\":1774385624},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Atheris Voguesong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Atheris Voguesong says: The competition starts in two minutes. Good luck, good-looking!\",\"id\":\"s9_3252\",\"timestamp\":1774385632},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Atheris Voguesong\"},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"30 seconds remaining!\",\"id\":\"s9_3253\",\"timestamp\":1774385721},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Atheris Voguesong\"},\"event\":\"CHAT_MSG_RAID_BOSS_EMOTE\",\"type\":\"MONSTER_BOSS_EMOTE\"},\"color\":{\"b\":0,\"g\":0.8666667342185974,\"r\":1},\"text\":\"10 seconds remaining!\",\"id\":\"s9_3254\",\"timestamp\":1774385741},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nastasia Flairwatcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nastasia Flairwatcher says: To your left, the fabulous Gunkaz!\",\"id\":\"s9_3255\",\"timestamp\":1774385753},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Atheris Voguesong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Atheris Voguesong says: And on the right, the inimitable Kvotheen!\",\"id\":\"s9_3256\",\"timestamp\":1774385755},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nastasia Flairwatcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Nastasia Flairwatcher says: To your left, the fabulous Vespirà!\",\"id\":\"s9_3257\",\"timestamp\":1774385773},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Atheris Voguesong\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"},\"color\":{\"b\":0.6235294342041016,\"g\":1,\"r\":1},\"text\":\"Atheris Voguesong says: And on the right, the inimitable Abépierre!\",\"id\":\"s9_3258\",\"timestamp\":1774385775},{\"recordedBy\":\"Kvotheen-Hyjal\",\"typeInfo\":{\"player\":{\"name\":\"Nastasia Flairwatcher\"},\"event\":\"CHAT_MSG_MONSTER_SAY\",\"type\":\"MONSTER_SAY\"