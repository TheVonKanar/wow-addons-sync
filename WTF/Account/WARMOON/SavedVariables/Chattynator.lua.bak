},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Amani Feller says: This is ours!",
["timestamp"] = 1772226100,
["id"] = "s0_3325",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
