["name"] = "Ravenia",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ravenia says: In time, Fidoficus will become a terrible horror to behold.",
["timestamp"] = 1772652537,
["id"] = "s2_4466",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
["player"] = {
["name"] = "Ravenia",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["r"] = 1,
["g"] = 1,
["b"] = 0.6235294342041016,
},
["text"] = "Ravenia says: But in the meantime, keep him in your care. It may be the best way to cultivate his growth.",
["timestamp"] = 1772652541,
["id"] = "s2_4467",
},
{
["recordedBy"] = "Kvotheen-Hyjal",
["typeInfo"] = {
