["name"] = "Orweyna",
},
["event"] = "CHAT_MSG_MONSTER_SAY",
["type"] = "MONSTER_SAY",
},
["color"] = {
["b"] = 0.6235294342041016,
["g"] = 1,
["r"] = 1,
},
["text"] = "Orweyna says: A large attack only causes the Lightbloom to spread. A few, striking the most dangerous--that is best.",
